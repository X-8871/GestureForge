diff --git a/course_s2_vitis/14_vdma_hdmi_out/Vitis/auto_create_vitis/src/vdma_hdmi/dynclk/dynclk.c b/course_s2_vitis/14_vdma_hdmi_out/Vitis/auto_create_vitis/src/vdma_hdmi/dynclk/dynclk.c
--- a/course_s2_vitis/14_vdma_hdmi_out/Vitis/auto_create_vitis/src/vdma_hdmi/dynclk/dynclk.c
+++ b/course_s2_vitis/14_vdma_hdmi_out/Vitis/auto_create_vitis/src/vdma_hdmi/dynclk/dynclk.c
@@ -73,6 +73,11 @@
 #include "dynclk.h"
 #include "xil_io.h"
 #include "math.h"
+#include "xstatus.h"
+#include "xtime_l.h"
+
+/* 动态时钟启动或停止的最长等待时间为一秒。 */
+#define DYNCLK_TIMEOUT_TICKS ((XTime)COUNTS_PER_SECOND)
 
 u32 ClkCountCalc(u32 divide)
 {
@@ -222,7 +227,23 @@
-void ClkStart(u32 dynClkAddr)
+int ClkStart(u32 dynClkAddr)
 {
+	XTime startTime;
+	XTime currentTime;
+	XTime_GetTime(&startTime);
 	Xil_Out32(dynClkAddr + OFST_DYNCLK_CTRL, (1 << BIT_DYNCLK_START));
-	while(!(Xil_In32(dynClkAddr + OFST_DYNCLK_STATUS) & (1 << BIT_DYNCLK_RUNNING)));
-
-	return;
+	for (;;)
+	{
+		u32 status = Xil_In32(dynClkAddr + OFST_DYNCLK_STATUS);
+		XTime_GetTime(&currentTime);
+		if ((currentTime - startTime) >= DYNCLK_TIMEOUT_TICKS)
+		{
+			break;
+		}
+		if (status & (1 << BIT_DYNCLK_RUNNING))
+		{
+			return XST_SUCCESS;
+		}
+	}
+	/* 超时或截止点后才观察到启动，尽力关闭且不再等待。 */
+	Xil_Out32(dynClkAddr + OFST_DYNCLK_CTRL, 0);
+	return XST_FAILURE;
 }
@@ -230,7 +251,21 @@
-void ClkStop(u32 dynClkAddr)
+int ClkStop(u32 dynClkAddr)
 {
+	XTime startTime;
+	XTime currentTime;
 	Xil_Out32(dynClkAddr + OFST_DYNCLK_CTRL, 0);
-	while((Xil_In32(dynClkAddr + OFST_DYNCLK_STATUS) & (1 << BIT_DYNCLK_RUNNING)));
+	XTime_GetTime(&startTime);
+	for (;;)
+	{
+		u32 status = Xil_In32(dynClkAddr + OFST_DYNCLK_STATUS);
+		XTime_GetTime(&currentTime);
+		if ((currentTime - startTime) >= DYNCLK_TIMEOUT_TICKS)
+		{
+			return XST_FAILURE;
+		}
+		if (!(status & (1 << BIT_DYNCLK_RUNNING)))
+		{
+			return XST_SUCCESS;
+		}
+	}
 
-	return;
 }
