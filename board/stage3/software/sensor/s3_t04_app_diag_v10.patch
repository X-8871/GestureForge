+/* ================= S3-DIAG6 帧缓冲 64 KB 区指纹（只读） =================
+ * 算法（五次采样完全相同）：32 位循环进位加和 sum；哈希 = 反射式 CRC-32，
+ *   多项式 0xEDB88320、初值 0xFFFFFFFF、末取反，按小端 32 位字依次喂入
+ *   （等价于对连续 64 KB 字节流做标准 CRC-32/IEEE）。
+ * 读前必须 Xil_DCacheInvalidateRange，否则可能读到 CPU cache 里的陈旧行。
+ * 编译期开关 S3_TESTPATTERN：默认 0；=1 时启动 S2MM 前写 OV5640 0x503D=0x80（彩条测试图）。*/
+#ifndef S3_TESTPATTERN
+#define S3_TESTPATTERN 0
+#endif
+#define S3_DIAG6_FP_BYTES (64 * 1024)
+static XTime s3_t6_start, s3_t6_now;
+
+static u32 s3_diag6_hash(const volatile u32 *p, u32 words, u32 *sum_out, u32 *nz_out)
+{
+	u32 s3_i, s3_b, s3_nz = 0, s3_sum = 0, s3_crc = 0xFFFFFFFFU;
+	for (s3_i = 0; s3_i < words; s3_i++) {
+		u32 s3_w = p[s3_i];
+		s3_sum += s3_w;
+		if (s3_w != 0U) { s3_nz++; }
+		s3_crc ^= s3_w;
+		for (s3_b = 0; s3_b < 32; s3_b++) {
+			if (s3_crc & 1U) { s3_crc = (s3_crc >> 1) ^ 0xEDB88320U; } else { s3_crc >>= 1; }
+		}
+	}
+	*sum_out = s3_sum;
+	*nz_out = s3_nz;
+	return ~s3_crc;
+}
+
+static void s3_diag6_fp(u32 tsec, u32 site, u32 off)
+{
+	volatile u32 *s3_p = (volatile u32 *)((u8 *)dispCtrl.framePtr[dispCtrl.curFrame] + off);
+	u32 s3_sum = 0, s3_nz = 0, s3_hash;
+	Xil_DCacheInvalidateRange((INTPTR)s3_p, S3_DIAG6_FP_BYTES);
+	s3_hash = s3_diag6_hash(s3_p, S3_DIAG6_FP_BYTES / 4, &s3_sum, &s3_nz);
+	xil_printf("S3_DIAG6_FP t=%u site=%u sum=0x%08X hash=0x%08X nz=%u\r\n", tsec, site, s3_sum, s3_hash, s3_nz);
+}
+
+/* 只读：每次采样同时打印 S2MM SR/CR 与逐位判读（位定义见 S3-DIAG5 注释）。*/
+static void s3_diag6_sr(u32 tsec)
+{
+	u32 s3_sr = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_RX_OFFSET + XAXIVDMA_SR_OFFSET);
+	u32 s3_cr = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_RX_OFFSET + XAXIVDMA_CR_OFFSET);
+	xil_printf("S3_DIAG6_SR t=%u S2MM_SR=0x%08X S2MM_CR=0x%08X FRMCNT=%u HALTED=%u IDLE=%u INT=%u SLV=%u DEC=%u FSZ_LESS=%u LSZ_LESS=%u FSZ_MORE=%u LSZ_MORE=%u ERR_IRQ=%u\r\n",
+		tsec, s3_sr, s3_cr, (s3_sr >> XAXIVDMA_FRMCNT_SHIFT) & 0xFFU, s3_sr & 0x1U, (s3_sr >> 1) & 0x1U,
+		(s3_sr >> 4) & 0x1U, (s3_sr >> 5) & 0x1U, (s3_sr >> 6) & 0x1U, (s3_sr >> 7) & 0x1U,
+		(s3_sr >> 8) & 0x1U, (s3_sr >> 11) & 0x1U, (s3_sr >> 15) & 0x1U, (s3_sr >> 14) & 0x1U);
+}
