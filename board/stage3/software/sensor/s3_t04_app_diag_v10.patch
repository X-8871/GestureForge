+/* 只读：cache 失效后回读 DDR 物理内存；打印 4096 个字里的非零字个数与样本字。*/
+static void s3_diag5_site(u32 site, u32 off)
+{
+	volatile u32 *s3_p = (volatile u32 *)((u8 *)dispCtrl.framePtr[dispCtrl.curFrame] + off);
+	u32 s3_i, s3_nz = 0;
+	/* 卡要求：读帧缓冲前先失效 4096 B。NZ 统计覆盖 4096 个字（16 KB），
+	 * 故把剩余 12 KB 一并失效，否则统计区后段可能命中陈旧 cache 行。*/
+	Xil_DCacheInvalidateRange((INTPTR)s3_p, 4096);
+	Xil_DCacheInvalidateRange((INTPTR)s3_p + 4096, 4096 * 4 - 4096);
+	for (s3_i = 0; s3_i < 4096; s3_i++) {
+		if (s3_p[s3_i] != 0U) { s3_nz++; }
+	}
+	xil_printf("S3_DIAG5_NZ site=%u off=0x%06X nz=%u/4096 fb0=%08X %08X %08X %08X %08X %08X %08X %08X +1000=%08X %08X %08X %08X\r\n",
+		site, off, s3_nz,
+		s3_p[0], s3_p[1], s3_p[2], s3_p[3], s3_p[4], s3_p[5], s3_p[6], s3_p[7],
+		s3_p[0x1000 / 4], s3_p[0x1000 / 4 + 1], s3_p[0x1000 / 4 + 2], s3_p[0x1000 / 4 + 3]);
+}
