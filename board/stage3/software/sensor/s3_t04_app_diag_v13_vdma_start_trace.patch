+#define S3_VDMA_TRACE_MAX_SAMPLES 7
+
+typedef struct {
+	const char *Stage;
+	u32 Cr;
+	u32 Sr;
+	u32 Vsize;
+	u32 Hsize;
+	u32 Stride;
+	u32 FrameAddr;
+} S3VdmaSnapshot;
+
+typedef struct {
+	UINTPTR BaseAddress;
+	int Count;
+	int LookupOk;
+	int CfgInitializeCalled;
+	int CfgInitializeStatus;
+	int DmaConfigCalled;
+	int DmaConfigStatus;
+	int SetBufferAddrCalled;
+	int SetBufferAddrStatus;
+	int DmaStartCalled;
+	int DmaStartStatus;
+	int Result;
+	S3VdmaSnapshot Samples[S3_VDMA_TRACE_MAX_SAMPLES];
+} S3VdmaTrace;
+
+/* 僅讀取 S2MM 控制、狀態、視頻尺寸與幀地址寄存器，不寫寄存器或清除粘滯位。 */
+static void s3_vdma_trace_sample(S3VdmaTrace *Trace, const char *Stage)
+{
+	S3VdmaSnapshot *Sample;
+
+	if (Trace->Count >= S3_VDMA_TRACE_MAX_SAMPLES) {
+		return;
+	}
+
+	Sample = &Trace->Samples[Trace->Count];
+	Sample->Stage = Stage;
+	Sample->Cr = Xil_In32(Trace->BaseAddress + XAXIVDMA_RX_OFFSET + XAXIVDMA_CR_OFFSET);
+	Sample->Sr = Xil_In32(Trace->BaseAddress + XAXIVDMA_RX_OFFSET + XAXIVDMA_SR_OFFSET);
+	Sample->Vsize = Xil_In32(Trace->BaseAddress + XAXIVDMA_S2MM_ADDR_OFFSET + XAXIVDMA_VSIZE_OFFSET);
+	Sample->Hsize = Xil_In32(Trace->BaseAddress + XAXIVDMA_S2MM_ADDR_OFFSET + XAXIVDMA_HSIZE_OFFSET);
+	Sample->Stride = Xil_In32(Trace->BaseAddress + XAXIVDMA_S2MM_ADDR_OFFSET + XAXIVDMA_STRD_FRMDLY_OFFSET);
+	Sample->FrameAddr = Xil_In32(Trace->BaseAddress + XAXIVDMA_S2MM_ADDR_OFFSET + XAXIVDMA_START_ADDR_OFFSET);
+	Trace->Count++;
+}
+
+/* 僅於所有快照採集完成後輸出，避免串口打印改變 API 間隔。 */
+static void s3_vdma_trace_print(const S3VdmaTrace *Trace)
+{
+	int i;
+
+	xil_printf("S3_VDMA_TRACE_SUMMARY base=0x%08x lookup_ok=%d samples=%d result=%d\r\n",
+		   (u32)Trace->BaseAddress, Trace->LookupOk, Trace->Count, Trace->Result);
+	xil_printf("S3_VDMA_TRACE_RC cfg_init_called=%d cfg_init_rc=%d dma_config_called=%d dma_config_rc=%d set_addr_called=%d set_addr_rc=%d dma_start_called=%d dma_start_rc=%d\r\n",
+		   Trace->CfgInitializeCalled, Trace->CfgInitializeStatus,
+		   Trace->DmaConfigCalled, Trace->DmaConfigStatus,
+		   Trace->SetBufferAddrCalled, Trace->SetBufferAddrStatus,
+		   Trace->DmaStartCalled, Trace->DmaStartStatus);
+	for (i = 0; i < Trace->Count; i++) {
+		const S3VdmaSnapshot *Sample = &Trace->Samples[i];
+		xil_printf("S3_VDMA_TRACE_SNAP stage=%s cr=0x%08x sr=0x%08x vsize=0x%08x hsize=0x%08x stride=0x%08x frame_addr=0x%08x\r\n",
+			   Sample->Stage, Sample->Cr, Sample->Sr, Sample->Vsize,
+			   Sample->Hsize, Sample->Stride, Sample->FrameAddr);
+	}
+}
