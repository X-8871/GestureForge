+/* ================= S3-DIAG5 只读诊断辅助（不改任何配置/时序） =================
+ * S2MM/MM2S 状态寄存器位定义依据（三者一致，证据在 tmp/s3r06/t04_j11cmos2_elf_v5/）：
+ *  1) 驱动头文件 axivdma_v6_17/src/xaxivdma_hw.h（任务卡引用 v6_15，位掩码同值）
+ *  2) IP 元数据 data/ip/xilinx/axi_vdma_v6_3/component.xml -> S2MM_VDMASR 字段 bitOffset
+ *  3) IP HDL axi_vdma_v6_3_vh_rfs.vhd -> DMASR_*_BIT 常量与状态寄存器拼装
+ * bit4=DMAIntErr bit5=DMASlvErr bit6=DMADecErr bit7=FSizeErr(SOFEarlyErr)
+ * bit8=LSizeErr(EOLEarlyErr) bit9=SGSlvErr bit10=SGDecErr bit11=FSizeMore/SOFLateErr
+ * bit12=FrmCntIrq bit13=DlyCntIrq bit14=ErrIrq bit15=LSizeMore(EOLLateErr)
+ * bit16..23=帧计数(IRQFrameCntSts) bit24..31=延迟计数
+ * 注意：驱动头文件记 bit11 为 ERR_FSZ_MORE(0x800)，IP 元数据记为 SOFLateErr —— 同一物理位。*/
+static void s3_diag5_regs(u32 phase)
+{
+	u32 s3_s2sr = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_RX_OFFSET + XAXIVDMA_SR_OFFSET);
+	u32 s3_s2cr = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_RX_OFFSET + XAXIVDMA_CR_OFFSET);
+	u32 s3_mmsr = XAxiVdma_ReadReg(XPAR_AXIVDMA_0_BASEADDR, XAXIVDMA_TX_OFFSET + XAXIVDMA_SR_OFFSET);
+	u32 s3_vsz = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_S2MM_ADDR_OFFSET + 0x00);
+	u32 s3_hsz = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_S2MM_ADDR_OFFSET + 0x04);
+	u32 s3_str = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_S2MM_ADDR_OFFSET + 0x08);
+	u32 s3_adr = XAxiVdma_ReadReg(XPAR_AXIVDMA_1_BASEADDR, XAXIVDMA_S2MM_ADDR_OFFSET + 0x0C);
+	xil_printf("S3_DIAG5_REG phase=%u S2MM_CR=0x%08X S2MM_SR=0x%08X FRMCNT=%u HALTED=%u IDLE=%u\r\n",
+		phase, s3_s2cr, s3_s2sr, (s3_s2sr >> XAXIVDMA_FRMCNT_SHIFT) & 0xFFU, s3_s2sr & 0x1U, (s3_s2sr >> 1) & 0x1U);
+	xil_printf("S3_DIAG5_SR_DECODE phase=%u INT=%u SLV=%u DEC=%u FSZ_LESS=%u LSZ_LESS=%u SG_SLV=%u SG_DEC=%u FSZ_MORE=%u FRMCNT_IRQ=%u DLY_IRQ=%u ERR_IRQ=%u LSZ_MORE=%u\r\n",
+		phase, (s3_s2sr >> 4) & 0x1U, (s3_s2sr >> 5) & 0x1U, (s3_s2sr >> 6) & 0x1U, (s3_s2sr >> 7) & 0x1U,
+		(s3_s2sr >> 8) & 0x1U, (s3_s2sr >> 9) & 0x1U, (s3_s2sr >> 10) & 0x1U, (s3_s2sr >> 11) & 0x1U,
+		(s3_s2sr >> 12) & 0x1U, (s3_s2sr >> 13) & 0x1U, (s3_s2sr >> 14) & 0x1U, (s3_s2sr >> 15) & 0x1U);
+	xil_printf("S3_DIAG5_CFG VSIZE=0x%08X HSIZE=0x%08X STRIDE=0x%08X ADDR=0x%08X MM2S_SR=0x%08X\r\n",
+		s3_vsz, s3_hsz, s3_str, s3_adr, s3_mmsr);
+}
+
+/* 只读：cache 失效后回读 DDR 物理内存；打印 4096 个字里的非零字个数与样本字。*/
+static void s3_diag5_site(u32 site, u32 off)
+{
+	volatile u32 *s3_p = (volatile u32 *)((u8 *)dispCtrl.framePtr[dispCtrl.curFrame] + off);
+	u32 s3_i, s3_nz = 0;
+	/* 卡要求：读帧缓冲前先失效 4096 B。NZ 统计覆盖 4096 个字（16 KB），
+	 * 故把剩余 12 KB 一并失效，否则统计区后段可能命中陈旧 cache 行。*/
+	Xil_DCacheInvalidateRange((INTPTR)s3_p, 4096);
+	Xil_DCacheInvalidateRange((INTPTR)s3_p + 4096, 4096 * 4 - 4096);
+	for (s3_i = 0; s3_i < 4096; s3_i++) {
+		if (s3_p[s3_i] != 0U) { s3_nz++; }
+	}
+	xil_printf("S3_DIAG5_NZ site=%u off=0x%06X nz=%u/4096 fb0=%08X %08X %08X %08X %08X %08X %08X %08X +1000=%08X %08X %08X %08X\r\n",
+		site, off, s3_nz,
+		s3_p[0], s3_p[1], s3_p[2], s3_p[3], s3_p[4], s3_p[5], s3_p[6], s3_p[7],
+		s3_p[0x1000 / 4], s3_p[0x1000 / 4 + 1], s3_p[0x1000 / 4 + 2], s3_p[0x1000 / 4 + 3]);
+}
+
+/* 只读：带传输状态检查的 16 位寄存器读（厂商 i2c_reg16_read 不看状态，失败会返回未初始化栈值）。
+ * 返回 0=成功，-1=失败；调用方按任务要求把读不到的值打印成 0xFF。*/
+static int s3_diag5_i2c_read16(u8 dev, u16 reg, u8 *val)
+{
+	u8 s3_wr[2];
+	u8 s3_rd = 0;
+	int s3_st;
+	s3_wr[0] = (u8)(reg >> 8);
+	s3_wr[1] = (u8)(reg & 0xFF);
+	s3_st = XIicPs_MasterSendPolled(&ps_i2c0, s3_wr, 2, dev);
+	while (XIicPs_BusIsBusy(&ps_i2c0)) { }
+	if (s3_st != XST_SUCCESS) { return -1; }
+	s3_st = XIicPs_MasterRecvPolled(&ps_i2c0, &s3_rd, 1, dev);
+	while (XIicPs_BusIsBusy(&ps_i2c0)) { }
+	if (s3_st != XST_SUCCESS) { return -1; }
+	*val = s3_rd;
+	return 0;
+}
+
+static u8 s3_diag5_sens(u16 reg)
+{
+	u8 s3_v = 0xFF;
+	if (s3_diag5_i2c_read16(0x3C, reg, &s3_v) != 0) { s3_v = 0xFF; }
+	return s3_v;
+}
