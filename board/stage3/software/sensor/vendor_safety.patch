+#include "PS_i2c.h"
+/* 沿用厂商逐次发送/接收协议；不增加重试、复位或模式变更。 */
+static int wait_idle(XIicPs *iic)
+{
+    u32 n;
+    for (n = 0; n < S3_I2C_BUSY_LIMIT; ++n)
+        if (!XIicPs_BusIsBusy(iic)) return XST_SUCCESS;
+    return S3_ERR_BUSY;
+}
+static int send(XIicPs *iic, u8 slave, u8 *data, int count)
+{
+    int status;
+    if (iic == NULL || slave > 0x7fU) return S3_ERR_ARGUMENT;
+    status = wait_idle(iic);
+    if (status != XST_SUCCESS) return status;
+    status = XIicPs_MasterSendPolled(iic, data, count, slave);
+    if (status != XST_SUCCESS) return status;
+    return wait_idle(iic);
+}
+static int read_reg(XIicPs *iic, u8 slave, u8 *address, int count, u8 *out)
+{
+    u8 value;
+    int status;
+    if (out == NULL) return S3_ERR_ARGUMENT;
+    status = send(iic, slave, address, count);
+    if (status != XST_SUCCESS) return status;
+    status = XIicPs_MasterRecvPolled(iic, &value, 1, slave);
+    if (status != XST_SUCCESS) return status;
+    status = wait_idle(iic);
+    if (status != XST_SUCCESS) return status;
+    *out = value;
+    return XST_SUCCESS;
+}
+int i2c_reg8_write(XIicPs *iic, u8 slave, u8 addr, u8 data)
+{
+    u8 buffer[2] = {addr, data};
+    return send(iic, slave, buffer, 2);
+}
+int i2c_reg16_write(XIicPs *iic, u8 slave, u16 addr, u8 data)
+{
+    u8 buffer[3] = {(u8)(addr >> 8), (u8)addr, data};
+    return send(iic, slave, buffer, 3);
+}
+int i2c_reg8_read(XIicPs *iic, u8 slave, u8 addr, u8 *out)
+{
+    return read_reg(iic, slave, &addr, 1, out);
+}
+int i2c_reg16_read(XIicPs *iic, u8 slave, u16 addr, u8 *out)
+{
+    u8 buffer[2] = {(u8)(addr >> 8), (u8)addr};
+    return read_reg(iic, slave, buffer, 2, out);
+}
+int i2c_init(XIicPs *iic, s3_iic_device_id device, u32 rate)
+{
+    XIicPs_Config *config;
+    int status;
+    if (iic == NULL || rate == 0U) return S3_ERR_ARGUMENT;
+    config = XIicPs_LookupConfig(device);
+    if (config == NULL) return XST_FAILURE;
+    status = XIicPs_CfgInitialize(iic, config, config->BaseAddress);
+    if (status != XST_SUCCESS) return status;
+    status = XIicPs_SetSClk(iic, rate);
+    if (status != XST_SUCCESS) return status;
+    return wait_idle(iic);
+}
