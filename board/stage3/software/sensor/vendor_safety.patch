+int ov5640_read(XIicPs *iic, u16 addr, u8 *out)
+{
+    return i2c_reg16_read(iic, 0x3c, addr, out);
+}
+int ov5640_write(XIicPs *iic, u16 addr, u8 data)
+{
+    return i2c_reg16_write(iic, 0x3c, addr, data);
+}
+/* 长度含终止符；调用者保证该长度对应真实可读对象。首个错误立即返回。 */
+int sensor_write_array(XIicPs *iic, const struct reginfo *table, size_t length)
+{
+    size_t n;
+    int status;
+    if (iic == NULL || table == NULL || length == 0) return S3_ERR_ARGUMENT;
+    for (n = 0; n < length; ++n) {
+        if (table[n].reg == SEQUENCE_END) return XST_SUCCESS;
+        status = ov5640_write(iic, table[n].reg, table[n].val);
+        if (status != XST_SUCCESS) return status;
+    }
+    return S3_ERR_TABLE;
+}
+int sensor_init(XIicPs *iic)
+{
+    u8 high, low;
+    int status;
+    status = ov5640_read(iic, 0x300a, &high);
+    if (status != XST_SUCCESS) return status;
+    status = ov5640_read(iic, 0x300b, &low);
+    if (status != XST_SUCCESS) return status;
+    if (high != 0x56 || low != 0x40) return S3_ERR_ID;
+    return sensor_write_array(iic, sensor_init_data,
+                             sizeof(sensor_init_data) / sizeof(sensor_init_data[0]));
+}
