  "results_checks_rule": "checks 必须是对象且含布尔 passed 与数组 failures；**passed 必须为 true**（失败运行不得作为交付证据），且 failures 为空时 passed 必须为 true",
  "event_log_fields": {
    "authoritative": true,
    "legend_ref": "docs/stage5/s5t03_offline_skeleton_params_v1.json#log_artifacts.compact_fields_result_submit / .compact_fields_overlay_commit",
    "note": "帧级事件日志是计数复算的权威来源。**v1.0.2 更正**：早期版本曾把 frame_assertions 的字段名误当事件日志键位——键位一律以下方 compact 键为准（与实物逐字一致）。",
    "submit_record_keys": [
      "t",
      "fid",
      "sid",
      "seq",
      "oc",
      "vf",
      "rr",
      "ri",
      "rd",
      "rb",
      "pri"
    ],
    "submit_record_meaning": {
      "t": "sub（记录类型）",
      "fid": "frame_id（原始输入）",
      "sid": "session_id",
      "seq": "result_seq",
      "oc": "outcome: accepted|duplicate|duplicate_frame_id|out_of_order|invalid",
      "vf": "verdict: PASS|FAIL",
      "rr": "reject_reason（无拒绝时为 null）",
      "ri": "输入 repeat_index",
      "rd": "repeat_declared 原始布尔值",
      "rb": "declared_repeat_basis",
      "pri": "同 session/frame 已接受的前序最大 repeat_index"
    },
    "commit_record_keys": [
      "t",
      "dfid",
      "ts",
      "rfid",
      "sid",
      "seq",
      "st",
      "dr",
      "bx",
      "za",
      "se",
      "w"
    ],
    "commit_record_meaning": {
      "t": "commit（记录类型）",
      "dfid": "displayed_frame_id",
      "ts": "overlay_commit_ns",
      "rfid": "result_frame_id",
      "sid": "session_id",
      "seq": "result_seq",
      "st": "state",
      "dr": "drawn 0/1",
      "bx": "boxes",
      "za": "zero_area_dropped",
      "se": "stale_effective 0/1",
      "w": "warmup 0/1"
    },
    "reject_reason_key": "rr（事件日志中的拒绝原因串）；results.submit_verdicts[].reject_reason 是另一路描述（见 known_inconsistencies）",
    "validator_check": "校验器读取 logs/events_*.jsonl(.gz) 首条 submit/commit 记录的键集，与本节声明逐字比对；不一致即违约（防止契约与实物漂移）。"
  },
  "known_inconsistencies": [
    {
      "id": "reject_reason_two_forms",
      "description": "同一被拒提交：results.submit_verdicts[].reject_reason（如 derived:duplicate）与事件日志 rr（如 duplicate_result_key）可能不同；两者只在 submit_verdicts 侧带 reject_reason_source 标注。",
      "consumer_rule": "阶段6 需要唯一原因时**以事件日志 rr 为准**；本契约不统一该差异（未在 v1 变更）。"
    }
  ],
  "stability": {
    "stable_for_consumers": [
      "results.schema_version（值必须等于对应 artifact_kinds[*].schema_version）",
      "results.run_id",
      "results.task_id",
      "results.generated_utc8",
      "results.source_commit",
      "results.status",
      "results.input_scope_label",
      "results.checks",
      "results.counters（14 键语义）",
      "results.boundary_cases",
      "results.invariants（长跑，含 10 个必需键）",
      "results.geometries / numeric_checks（多几何）",
      "results.stream.frame_period_ns（**短跑与长跑均提供**；阶段6 T6-A03 的帧周期来源） —— 注意：这是**离线虚拟步长**，**不等于**阶段4 实测帧周期 P；T6-A03 数值仍 NOT_RUN",
      "frame_assertion_stable_required（逐帧，必须存在）",
