        "margin_ns",
        "canonical_long_run",
        "one_commit_event_per_frame",
        "commit_timestamps_monotonic",
        "recompute_matches_online",
        "no_deadlock"
      ],
      "detect": "results.json 含 invariants"
    },
    "multi_geometry_render": {
      "schema_version": "gestureforge_s5t03_multi_geometry_render_v1",
      "requires_frame_assertions": false,
      "required_results": [
        "geometries",
        "numeric_checks",
        "limitations",
        "not_run"
