}

unsigned long
ps7GetSiliconVersion () {

  unsigned long mask = 0xF0000000;
  unsigned long *addr = (unsigned long*) 0XF8007080;
  unsigned long ps_version = (*addr & mask) >> 28;
  return ps_version;
}

void mask_write (unsigned long add , unsigned long mask, unsigned long val ) {
        volatile unsigned long *addr = (volatile unsigned long*) add;
        *addr = ( val & mask ) | ( *addr & ~mask);

}


int mask_poll(unsigned long add , unsigned long mask ) {
        volatile unsigned long *addr = (volatile unsigned long*) add;
        int i = 0;
        while (!(*addr & mask)) {
          if (i == 100000000) {
            return -1;
          }
          i++;
        }
     return 1;

}

unsigned long mask_read(unsigned long add , unsigned long mask ) {
        volatile unsigned long *addr = (volatile unsigned long*) add;
        unsigned long val = (*addr & mask);

        return val;
}



int
ps7_config(unsigned long * ps7_config_init)
{
    unsigned long *ptr = ps7_config_init;

    unsigned long opcode;
    unsigned long args[16];
    int numargs;
    int j;

    volatile unsigned long *addr;
    unsigned long val,mask;

    int finish = -1 ;
    int i = 0;

    while( finish < 0 ) {
        numargs = ptr[0] & 0xF;
        opcode = ptr[0] >> 4;

        for( j = 0 ; j < numargs ; j ++ )
            args[j] = ptr[j+1];
        ptr += numargs + 1;


        switch ( opcode ) {

        case 0U:
            finish = (0);
            break;

        case 1U:
            addr = (unsigned long*) args[0];
            *addr = 0;
            break;

        case 2U:
            addr = (unsigned long*) args[0];
            val = args[1];
            *addr = val;
            break;

        case 3U:
            addr = (unsigned long*) args[0];
            mask = args[1];
            val = args[2];
            *addr = ( val & mask ) | ( *addr & ~mask);
            break;

        case 4U:
            addr = (unsigned long*) args[0];
            mask = args[1];
            i = 0;
            while (!(*addr & mask)) {
                if (i == 100000000) {
                    finish = (2);
                    break;
                }
                i++;
            }
            break;
        case 5U:
     {
      addr = (unsigned long*) args[0];
      mask = args[1];
      int delay = get_number_of_cycles_for_delay(mask);
      perf_reset_and_start_timer();
      while ((*addr < delay)) {
      }
     }
     break;
 default:
     finish = (1);
     break;
 }
    }
    return finish;
}

