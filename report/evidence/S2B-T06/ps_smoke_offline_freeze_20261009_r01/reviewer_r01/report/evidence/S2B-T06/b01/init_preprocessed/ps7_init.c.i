 *(volatile unsigned int*)0xF8F00200 = 0;
 *(volatile unsigned int*)0xF8F00204 = 0;
}


int get_number_of_cycles_for_delay(unsigned int delay)
{

  return (666666687*delay/(2*1000));

}


 void perf_disable_clock(void)
{
 *(volatile unsigned int*)0xF8F00208 = 0;
}

