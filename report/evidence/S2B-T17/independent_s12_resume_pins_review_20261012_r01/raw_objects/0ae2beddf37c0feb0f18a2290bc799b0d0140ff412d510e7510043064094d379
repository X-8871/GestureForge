def command(label, argv, expected=0):
    """逐子命令捕获真实PID、出生时间、等待退出、离散内存及原始流。"""
    if label.startswith('source_'):
        # 复用本轮r02已完成的真实单Git核验，避免因审查夹具字段错误重复派发。
        previous=read(HERE/('r02_'+label+'.native.json'))
        assert previous['argv']==argv and previous['native_exit_code']==expected
        assert not any(row['same_identity_exists'] for row in previous['known_children_closed'])
        for kind in ('stdout','stderr'):
            binding(previous[kind]['path'],previous[kind]['sha256'])
        calls.append(dict(previous,reused_from='r02_'+label+'.native.json'))
        return Path(previous['stdout']['path']).read_bytes()
    output = HERE/(PREFIX+label+'.stdout.bin')
    error = HERE/(PREFIX+label+'.stderr.bin')
    began = time.monotonic()
    unknown = []
    peak = 0
    with output.open('xb') as stdout, error.open('xb') as stderr:
        child = subprocess.Popen(argv, cwd=ROOT, stdout=stdout, stderr=stderr)
        identity = psutil.Process(child.pid)
        birth = identity.create_time()
        identities = {child.pid: birth}
        while child.poll() is None:
            try:
                tree = [psutil.Process()] + psutil.Process().children(recursive=True)
                total = 0
                for process in tree:
                    try:
                        total += process.memory_info().rss
                        identities[process.pid] = process.create_time()
                    except (psutil.NoSuchProcess, psutil.AccessDenied) as exc:
                        unknown.append({'pid': process.pid, 'exception': type(exc).__name__})
                peak = max(peak, total)
            except (psutil.NoSuchProcess, psutil.AccessDenied) as exc:
                unknown.append({'pid': None, 'exception': type(exc).__name__})
            assert peak <= 268435456, '独占轻量进程树超过256MiB'
            assert time.monotonic()-began < 120, '单子命令超120秒'
            time.sleep(.02)
        code = child.wait()
    closed = []
    for pid, created in identities.items():
        if pid == os.getpid():
            continue
        try:
            process = psutil.Process(pid)
            exists_same = process.create_time() == created
            closed.append({'pid': pid, 'create_time': created, 'same_identity_exists': exists_same})
        except psutil.NoSuchProcess:
            closed.append({'pid': pid, 'create_time': created, 'same_identity_exists': False})
    assert not any(row['same_identity_exists'] for row in closed), label+'尚存本次已知子进程'
    value = {'label': label, 'argv': argv, 'cwd': str(ROOT), 'native_exit_code': code,
             'elapsed_seconds': time.monotonic()-began, 'child_pid': child.pid,
             'child_create_time': birth, 'wait_returned': True, 'known_children_closed': closed,
             'sampled_tree_peak_bytes': peak, 'unknown_samples': unknown, 'absolute_tree_peak_bytes': None,
             'stdout': {'path': str(output), 'sha256': digest(output)},
             'stderr': {'path': str(error), 'sha256': digest(error)}}
    write(label+'.native.json', value)
    calls.append(value)
    assert code == expected, (label, code, error.read_text(encoding='utf-8', errors='replace'))
    return output.read_bytes()

def git(label, *args):
    """单Git子进程、长路径及禁自动维护。"""
    return command(label, [GIT, '-c', 'core.longpaths=true', '-c', 'maintenance.auto=false', *args])

def binding(path, expected, length=None):
    """已存在目标逐组件核验精确名称与类型。"""
    path = Path(path)
    if not path.is_absolute():
        # 工具清单的六个短名称明确定义为WORK相对路径。
        short_tools = {'collector.py','impl_collector.py','source_after_check.py','native_source_after.py','native.py','compat_pins.py'}
        path = (DEV if str(path) in short_tools else ROOT)/path
    current = Path(path.anchor)
    for part in path.parts[1:]:
        assert part in {item.name for item in current.iterdir()}, str(path)
        current = current/part
        assert not current.is_symlink() and not current.is_junction(), str(path)
    assert current.is_file(), str(path)
    actual = digest(current)
    assert actual == expected, str(path)
    if length is not None:
        assert current.stat().st_size == length, str(path)
    read_bindings.append({'path': str(current), 'sha256': actual, 'bytes': current.stat().st_size})
    return current

def walk_bindings(value):
    """递归核验声明的文件绑定，不执行输入命令。"""
    if isinstance(value, dict):
        if isinstance(value.get('sha256'), str):
            for key in ('path', 'artifact_repo_path'):
                if key in value:
                    binding(value[key], value['sha256'], value.get('bytes'))
        for child in value.values():
            walk_bindings(child)
    elif isinstance(value, list):
        for child in value:
            walk_bindings(child)

def negative(name, action):
    """仅内存反例，不能接触被审路径。"""
    try:
        action()
    except (ValueError, AssertionError) as exc:
        checks.append({'name': name, 'status': 'REJECTED_EXPECTED', 'exception': str(exc)})
    else:
        raise AssertionError(name+'误接受')

