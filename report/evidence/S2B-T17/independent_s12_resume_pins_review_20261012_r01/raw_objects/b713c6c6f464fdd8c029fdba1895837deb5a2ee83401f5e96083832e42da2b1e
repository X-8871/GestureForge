"""独审外层捕获；仅启动本轮审查子进程。"""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import psutil

HERE=Path(__file__).absolute().parent
label=sys.argv[1]
assert label.isidentifier()
script=sys.argv[2] if len(sys.argv)>2 else 'review.py'
assert script in ('review.py','seal.py')
argv=[sys.executable,'-X','utf8','-B',str(HERE/script)]
started=time.monotonic()
peak=0
unknown=[]
identities={}
with (HERE/(label+'.stdout.bin')).open('xb') as stdout,(HERE/(label+'.stderr.bin')).open('xb') as stderr:
    child=subprocess.Popen(argv,cwd=HERE.parents[3],stdout=stdout,stderr=stderr)
    identities[child.pid]=psutil.Process(child.pid).create_time()
    while child.poll() is None:
        value=0
        for process in [psutil.Process()]+psutil.Process().children(recursive=True):
            try:
                value+=process.memory_info().rss
                identities[process.pid]=process.create_time()
            except (psutil.NoSuchProcess,psutil.AccessDenied) as exc:
                unknown.append({'pid':process.pid,'exception':type(exc).__name__})
        peak=max(peak,value)
        assert peak<=268435456 and time.monotonic()-started<120
        time.sleep(.02)
    code=child.wait()
closed=[]
for pid,birth in identities.items():
    if pid==os.getpid():
        continue
    try:
        same=psutil.Process(pid).create_time()==birth
    except psutil.NoSuchProcess:
        same=False
    closed.append({'pid':pid,'create_time':birth,'same_identity_exists':same})
result={'argv':argv,'wrapper_argv':sys.orig_argv,'native_exit_code':code,'elapsed_seconds':time.monotonic()-started,
    'sampled_owned_tree_peak_bytes':peak,'unknown_samples':unknown,'absolute_tree_peak_bytes':None,
    'known_children_closed':closed,'wait_returned':True}
for kind in ('stdout','stderr'):
    path=HERE/(label+'.'+kind+'.bin')
    result[kind]={'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}
with (HERE/(label+'.native.json')).open('x',encoding='utf-8',newline='\n') as stream:
    json.dump(result,stream,ensure_ascii=False,indent=2);stream.write('\n')
print(json.dumps(result,ensure_ascii=False))
sys.exit(code)
