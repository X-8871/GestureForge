from datetime import datetime, timezone, timedelta
import hashlib
import json
from pathlib import Path
import subprocess
import psutil

HERE=Path(__file__).absolute().parent
ROOT=HERE.parents[3]
def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
def read(path):
    return json.loads(path.read_text(encoding='utf-8'))
def save(name,value):
    with (HERE/name).open('x',encoding='utf-8',newline='\n') as stream:
        json.dump(value,stream,ensure_ascii=False,indent=2);stream.write('\n')
review=read(HERE/'r03_review_receipt.json')
closed=[]
native=[]
for path in sorted(HERE.glob('*.native.json')):
    value=read(path)
    native.append({'path':str(path),'sha256':sha(path),'native_exit_code':value['native_exit_code']})
    for row in value.get('known_children_closed',[]):
        try:
            same=psutil.Process(row['pid']).create_time()==row['create_time']
        except psutil.NoSuchProcess:
            same=False
        closed.append(dict(row,same_identity_exists_at_seal=same))
assert not any(r['same_identity_exists_at_seal'] for r in closed)
root_receipt=ROOT/'tmp/2B/S2B-T17/s12_root_run_20261012_r01/goal_continuation_20261012_r01/developer_process_identity_clarification.json'
assert root_receipt.is_file()
external={'path':str(root_receipt),'sha256':sha(root_receipt)}
git=[r'C:\Program Files\Git\bin\git.exe','-c','core.longpaths=true','-c','maintenance.auto=false']
git_terminal=[]
for label,args in [('seal_r03_head',['rev-parse','HEAD']),('seal_r03_stage',['diff','--cached','--name-only'])]:
    result=subprocess.run(git+args,cwd=ROOT,capture_output=True,timeout=30)
    assert result.returncode==0
    for kind,data in [('stdout',result.stdout),('stderr',result.stderr)]:
        with (HERE/(label+'.'+kind+'.bin')).open('xb') as stream:stream.write(data)
    git_terminal.append({'argv':git+args,'native_exit_code':result.returncode,'stdout_sha256':sha(HERE/(label+'.stdout.bin')),'stderr_sha256':sha(HERE/(label+'.stderr.bin'))})
    if label=='seal_r03_head':assert result.stdout.decode('ascii').strip()==review['source_commit']
    else:assert not result.stdout.strip()
save('seal_git_terminal_r03.json',git_terminal)
