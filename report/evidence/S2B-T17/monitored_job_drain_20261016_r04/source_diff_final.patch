+    def test_slow_final_root_exit_code_read_fails_resource_gap(self):
+        class Clock:
+            value = 0.0
+
+            def monotonic(self):
+                return self.value
+
+            def sleep(self, seconds):
+                self.value += max(0.0, seconds)
+
+        clock = Clock()
