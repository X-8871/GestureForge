+                raise supervisor._DrainWaitFailure(
+                    "FAIL_RESOURCE_SAMPLE_GAP", "模拟最终root退出码读取跨过1秒采样上限")
+            if previous is None or now - previous >= 0.25:
+                last_sample["seconds"] = now
