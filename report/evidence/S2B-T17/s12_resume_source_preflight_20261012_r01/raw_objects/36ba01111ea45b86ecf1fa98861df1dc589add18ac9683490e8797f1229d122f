        snapshot = HERE/'freeze_snapshots'/item['path']
        raw(snapshot, source)
        rows.append(dict(item, snapshot=snapshot.relative_to(ROOT).as_posix(), git_native=new_native, git_blob_sha256=sha(new_blob), git_relation=relation))
        object_rows.append({'path': item['path'], 'raw_sha256': sha(source), 'raw_bytes': len(source), 'git_blob_sha256': sha(new_blob), 'git_relation': relation,
