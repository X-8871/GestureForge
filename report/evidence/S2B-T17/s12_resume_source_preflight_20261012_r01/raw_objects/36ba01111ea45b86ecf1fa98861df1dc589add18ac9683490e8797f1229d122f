def sha(value):
    return hashlib.sha256(value).hexdigest()

def exact(path, directory=False):
    current = Path(path.anchor)
    for name in path.parts[1:]:
        hits = [item for item in current.iterdir() if item.name == name]
        assert len(hits) == 1, str(path)
        current = hits[0]
        assert not current.is_symlink() and not current.is_junction()
    assert current.is_dir() if directory else current.is_file()
    return current

def raw(path, data):
    assert path.is_relative_to(HERE)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data)

def write(path, data):
    raw(path, (json.dumps(data, ensure_ascii=False, indent=2) + '\n').encode('utf-8'))

def git(label, *args):
    command = [str(exact(GIT)), '-c', 'core.longpaths=true', '-c', 'maintenance.auto=false', *args]
    result = subprocess.run(command, cwd=ROOT, capture_output=True, timeout=30)
    out = HERE / 'git_raw' / (label + '.stdout.bin')
    err = HERE / 'git_raw' / (label + '.stderr.bin')
    raw(out, result.stdout)
    raw(err, result.stderr)
    record = {'command': command, 'cwd': str(ROOT), 'native_exit_code': result.returncode,
              'stdout': {'path': out.relative_to(ROOT).as_posix(), 'sha256': sha(result.stdout), 'bytes': len(result.stdout)},
              'stderr': {'path': err.relative_to(ROOT).as_posix(), 'sha256': sha(result.stderr), 'bytes': len(result.stderr)}}
    write(HERE / 'git_raw' / (label + '.native.json'), record)
    assert result.returncode == 0, record
    return result.stdout, record

