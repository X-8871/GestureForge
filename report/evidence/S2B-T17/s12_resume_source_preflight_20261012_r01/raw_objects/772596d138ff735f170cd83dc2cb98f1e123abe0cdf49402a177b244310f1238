def pack():
    p.require_ready()
    p.exact(OUT, True)
    assert (HERE/'post_head.stdout.bin').read_text(encoding='utf-8').strip() == p.SOURCE_COMMIT
    test = json.loads((HERE/'final_pins_test_receipt.json').read_text(encoding='utf-8'))
    assert test['case_count'] == 20 and test['resource_admission']['status']=='BLOCKED_RESOURCE_ADMISSION'
    assert not p.PROJECT.exists() and not p.SYNTH_REPORT.exists() and not p.PNR_REPORT.exists()
    for folder in ('raw_objects', 'tools'):
        assert not (OUT/folder).exists(); (OUT/folder).mkdir()
    canonical = {digest(path): path for path in scan(OUT/'source_snapshot')}
    mapping = []
    for source in scan(HERE):
        if source.name.startswith(('pack.', 'seal.', 'final_evidence.', 'final_inputs.', 'append.')):
            continue
        expected = digest(source)
        if expected not in canonical:
            dest = OUT/'raw_objects'/expected
            copy(source, dest); canonical[expected] = dest
        mapping.append({'original_repo_path': source.relative_to(ROOT).as_posix(), 'original_absolute_path': str(source),
            'archived_repo_path': canonical[expected].relative_to(ROOT).as_posix(), 'sha256': expected, 'bytes': source.stat().st_size})
    with (OUT/'raw_manifest.jsonl').open('x', encoding='utf-8', newline='\n') as stream:
        for row in mapping:
            stream.write(json.dumps(row, ensure_ascii=False)+'\n')
    for name in ('source_freeze.json', 'tool_binding.json', 'source_object_equivalence.json', 'execution_plan.json', 'final_pins_test_receipt.json', 'prepared_receipt.json'):
        copy(HERE/name, OUT/name)
    binding = json.loads((HERE/'tool_binding.json').read_text(encoding='utf-8'))
    for row in binding['tools']:
        for suffix in ('', '.diff'):
            copy(HERE/(row['path']+suffix), OUT/'tools'/(row['path']+suffix))
    recovery = {'status': 'RECOVERABLE_RESUME_INPUTS_ONLY_PENDING_G2_AND_RESOURCE_ADMISSION', 'fixed_project_root': str(ROOT), 'source_commit': p.SOURCE_COMMIT,
        'source_freeze': {'destination_absolute_path': str(HERE/'source_freeze.json'), 'artifact_repo_path': (OUT/'source_freeze.json').relative_to(ROOT).as_posix(), 'sha256': digest(OUT/'source_freeze.json')},
        'tools': [{'destination_absolute_path': str(HERE/row['path']), 'artifact_repo_path': (OUT/'tools'/row['path']).relative_to(ROOT).as_posix(), 'sha256': row['sha256'], 'bytes': row['bytes']} for row in binding['tools']],
        'tool_binding_sha256': digest(OUT/'tool_binding.json'), 'raw_manifest_sha256': digest(OUT/'raw_manifest.jsonl'), 'raw_rows': len(mapping),
        'restore_performed': False, 'restore_instruction': '仅在原固定完整路径缺失及ROOT确认恢复范围后逐项SHA/bytes恢复；formal tools层级不同，禁止直接执行正式副本；旧r02不覆盖。',
        'guard_recovery_reference': {'path': 'report/evidence/S2B-T17/s12_resource_guard_delivery_20261012_r01/recovery_entry.json', 'sha256': p.RECOVERY_SHA, 'mapping_sha256': p.MAPPING_SHA},
        'future_targets': {'project': str(p.PROJECT), 'synth_report': str(p.SYNTH_REPORT), 'pnr_report': str(p.PNR_REPORT), 'actual_created': False},
        'owned_session_id': 'PENDING', 'owned_root_pid': 'PENDING', 'owned_log': 'PENDING', 'pnr_synth_manifest_sha256': None, 'pnr_synth_g2_sha256': None,
        'physical_g0': 'BLOCKED', 'actual_after': 'NOT_RUN', 'actual_budget_sta_g3_g5': 'NOT_RUN', 'old_s11_budget': 'BLOCKED'}
    write(OUT/'recovery_entry.json', recovery)
    natives = [json.loads(path.read_text(encoding='utf-8')) for path in HERE.glob('*.native.json')]
    author = {'status': 'STOP_RESUME_PINS_LOGIC_G1_PENDING_INDEPENDENT_G2', 'source_commit': p.SOURCE_COMMIT, 'code_commit': '09b4c6f60fb74c2fda1b56d2f316ca374dfae7cf',
        'source_count': 43, 'static_count': 33, 'rtl_count': 18, 'derived_count': 8, 'frozen14_count': 14, 'git_raw_identical': 37, 'git_eol_exact': 6, 'logic_case_count': 20,
        'changed_files': ['compat_pins.py'], 'changed_top_level_constants': ['SOURCE_COMMIT', 'SOURCE_FREEZE_SHA', 'SYNTH_REPORT', 'PNR_REPORT', 'SOURCE_PRE'], 'function_ast_changed': False,
        'source_freeze_sha256': digest(OUT/'source_freeze.json'), 'helper_sha256': digest(OUT/'tools/compat_pins.py'), 'tool_binding_sha256': digest(OUT/'tool_binding.json'),
