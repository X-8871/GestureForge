def close(labels, name):
    folder = OUT/'closed_packaging'
    if not folder.exists(): folder.mkdir()
    for label in labels:
        for suffix in ('.stdout.bin', '.stderr.bin', '.native.json'):
            copy(HERE/(label+suffix), folder/(label+suffix))
    manifest(name)
    print(json.dumps({'manifest': (OUT/name).relative_to(ROOT).as_posix(), 'sha256': digest(OUT/name)}, ensure_ascii=False))

if __name__ == '__main__':
    if sys.argv[1] == 'pack': pack()
    elif sys.argv[1] == 'seal': close(('pack', 'precheck_evidence', 'precheck_inputs'), 'delivery_manifest_r01.json')
    elif sys.argv[1] == 'append': close(('seal', 'final_evidence', 'final_inputs'), 'delivery_manifest.json')
