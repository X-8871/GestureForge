import hashlib
import json
from pathlib import Path
import sys
import compat_pins as p

HERE = Path(__file__).absolute().parent
ROOT = HERE.parents[3]
OUT = p.SOURCE_PRE

def digest(path):
    return hashlib.sha256(p.exact(path).read_bytes()).hexdigest()

def write(path, value):
    with path.open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2); stream.write('\n')

def copy(source, target):
    expected = digest(source)
    p.exact(target.parent, True)
    with target.open('xb') as stream:
        stream.write(p.exact(source).read_bytes())
    assert digest(source) == digest(target) == expected

def scan(base):
    p.exact(base, True)
    return sorted(p.exact(path) for path in base.rglob('*') if path.is_file())

