def sha(data):
    return hashlib.sha256(data).hexdigest()

def exact(path, directory=False):
    """逐组件核精确名称和类型；不接收链接路径。"""
    path = pathlib.Path(path)
    assert path.is_absolute()
    current = pathlib.Path(path.anchor)
    for name in path.parts[1:]:
        matches = [p for p in current.iterdir() if p.name == name]
        assert len(matches) == 1, str(path)
        current = matches[0]
        assert not current.is_symlink() and not current.is_junction()
    assert current.is_dir() if directory else current.is_file()
    return current

def write(path, value):
    with path.open("x", encoding="utf-8", newline="\n") as f:
        json.dump(value, f, ensure_ascii=False, indent=2)
        f.write("\n")

def raw(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as f:
        f.write(data)

def bound(path):
    data = exact(path).read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": sha(data), "bytes": len(data)}

calls = []
def git(*args):
    """每条真实只读Git命令单独保留原字节及原生码。"""
    cmd = ["git", "-C", str(ROOT), *args]
    r = subprocess.run(cmd, capture_output=True, timeout=30)
    index = len(calls)
    base = HERE / "generation_git" / ("git_" + str(index).zfill(2))
    stdout, stderr = base.with_suffix(".stdout.bin"), base.with_suffix(".stderr.bin")
    raw(stdout, r.stdout); raw(stderr, r.stderr)
    record = {"command": cmd, "native_exit_code": r.returncode, "stdout": bound(stdout), "stderr": bound(stderr)}
    write(base.with_suffix(".native.json"), record)
    calls.append(record)
    assert r.returncode == 0, "真实Git只读调用失败"
    return r.stdout

