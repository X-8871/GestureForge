def seal():
    for label in ("pack", "precheck_evidence", "precheck_inputs"):
        for suffix in (".stdout.bin", ".stderr.bin", ".native.json"):
            copy(HERE / (label + suffix), OUT / "closed_packaging" / (label + suffix))
    manifest("delivery_manifest.json")
    print(json.dumps({"manifest_sha256": digest(OUT / "delivery_manifest.json")[0], "source_freeze_sha256": digest(OUT / "source_freeze.json")[0], "source_before_sha256": digest(OUT / "source_before.json")[0], "receipt_sha256": digest(OUT / "author_receipt.json")[0], "raw_manifest_sha256": digest(OUT / "raw_manifest.jsonl")[0]}, ensure_ascii=False))

