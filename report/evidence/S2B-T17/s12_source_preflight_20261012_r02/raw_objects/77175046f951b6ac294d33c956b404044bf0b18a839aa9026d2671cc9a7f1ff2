def digest(path):
    h = hashlib.sha256()
    size = 0
    with path.open("rb") as f:
        while block := f.read(65536):
            h.update(block); size += len(block)
    return h.hexdigest(), size

def write(path, value):
    with path.open("x", encoding="utf-8", newline="\n") as f:
        json.dump(value, f, ensure_ascii=False, indent=2); f.write("\n")

def copy(source, dest):
    source = p.exact(source)
    before = digest(source)
    dest.parent.mkdir(parents=True, exist_ok=True)
    with source.open("rb") as src, dest.open("xb") as dst:
        while block := src.read(65536): dst.write(block)
    assert digest(source) == digest(dest) == before

def source_files(base):
    p.exact(base, True)
    for directory, dirs, files in __import__("os").walk(base, followlinks=False):
        current = pathlib.Path(directory)
        for name in dirs:
            target = current / name
            assert not target.is_symlink() and not target.is_junction()
        for name in files:
            yield p.exact(current / name)

