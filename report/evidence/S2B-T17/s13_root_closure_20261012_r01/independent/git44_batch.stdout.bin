    manual=[]
    def hand(label,expected,patch_bytes,reduction,**changes):
        v=dict(layer0);v.update(input_channels=1,input_height=1,input_width=1,output_height=1,output_width=1,
            kernel_height=1,kernel_width=1,stride_y=1,stride_x=1);v.update(changes)
        v.update(input_length_bytes=(v["input_channels"]*v["input_height"]*v["input_width"])&0xffffffff,
            output_length_bytes=(32*v["output_height"]*v["output_width"])&0xffffffff,
            quantized_weight_bytes=(32*v["input_channels"]*v["kernel_height"]*v["kernel_width"])&0xffffffff)
        ph=(min(v["output_height"],8)-1)*v["stride_y"]+v["kernel_height"]
        pw=(min(v["output_width"],8)-1)*v["stride_x"]+v["kernel_width"]
        if ph*pw*v["input_channels"]!=patch_bytes or v["input_channels"]*v["kernel_height"]*v["kernel_width"]!=reduction:
            raise ValueError("手算输入不符："+label)
        if add("patch_manual_"+label,v)!=expected:raise ValueError("手算错误优先不符："+label)
        manual.append({"label":label,"inputs":v,"expected_error":expected,"reduction":reduction,"patch_height":ph,"patch_width":pw,"patch_bytes":patch_bytes})
        return v
    hand("reduction_4608",0,4608,4608,input_channels=512,input_height=3,input_width=3,kernel_height=3,kernel_width=3)
    hand("reduction_4609",1,4609,4609,input_channels=4609)
    hand("patch_51200_plane",0,51200,1,input_height=200,input_width=256,output_height=2,output_width=4,stride_y=199,stride_x=85)
    hand("patch_51201_channel_product",2,51201,27,input_channels=3,input_height=3,input_width=5690,output_width=2,
        kernel_height=3,kernel_width=3,stride_x=5686)
    p65536=hand("patch_65536_plane_overflow",2,65536,1,input_height=256,input_width=256,output_height=4,output_width=4,stride_y=85,stride_x=85)
    hand("channel_product_high_bits",2,131072,512,input_channels=512,input_height=256,output_height=4,stride_y=85)
    hand("d0_huge_both_strides",0,1,1,stride_y=0xffffffff,stride_x=0xffffffff)
    hand("d0_huge_y_stride",0,2,1,input_width=2,output_width=2,stride_y=0xffffffff)
    hand("d0_huge_x_stride",0,2,1,input_height=2,output_height=2,stride_x=0xffffffff)
    hand("d1_huge_y_stride_rollover",2,4294967297,2,input_height=0xffffffff,output_height=2,
        kernel_height=2,stride_y=0xffffffff,pad_top=1,pad_bottom=1)
    hand("d1_huge_x_stride_rollover",2,4294967297,2,input_width=0xffffffff,output_width=2,
        kernel_width=2,stride_x=0xffffffff,pad_left=1,pad_right=1)
    for axis in ("y","x"):
        dimension="height" if axis=="y" else "width"
        for stride,height,expected in ((51199,51200,0),(51200,51201,2),(65535,65536,2),(65536,65537,2),(65537,65538,2),(0x80000000,2147483649,2)):
            hand(f"{axis}_d1_stride_{stride}",expected,height,1,**{"input_"+dimension:height,"output_"+dimension:2,"stride_"+axis:stride})
        hand(axis+"_d7_height_19bit_overflow_guard",2,458746,1,**{"input_"+dimension:458746,"output_"+dimension:8,"stride_"+axis:65535})
    for field in ("input_channels","kernel_height","kernel_width"):
        hand(field+"_high13_alias",1,8193,8193,**{field:8193,"input_height":8193 if field=="kernel_height" else 1,"input_width":8193 if field=="kernel_width" else 1})
    v=dict(p65536,input_length_bytes=0)
    if add("patch_bad_length_before_bad_range",v)!=3:raise ValueError("长度优先手算失败")
    manual.append({"label":"bad_length_before_patch_bad_range","inputs":v,"expected_error":3,"patch_bytes":65536})
    # 固定种子集中覆盖前置参数正确而patch/长度接近容量的通用API输入。
    for j in range(1024):
        v=dict(layer0);c=rng.choice((1,2,3,8,64,512));kh=rng.choice((1,2,3));kw=rng.choice((1,2,3))
        oh=rng.randint(1,12);ow=rng.randint(1,12);sy=rng.choice((1,2,85,199,51199,51200,65535,65536,0xffffffff));sx=rng.choice((1,2,85,199,51199,51200,65535,65536,0xffffffff))
        ih=(oh-1)*sy+kh;iw=(ow-1)*sx+kw
        if ih>0xffffffff or iw>0xffffffff:oh=ow=1;ih=kh;iw=kw
        v.update(input_channels=c,kernel_height=kh,kernel_width=kw,input_height=ih,input_width=iw,output_height=oh,output_width=ow,
            stride_y=sy,stride_x=sx,input_length_bytes=(c*ih*iw)&0xffffffff,output_length_bytes=32*oh*ow,quantized_weight_bytes=32*c*kh*kw)
        add("patch_targeted_random",v)
    s5_vectors=len(rows)
    length_manual=[]
    def length_hand(label,expected,**changes):
        v=dict(layer0);v.update(input_channels=1,input_height=1,input_width=1,output_height=1,output_width=1,
            kernel_height=1,kernel_width=1);v.update(changes)
        v.update(input_length_bytes=(v["input_channels"]*v["input_height"]*v["input_width"])&0xffffffff,
            output_length_bytes=(v["output_channels"]*v["output_height"]*v["output_width"])&0xffffffff,
            quantized_weight_bytes=(v["output_channels"]*v["input_channels"]*v["kernel_height"]*v["kernel_width"])&0xffffffff)
        if add("length_manual_"+label,v)!=expected:raise ValueError("长度手算错误优先不符："+label)
        length_manual.append({"label":label,"inputs":v,"expected_error":expected,
            "input_product":v["input_channels"]*v["input_height"]*v["input_width"],
            "output_product":v["output_channels"]*v["output_height"]*v["output_width"],
            "reduction":v["input_channels"]*v["kernel_height"]*v["kernel_width"],
            "weight_product":v["output_channels"]*v["input_channels"]*v["kernel_height"]*v["kernel_width"]})
    length_hand("input_2pow32_minus1",1,input_height=65535,input_width=65537)
    length_hand("input_2pow32",3,input_height=65536,input_width=65536)
    length_hand("input_2pow32_plus1",3,input_height=641,input_width=6700417)
    length_hand("input_plane_high32_low0",3,input_channels=2,input_height=0x80000000)
    length_hand("input_3factor_above2pow64",3,input_channels=4608,input_height=0xffffffff,input_width=0xffffffff)
    length_hand("input_exact2pow64",3,input_channels=4,input_height=0x80000000,input_width=0x80000000)
    length_hand("output_2pow32_minus1_before_mq",2,output_channels=1,output_height=65535,output_width=65537)
    length_hand("output_2pow32",3,output_height=0x8000000)
    length_hand("output_plane_high32_low0",3,output_channels=2,output_height=0x80000000)
    length_hand("output_above2pow64",3,output_channels=0xffffffff,output_height=0xffffffff,output_width=0xffffffff)
    length_hand("weight_2pow32_minus1_before_mq",2,output_channels=0xffffffff)
    length_hand("weight_2pow32",3,output_channels=0x80000000,input_channels=2)
    length_hand("weight_2pow32_plus1",3,output_channels=6700417,input_channels=641)
    length_hand("weight_45bit_maxvalidR",3,output_channels=0xffffffff,input_channels=4608)
    length_hand("reduction_4608",0,input_channels=4608)
    length_hand("reduction_4609",1,input_channels=4609)
    length_hand("reduction_plane_8192_alias",1,input_channels=4096,kernel_height=2)
    length_hand("reduction_3factor_large",1,input_channels=0xffffffff,kernel_height=0xffffffff,kernel_width=0xffffffff)
    length_hand("weight_4factor_large",1,output_channels=0xffffffff,input_channels=0xffffffff,kernel_height=0xffffffff,kernel_width=0xffffffff)
    length_hand("zero_factor_before_large_length",1,input_channels=0,input_height=0xffffffff,input_width=0xffffffff)
    length_hand("layer_override_zero_and_length",2,layer_index=38,input_channels=0,input_height=0xffffffff)
    length_hand("layer_mismatch_override_reduction_and_length",2,weight_layer_index=1,input_channels=0xffffffff)
    length_hand("bad_length_before_range",3,input_height=65536,input_width=65536,input_base_address=0xffffffff)
    length_hand("shape_extreme_after_length",1,input_height=0xffffffff,pad_top=0xffffffff,pad_bottom=0xffffffff,stride_y=0xffffffff)
    # 新种子只用于S6后缀；原3924条刺激与原S4前缀保持逐字节不变。
    length_seed=0x2B171106;length_rng=random.Random(length_seed)
    edge=(0,1,2,3,7,8,4608,4609,8191,8192,8193,65535,65536,65537,0x7fffffff,0x80000000,0xfffffffe,0xffffffff)
    fields=("input_channels","input_height","input_width","output_channels","output_height","output_width","kernel_height","kernel_width")
    for j in range(2048):
        v=dict(layer0)
        for field in length_rng.sample(fields,length_rng.randint(2,8)):
            v[field]=length_rng.choice(edge) if j%2 else length_rng.getrandbits(32)
        if j%4==0:v["kernel_height"]=v["kernel_width"]=1;v["input_channels"]=length_rng.choice((1,2,4608))
        if j%4==0:v["output_channels"]=32
        v.update(input_length_bytes=(v["input_channels"]*v["input_height"]*v["input_width"])&0xffffffff,
            output_length_bytes=(v["output_channels"]*v["output_height"]*v["output_width"])&0xffffffff,
            quantized_weight_bytes=(v["output_channels"]*v["input_channels"]*v["kernel_height"]*v["kernel_width"])&0xffffffff)
        if j%8==0:v["weight_layer_index"]=1
        if j%16==0:v["layer_index"]=0xffffffff
        if j%3==0:v["input_base_address"]=v["output_base_address"]=0xffffffff
        add("length_targeted_random",v)
    text="\n".join(" ".join(f"{v[n]&0xffffffff:x}" for n in names+["buffer_owner_pl"])+f" {e:x}" for v,e in rows)+"\n"
    return names,text,layer0,{"vectors":len(rows),"categories":categories,"seed":0x2B171004,"frozen_conv_layers":frozen,
      "s4_baseline_vectors":baseline_vectors,"s5_baseline_vectors":s5_vectors,"manual_patch_cases":manual,
      "length_seed":length_seed,"manual_length_cases":length_manual,
      "independent_math":"黄金仍采用原完整Python整数H×W×C、min(OC,8)×R与原分支顺序，不采用窄判据；形状64bit减法/加法显式取模。"}

def pair(header,instance="u_dut",frozen=False):
    """公开端口同刺激双实例；比较全部输出，包括无效周期保留值。"""
    ports_here=ports(); outputs=[(w,n) for d,w,n in ports_here if d=="output"]
    declarations="\n".join(f"logic {w} candidate_{n};" for w,n in outputs)
    connections=re.sub(r"\.(\w+)\((\w+)\)",lambda m:f".{m[1]}(candidate_{m[2]})" if m[1] in [n for w,n in outputs] else m[0],header)
    candidate="s2b_conv_tile_engine"+(" #(.FROZEN_CONV_DESCRIPTOR(1'b1))" if frozen else "")+" u_candidate"
    connections=connections.replace("s2a_conv_tile_engine "+instance,candidate)
    compare=" || ".join(f"({n} !== candidate_{n})" for w,n in outputs)
    return declarations+"\n"+connections+f"\ninteger compare_cycles=0; always @(negedge clk) begin if ({compare}) $fatal(1,\"CONV公开输出逐周期不同 cycle=%0d\",compare_cycles); compare_cycles++; end\n"

def boundary_tb(names,small):
    """所有合法状态均从公开START实际到达；只读状态定位abort/reset，不强制状态。"""
    ports_here=ports();decl="\n".join(f"logic {w} {n}=0;" for d,w,n in ports_here if n!="clk")
    conn="s2a_conv_tile_engine u_dut ("+",".join(f".{n}({n})" for d,w,n in ports_here)+");"
    defaults=" ".join(f"{n}=32'h{small[n]&0xffffffff:x};" for n in names)+" buffer_owner_pl=1;"
    fmt=" ".join("%h" for _ in range(len(names)+2))+"\\n"
    args=",".join(names+["buffer_owner_pl","expected_error"])
    return f"""`timescale 1ns/1ps
module tb_s2b_conv_validation;
logic clk=0; {decl}
{conn}
{pair(conn)}
integer cycles=0,cases=0,pending=0,delay_count=0,requests=0,error_code=0,error_request=0,raw_invalid=0;
integer abort_mask=0,reset_mask=0,fd,scanned,expected_error,timeout_count;
always #5 clk=~clk;
task automatic tick; begin @(posedge clk); #1; cycles++; @(negedge clk); #1; end endtask
task automatic reset_dut; begin hard_reset=1; abort=0; start_valid=0; result_ready=0; backend_rsp_valid=0; backend_req_ready=0; pending=0; tick; hard_reset=0; tick; end endtask
task automatic defaults; begin {defaults} end endtask
task automatic start_dut; begin start_valid=1; tick; start_valid=0; end endtask
task automatic service;
logic accepted,responded;
begin
 backend_req_ready=(cycles%5)!=0; backend_rsp_valid=pending!=0 && delay_count==0;
 backend_rsp_rdata=raw_invalid!=0?32'h80808080:0; backend_rsp_error=(requests==error_request)?3'(error_code):0;
 #1; accepted=backend_req_valid && backend_req_ready; responded=backend_rsp_valid;
 tick;
 if(responded)pending=0; else if(pending!=0 && delay_count>0)delay_count--;
 if(accepted)begin if(pending!=0)$fatal(1,"重复请求"); requests++;pending=1;delay_count=cycles%4;end
end endtask
initial begin
 reset_dut;
 fd=$fopen("validation_vectors.txt","r"); if(fd==0)$fatal(1,"向量文件缺失");
 while(!$feof(fd))begin
  scanned=$fscanf(fd,"{fmt}",{args});
  if(scanned!={len(names)+2})begin if(!$feof(fd))$fatal(1,"向量读取失败");break;end
  start_dut; tick;
  if(expected_error==0)begin if(result_valid)$fatal(1,"合法层校验被拒绝 case=%0d",cases); abort=1;tick;abort=0;end
  else begin if(!result_valid || result_error_code!=expected_error)$fatal(1,"独立校验黄金不同 case=%0d want=%0d got=%0d",cases,expected_error,result_error_code); result_ready=1;tick;result_ready=0;end
  cases++;reset_dut;
 end
 $fclose(fd);
 for(integer action=0;action<2;action++)begin
  for(integer state_id=0;state_id<20;state_id++)begin
   reset_dut;defaults;requests=0;error_code=0;error_request=0;if(state_id!=0)start_dut;timeout_count=0;
   while(int'(u_dut.state)!=state_id && timeout_count<20000)begin service;timeout_count++;end
   if(timeout_count==20000)$fatal(1,"状态不可达state=%0d",state_id);
   if(action==0)begin abort=1;abort_mask|=1<<state_id;end else begin hard_reset=1;reset_mask|=1<<state_id;end
   service; abort=0;hard_reset=0;pending=0;backend_rsp_valid=0;tick;
   if(busy || result_valid || !start_ready)$fatal(1,"复位abort未回IDLE");
  end
 end
 for(integer code=0;code<8;code++)begin
  for(integer request_target=1;request_target<=3;request_target++)begin
   reset_dut;defaults;requests=0;error_code=code;error_request=(request_target==1?1:request_target==2?49:265);start_dut;
   timeout_count=0;while(!result_valid && timeout_count<20000)begin
    // owner低不取消已接受合法任务；输入batch改变不能改变锁存状态。
    if(timeout_count>2)begin buffer_owner_pl=0;input_batch_count=32'hffffffff;output_batch_count=0;end
    service;timeout_count++;
   end
   if(!result_valid)$fatal(1,"响应错误或成功超时code=%0d target=%0d",code,request_target);
   expected_error=(code==0?0:code==1?1:code==2?2:6);
   if(result_error_code!=expected_error)$fatal(1,"响应映射不同code=%0d target=%0d got=%0d",code,request_target,result_error_code);
   repeat(7)service;result_ready=1;service;result_ready=0;
  end
 end
 reset_dut;defaults;requests=0;error_code=0;error_request=0;raw_invalid=1;start_dut;timeout_count=0;
 while(!result_valid && timeout_count<20000)begin service;timeout_count++;end
 if(!result_valid || result_error_code!=1)$fatal(1,"raw80拒绝语义不同");
 $display("PASS CONV_VALIDATION vectors=%0d cycles=%0d abort_mask=%x reset_mask=%x response_cases=24 raw80=1",cases,cycles,abort_mask,reset_mask);
 $finish;
end
endmodule
"""

def layer0_tb():
    """复用冻结T66公开黑盒；候选启用平台私有域，原参考保留通用域。"""
    text=(ROOT/"sim/tb_s2a_t66_candidate_blackbox.sv").read_text(encoding="utf-8")
    m=re.search(r"    s2a_conv_tile_engine u_dut \(.*?\n    \);",text,re.S)
    if not m:raise ValueError("T66唯一实例缺失")
    return text.replace(m[0],m[0]+"\n"+pair(m[0],frozen=True)).replace("tb_s2a_t66_candidate_blackbox","tb_s2b_conv_layer0")

def main():
    """独占新Run，冻结全部实际源码后单job构建；失败原件保留。"""
    parser=argparse.ArgumentParser();parser.add_argument("--run-id",required=True);parser.add_argument("--mode",choices=("boundary","layer0"),required=True)
    parser.add_argument("--toolchain",type=Path,default=Path("D:/FPGA_S2A_MSYS2_20261001/env"));parser.add_argument("--prepare-only",action="store_true");args=parser.parse_args()
    if not re.fullmatch(r"(?:length_guard_20261011_r\d+|conv_(?:output|feature)_address_(?:boundary|layer0)_20261011_r\d+|s12_conv_(?:boundary|layer0)_20261012_r\d+)",args.run_id):raise ValueError("RunId不符")
    work=ROOT/"tmp/2B/S2B-T17"/args.run_id;evidence=ROOT/"report/evidence/S2B-T17"/args.run_id
    for p in (work,evidence):
        if not p.parent.is_dir() or p.exists():raise ValueError("父目录缺失或Run已存在")
        p.mkdir()
    report={"schema_version":1,"task_id":"S2B-T17-S12","run_id":args.run_id,"mode":args.mode,"source_baseline_commit":SOURCE_BASELINE,"candidate_frozen_conv_descriptor":int(args.mode=="layer0"),"reference_frozen_conv_descriptor":0,"status":"FAIL","runs":[]}
    begin=time.monotonic()
    try:
        checker=support.load_checker();bindings=checker.check_static(ROOT)
        bindings.update({p:support.sha(ROOT/p) for p in (RUNNER,"verification/test_s2b_backend_coordinates_rtl.py","verification/test_s2b_geometry_specialization_rtl.py","verification/test_s2b_route_specialization_rtl.py","sim/tb_s2a_t66_candidate_blackbox.sv","verification/s1_t02_d2_int8_forward.py",support.MODEL)})
        report["source_sha256_pre"]=bindings;report["frozen14_sha256"]={p:support.sha(ROOT/p) for p in checker.FROZEN_CORE_SHA256}
        snapshot=evidence/"source_snapshot";snapshot.mkdir()
        for p in bindings:
            target=snapshot/p;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(ROOT/p,target)
        actual=subprocess.check_output(["git","-c","core.longpaths=true","-c","maintenance.auto=false","rev-parse","HEAD"],cwd=ROOT,text=True).strip();report["source_commit"]=actual
        report["legacy_ff_baseline"]=BASELINE
        report["source_baseline"]=SOURCE_BASELINE
        if subprocess.check_output(["git","-c","core.longpaths=true","-c","maintenance.auto=false","diff","--name-only",SOURCE_BASELINE,actual,"--",*bindings],cwd=ROOT,text=True).strip():raise ValueError("相关已提交源码偏离基线")
        report["checker_negatives"]=support.checker_negatives(checker,work,checker.check_static(ROOT))
        if support.sha(ROOT/support.MODEL)!=support.MODEL_SHA:raise ValueError("冻结manifest SHA漂移")
        # D2原件为CRLF；冻结Git blob为LF，只有关系核验规范换行，仍另绑实际rawSHA。
        d2raw=(ROOT/"verification/s1_t02_d2_int8_forward.py").read_bytes()
        if hashlib.sha256(d2raw.replace(b"\r\n",b"\n")).hexdigest()!="5dfdbb4a9e57256b362629a2de40b9724df6d28ae225ce6d6622429b9cbad393":raise ValueError("D2规范源内容漂移")
        model=json.loads((ROOT/support.MODEL).read_text(encoding="utf-8")); names,text,small,math_report=vectors(model)
        report["length_proof"]=length_proof(text,math_report,checker)
        report["math_oracle"]=math_report
        (evidence/"math_oracle.json").write_text(json.dumps(math_report,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
        for directory in (work,evidence):(directory/"validation_vectors.txt").write_text(text,encoding="utf-8")
        report["resource_preflight"]={"available_ram_bytes":psutil.virtual_memory().available,"disk_free_bytes":shutil.disk_usage(work).free,
          "running_tools":[{"pid":p.pid,"name":p.info["name"],"rss":p.memory_info().rss} for p in psutil.process_iter(["name"]) if p.info["name"] and p.info["name"].lower() in ("vivado.exe","verilator_bin.exe","cc1plus.exe","vtb_s2b_conv_layer0.exe","vtb_s2b_conv_validation.exe")],"rss_limit_bytes":1073741824,"cache_limit_bytes":671088640,"heavy_slot":"仅收到ROOT本次唯一槽准入后执行；job1/thread1"}
        if report["resource_preflight"]["available_ram_bytes"]<2147483648:raise ValueError("可用内存不足")
        source=work/"source";source.mkdir()
        for p in RTL:shutil.copyfile(ROOT/p,source/Path(p).name)
        top="tb_s2b_conv_validation" if args.mode=="boundary" else "tb_s2b_conv_layer0"
        bench=boundary_tb(names,small) if args.mode=="boundary" else layer0_tb()
        for directory in (work,evidence):(directory/(top+".sv")).write_text(bench,encoding="utf-8",newline="\n")
        if args.mode=="layer0":
            report["fixture_bindings"]=[]
            for name,(size,digest) in FIXED.items():
                path=checker.exact_file(FIXTURE/name)
                if path.stat().st_size!=size or support.sha(path)!=digest:raise ValueError("冻结T25夹具漂移")
                report["fixture_bindings"].append({"path":str(path),"bytes":size,"sha256":digest})
            report["independent_cpu_layer0"]=cpu_layer0(model,evidence,checker)
        env=os.environ.copy();tools=args.toolchain/"mingw64/bin";make=args.toolchain/"usr/bin";verilator=checker.exact_file(tools/"verilator_bin.exe")
        env["PATH"]=str(make)+os.pathsep+str(tools)+os.pathsep+env.get("PATH","");env["VERILATOR_ROOT"]=str(args.toolchain/"mingw64/share/verilator");env["PYTHONUTF8"]="1"
        report["tool_versions"]={"python":sys.version,"verilator":subprocess.check_output([str(verilator),"--version"],cwd=work,env=env,text=True).strip()}
        cmd=[str(verilator),"--binary","--timing","--timescale","1ns/1ps","-Wall","-Wno-fatal","-j","1","--threads","1","--output-split","10000","--output-split-cfuncs","100","--top-module",top,"--Mdir","obj_dir","-MAKEFLAGS","PYTHON3='\""+sys.executable+"\"'","-CFLAGS","-D_GLIBCXX_USE_CXX11_ABI=0 -O1",*["source/"+Path(p).name for p in RTL],top+".sv"]
        report["compile_command"]=cmd
        if args.prepare_only:report["status"]="PREPARED_NOT_RUN"
        else:
            support.execute("compile",cmd,work,evidence,env,report,900)
            sim=[str(work/("obj_dir/V"+top+".exe"))]
            if args.mode=="layer0":sim += ["+T66_"+kind+"_PATH="+str(FIXTURE/name).replace("\\","/") for kind,name in zip(("INPUT","WEIGHT","GOLDEN"),FIXED)]
            support.execute("simulation",sim,work,evidence,env,report,1200)
            log=(evidence/"simulation.log").read_text(encoding="utf-8")
            marker="PASS CONV_VALIDATION" if args.mode=="boundary" else "PASS: T66 candidate blackbox sample0 layer0 full tensor matched T25; bytes=1384448 mismatches=0"
            if log.count(marker)!=1:raise ValueError("唯一通过标记缺失")
            if args.mode=="boundary":
                m=re.search(r"PASS CONV_VALIDATION vectors=(\d+) cycles=(\d+) abort_mask=([a-fA-F0-9]+) reset_mask=([a-fA-F0-9]+) response_cases=24 raw80=1",log)
                if not m or int(m[1])!=math_report["vectors"] or int(m[3],16)!=0xfffff or int(m[4],16)!=0xfffff:raise ValueError("实际边界覆盖不完整")
                report["actual_coverage"]={"vectors":int(m[1]),"cycles":int(m[2]),"abort_mask":m[3],"reset_mask":m[4],"response_cases":24,"raw80":1}
            else:
                m=re.search(r"bytes=(\d+) mismatches=0 input_reads=(\d+) weight_reads=(\d+) output_writes=(\d+) requests=(\d+) responses=(\d+) request_stalls=(\d+) response_stalls=(\d+) cycles=(\d+)",log)
                if not m or tuple(map(int,(m[1],m[4],m[5],m[6])))!=(1384448,1384448,2551955,2551955):raise ValueError("完整layer0实际请求/输出覆盖不符")
                report["actual_coverage"]=dict(zip(("bytes","input_reads","weight_reads","output_writes","requests","responses","request_stalls","response_stalls","cycles"),map(int,m.groups())))
            report["pass_marker"]=marker;report["status"]="PASS"
        report["source_sha256_post"]={p:support.sha(ROOT/p) for p in bindings}
        if report["source_sha256_post"]!=bindings:raise ValueError("验证期间源码改变")
    except Exception as exc:report["status"]="FAIL";report["error"]=repr(exc)
    finally:
        report["elapsed_seconds"]=round(time.monotonic()-begin,3);report["thread_environment"]=CPU_THREAD_ENV;report["runner_peak_self_working_set_bytes"]=getattr(psutil.Process().memory_info(),"peak_wset",None)
        report["limitations"]=["G2、综合/STA、postroute、bit、G3未执行；物理接口未冻结。","仅本模式覆盖；不声明109整网或CSR/runtime deadline实板联调。","状态仅只读定位abort/reset；黄金独立于派生乘积。"]
        (evidence/"validation.json").write_text(json.dumps(report,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    print(json.dumps({"status":report["status"],"evidence":str(evidence),"seconds":report["elapsed_seconds"],"error":report.get("error")},ensure_ascii=False))
    return 0 if report["status"] in ("PASS","PREPARED_NOT_RUN") else 2

if __name__=="__main__":raise SystemExit(main())

