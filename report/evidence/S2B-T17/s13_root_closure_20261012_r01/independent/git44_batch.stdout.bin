722bb21476c6f7734c4c61d42ffc5b0b14ce1370 blob 10982
// 阶段 2A：计算单个 INT8 最大池化输出窗口的几何和 NCHW 字节地址。
module int8_maxpool_geometry (
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_channels,
    input  logic [31:0] input_height,
    input  logic [31:0] input_width,
    input  logic [31:0] kernel_height,
    input  logic [31:0] kernel_width,
    input  logic [31:0] stride_y,
    input  logic [31:0] stride_x,
    input  logic [31:0] darknet_padding_parameter,
    input  logic [31:0] input_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,
    output logic [32:0] output_height,
    output logic [32:0] output_width,
    output logic [3:0] tap_count,
    output logic [8:0] tap_valid_mask,
    output logic [31:0] tap_address [0:8],
    output logic [31:0] tap_source_channel [0:8],
    output logic signed [63:0] tap_source_y [0:8],
    output logic signed [63:0] tap_source_x [0:8],
    // 成功为 0；参数/坐标非法为 BAD_ARGUMENT(1)，uint32 地址越界为 BAD_RANGE(2)。
    output logic [2:0] error_code
);
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;

    logic [32:0] extent_y;
    logic [32:0] extent_x;
    logic [32:0] output_height_work;
    logic [32:0] output_width_work;
    logic signed [63:0] origin_y;
    logic signed [63:0] origin_x;
    logic [32:0] output_y_step;
    logic [32:0] output_x_step;
    logic signed [63:0] source_y_work;
    logic signed [63:0] source_x_work;
    logic [63:0] channel_row_work;
    logic signed [63:0] row_y_work [0:2];
    logic [63:0] row_index_work [0:2];
    logic [95:0] row_offset_work [0:2];
    logic [95:0] logical_offset_work;
    logic [96:0] address_work;
    integer tap_index;
    integer row_index;
    integer kernel_y_work;
    integer kernel_x_work;
    logic tap_range_error;

    always_comb begin
        extent_y = {1'b0, input_height} + {1'b0, darknet_padding_parameter};
        extent_x = {1'b0, input_width} + {1'b0, darknet_padding_parameter};
        output_height_work = 33'd0;
        output_width_work = 33'd0;
        output_y_step = 33'd0;
        output_x_step = 33'd0;
        source_y_work = 64'sd0;
        source_x_work = 64'sd0;
        channel_row_work = 64'd0;
        logical_offset_work = 96'd0;
        address_work = 97'd0;
        kernel_y_work = 0;
        kernel_x_work = 0;
        tap_range_error = 1'b0;

        output_height = 33'd0;
        output_width = 33'd0;
        tap_count = 4'd0;
        tap_valid_mask = 9'd0;
        error_code = 3'd0;
        origin_y = 64'sd0;
        origin_x = 64'sd0;
        for (row_index = 0; row_index < 3; row_index = row_index + 1) begin
            row_y_work[row_index] = 64'sd0;
            row_index_work[row_index] = 64'd0;
            row_offset_work[row_index] = 96'd0;
        end
        for (tap_index = 0; tap_index < 9; tap_index = tap_index + 1) begin
            tap_address[tap_index] = 32'd0;
            tap_source_channel[tap_index] = 32'd0;
            tap_source_y[tap_index] = 64'sd0;
            tap_source_x[tap_index] = 64'sd0;
        end

        if (!(((kernel_height == 32'd2) && (kernel_width == 32'd2)) ||
              ((kernel_height == 32'd3) && (kernel_width == 32'd3))) ||
            (stride_y == 32'd0) || (stride_x == 32'd0) ||
            (input_channels == 32'd0) || (input_height == 32'd0) ||
            (input_width == 32'd0)) begin
            error_code = BAD_ARGUMENT;
        end else if ((extent_y < {1'b0, kernel_height}) ||
                     (extent_x < {1'b0, kernel_width})) begin
            error_code = BAD_ARGUMENT;
        end else begin
            if (stride_y == 32'd2) begin
                output_height_work =
                    ((extent_y - {1'b0, kernel_height}) >> 1) + 33'd1;
            end else begin
                output_height_work =
                    ((extent_y - {1'b0, kernel_height}) / {1'b0, stride_y}) + 33'd1;
            end
            if (stride_x == 32'd2) begin
                output_width_work =
                    ((extent_x - {1'b0, kernel_width}) >> 1) + 33'd1;
            end else begin
                output_width_work =
                    ((extent_x - {1'b0, kernel_width}) / {1'b0, stride_x}) + 33'd1;
            end
            output_height = output_height_work;
            output_width = output_width_work;

            if ((input_channel >= input_channels) ||
                ({1'b0, output_y} >= output_height_work) ||
                ({1'b0, output_x} >= output_width_work)) begin
                error_code = BAD_ARGUMENT;
            end else begin
                tap_count = (kernel_height == 32'd2) ? 4'd4 : 4'd9;
                origin_y = -$signed({32'd0, darknet_padding_parameter[31:1]});
                origin_x = -$signed({32'd0, darknet_padding_parameter[31:1]});
                // 坐标合法时，坐标乘步长不大于 extent-kernel，33 位足够。
                if (stride_y == 32'd2) begin
                    output_y_step = {1'b0, output_y} << 1;
                end else begin
                    output_y_step = {1'b0, output_y} * {1'b0, stride_y};
                end
                if (stride_x == 32'd2) begin
                    output_x_step = {1'b0, output_x} << 1;
                end else begin
                    output_x_step = {1'b0, output_x} * {1'b0, stride_x};
                end
                source_y_work = origin_y + $signed({31'd0, output_y_step});
                source_x_work = origin_x + $signed({31'd0, output_x_step});
                // 合法通道和行坐标保证 channel*height+source_y 小于 2^64。
                channel_row_work = {32'd0, input_channel} * {32'd0, input_height};
                // 各行独立预计算，避免 tap 的行内地址重复执行宽乘法。
                for (row_index = 0; row_index < 3; row_index = row_index + 1) begin
                    row_y_work[row_index] = source_y_work + row_index;
                    if ((row_y_work[row_index] >= 64'sd0) &&
                        (row_y_work[row_index] < $signed({32'd0, input_height}))) begin
                        row_index_work[row_index] = channel_row_work +
                            {32'd0, row_y_work[row_index][31:0]};
                        row_offset_work[row_index] =
                            {32'd0, row_index_work[row_index]} * {64'd0, input_width};
                    end
                end

                for (tap_index = 0; tap_index < 9; tap_index = tap_index + 1) begin
                    if (tap_index < tap_count) begin
                        if (kernel_width == 32'd2) begin
                            case (tap_index)
                                0: begin kernel_y_work = 0; kernel_x_work = 0; end
                                1: begin kernel_y_work = 0; kernel_x_work = 1; end
                                2: begin kernel_y_work = 1; kernel_x_work = 0; end
                                3: begin kernel_y_work = 1; kernel_x_work = 1; end
                                default: begin kernel_y_work = 0; kernel_x_work = 0; end
                            endcase
                        end else begin
                            case (tap_index)
                                0: begin kernel_y_work = 0; kernel_x_work = 0; end
                                1: begin kernel_y_work = 0; kernel_x_work = 1; end
                                2: begin kernel_y_work = 0; kernel_x_work = 2; end
                                3: begin kernel_y_work = 1; kernel_x_work = 0; end
                                4: begin kernel_y_work = 1; kernel_x_work = 1; end
                                5: begin kernel_y_work = 1; kernel_x_work = 2; end
                                6: begin kernel_y_work = 2; kernel_x_work = 0; end
                                7: begin kernel_y_work = 2; kernel_x_work = 1; end
                                8: begin kernel_y_work = 2; kernel_x_work = 2; end
                                default: begin kernel_y_work = 0; kernel_x_work = 0; end
                            endcase
                        end
                        tap_source_channel[tap_index] = input_channel;
                        tap_source_y[tap_index] = source_y_work + kernel_y_work;
                        tap_source_x[tap_index] = source_x_work + kernel_x_work;

                        if ((tap_source_y[tap_index] >= 64'sd0) &&
                            (tap_source_y[tap_index] < $signed({32'd0, input_height})) &&
                            (tap_source_x[tap_index] >= 64'sd0) &&
                            (tap_source_x[tap_index] < $signed({32'd0, input_width}))) begin
                            tap_valid_mask[tap_index] = 1'b1;
                            case (kernel_y_work)
                                0: logical_offset_work = row_offset_work[0] +
                                    {64'd0, tap_source_x[tap_index][31:0]};
                                1: logical_offset_work = row_offset_work[1] +
                                    {64'd0, tap_source_x[tap_index][31:0]};
                                2: logical_offset_work = row_offset_work[2] +
                                    {64'd0, tap_source_x[tap_index][31:0]};
                                default: logical_offset_work = 96'd0;
                            endcase
                            address_work = {65'd0, input_base_address} +
                                {1'b0, logical_offset_work};
                            if (address_work[96:32] != 65'd0) begin
                                tap_range_error = 1'b1;
                            end else begin
                                tap_address[tap_index] = address_work[31:0];
                            end
                        end
                    end
                end

                if (tap_range_error) begin
                    error_code = BAD_RANGE;
                    output_height = 33'd0;
                    output_width = 33'd0;
                    tap_count = 4'd0;
                    tap_valid_mask = 9'd0;
                    for (tap_index = 0; tap_index < 9; tap_index = tap_index + 1) begin
                        tap_address[tap_index] = 32'd0;
                        tap_source_channel[tap_index] = 32'd0;
                        tap_source_y[tap_index] = 64'sd0;
                        tap_source_x[tap_index] = 64'sd0;
                    end
                end
            end
        end

        if (error_code == BAD_ARGUMENT) begin
            output_height = 33'd0;
            output_width = 33'd0;
            tap_count = 4'd0;
            tap_valid_mask = 9'd0;
            for (tap_index = 0; tap_index < 9; tap_index = tap_index + 1) begin
                tap_address[tap_index] = 32'd0;
                tap_source_channel[tap_index] = 32'd0;
                tap_source_y[tap_index] = 64'sd0;
                tap_source_x[tap_index] = 64'sd0;
            end
        end
    end
endmodule

426c440fc0a8278a6d631c60ee4a6005eb29be9e blob 1692
// 阶段 2A：对一个 INT8 最大池化窗口做有符号最大值归约。
module int8_maxpool_window (
    // 仅接受 4 个真实 2x2 模型 tap 或 9 个通用 3x3 tap。
    input  logic [3:0]  candidate_count,
    // tap 0 放在最低字节；其余 tap 按 kernel_y、kernel_x 顺序递增。
    input  logic [71:0] candidates,
    output logic signed [7:0] max_value,
    // 成功为 0；非法 tap 数量或已选 tap 为 -128 时返回 BAD_ARGUMENT(1)。
    output logic [2:0]  error_code
);
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    integer tap_index;
    logic signed [7:0] candidate_value;
    logic signed [7:0] current_maximum;

    always_comb begin
        max_value = 8'sd0;
        error_code = 3'd0;
        current_maximum = 8'sh80;
        candidate_value = 8'sd0;

        case (candidate_count)
            4'd4, 4'd9: begin
                for (tap_index = 0; tap_index < 9; tap_index = tap_index + 1) begin
                    if (tap_index < candidate_count) begin
                        candidate_value = $signed(candidates[tap_index * 8 +: 8]);
                        if (candidate_value == 8'sh80) begin
                            error_code = BAD_ARGUMENT;
                        end
                        if (candidate_value > current_maximum) begin
                            current_maximum = candidate_value;
                        end
                    end
                end
                if (error_code == 3'd0) begin
                    max_value = current_maximum;
                end
            end
            default: begin
                error_code = BAD_ARGUMENT;
            end
        endcase
    end
endmodule

45e9557c97e134e072e01dff580109f2a370257b blob 13672
// G0 tiny416 route 单输出元素：group 通道映射、NCHW 地址与 scale 重标定。
module s2b_route_query #(
    // 仅冻结network实例启用；默认保持原任意U32组合查询。
    parameter bit FROZEN_ROUTE_SHAPES = 1'b0
) (
    input  logic [31:0] source_count,
    input  logic [31:0] groups,
    input  logic [31:0] group_id,
    input  logic [31:0] output_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,

    input  logic [31:0] source0_base_address,
    input  logic [31:0] source0_length_bytes,
    input  logic [31:0] source0_channels,
    input  logic [31:0] source0_height,
    input  logic [31:0] source0_width,
    input  logic [31:0] source0_channel_start,
    input  logic [31:0] source0_channel_end,
    input  logic [31:0] source0_multiplier_q31,
    input  logic signed [7:0] source0_value,

    input  logic [31:0] source1_base_address,
    input  logic [31:0] source1_length_bytes,
    input  logic [31:0] source1_channels,
    input  logic [31:0] source1_height,
    input  logic [31:0] source1_width,
    input  logic [31:0] source1_channel_start,
    input  logic [31:0] source1_channel_end,
    input  logic [31:0] source1_multiplier_q31,
    input  logic signed [7:0] source1_value,

    output logic [31:0] output_channels,
    output logic [31:0] output_height,
    output logic [31:0] output_width,
    output logic [31:0] source_index,
    output logic [31:0] source_channel,
    output logic [31:0] source_address,
    output logic signed [7:0] output_value,
    output logic [2:0] error_code
);
    localparam logic [2:0] OK = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;

    logic bad_argument;
    logic bad_range;
    logic [63:0] source0_shape_bytes;
    logic [63:0] source1_shape_bytes;
    logic [63:0] source0_plane_elements;
    logic [63:0] source1_plane_elements;
    logic [63:0] source0_object_end;
    logic [63:0] source1_object_end;
    logic [63:0] output_channels_wide;
    logic [63:0] expected_group_start;
    logic [63:0] expected_group_end;
    logic [31:0] selected_offset;
    logic [31:0] selected_address;
    logic [31:0] source0_selected_count;
    logic [31:0] source1_selected_count;
    logic [31:0] selected_multiplier;
    logic [31:0] selected_base_address;
    logic signed [7:0] selected_value;
    // 成功路径已排除 -128 并限制倍率，绝对值为 7 位，乘积可精确落在 39 位。
    logic [6:0] selected_magnitude;
    logic [38:0] scaled_product;
    logic [39:0] rounded_product;
    logic [8:0] rounded_magnitude;
    logic signed [8:0] scaled_signed;
    logic [31:0] selected_source_index;
    logic [31:0] selected_source_channel;

    // 完整96位tuple匹配，避免低位别名；固定值分别为C乘H与C乘H乘W。
    function automatic logic [128:0] frozen_shape_lookup(input logic [95:0] shape_key);
        begin
            frozen_shape_lookup = 129'd0;
            case (shape_key)
                96'h000000200000006800000068: frozen_shape_lookup = {1'b1, 64'd3328, 64'd346112};
                96'h000000400000003400000034: frozen_shape_lookup = {1'b1, 64'd3328, 64'd173056};
                96'h000000400000006800000068: frozen_shape_lookup = {1'b1, 64'd6656, 64'd692224};
                96'h000000800000001A0000001A: frozen_shape_lookup = {1'b1, 64'd3328, 64'd86528};
                96'h000000800000003400000034: frozen_shape_lookup = {1'b1, 64'd6656, 64'd346112};
                96'h000001000000000D0000000D: frozen_shape_lookup = {1'b1, 64'd3328, 64'd43264};
                96'h000001000000001A0000001A: frozen_shape_lookup = {1'b1, 64'd6656, 64'd173056};
                default: frozen_shape_lookup = 129'd0;
            endcase
        end
    endfunction

    logic [128:0] source0_frozen_shape;
    logic [128:0] source1_frozen_shape;

    always_comb begin
        // 组合默认值保证非法输入无副作用，也避免推断锁存器。
        output_channels = 32'd0;
        output_height = 32'd0;
        output_width = 32'd0;
        source_index = 32'd0;
        source_channel = 32'd0;
        source_address = 32'd0;
        output_value = 8'sd0;
        error_code = OK;

        bad_argument = 1'b0;
        bad_range = 1'b0;
        source0_frozen_shape = 129'd0;
        source1_frozen_shape = 129'd0;
        source0_shape_bytes = 64'd0;
        source1_shape_bytes = 64'd0;
        source0_plane_elements = 64'd0;
        source1_plane_elements = 64'd0;
        source0_object_end = 64'd0;
        source1_object_end = 64'd0;
        output_channels_wide = 64'd0;
        expected_group_start = 64'd0;
        expected_group_end = 64'd0;
        selected_offset = 32'd0;
        selected_address = 32'd0;
        source0_selected_count = 32'd0;
        source1_selected_count = 32'd0;
        selected_multiplier = 32'd0;
        selected_base_address = 32'd0;
        selected_value = 8'sd0;
        selected_magnitude = 7'd0;
        scaled_product = 39'd0;
        rounded_product = 40'd0;
        rounded_magnitude = 9'd0;
        scaled_signed = 9'sd0;
        selected_source_index = 32'd0;
        selected_source_channel = 32'd0;

        if (!((source_count == 32'd1) || (source_count == 32'd2)) ||
            (groups == 32'd0) || (group_id >= groups) ||
            (source0_channels == 32'd0) || (source0_height == 32'd0) ||
            (source0_width == 32'd0) ||
            (source0_channel_start >= source0_channel_end) ||
            (source0_channel_end > source0_channels) ||
            (source0_multiplier_q31 == 32'd0) ||
            (source0_multiplier_q31 > 32'h8000_0000)) begin
            bad_argument = 1'b1;
        end

        if (source_count == 32'd2) begin
            if ((source1_channels == 32'd0) ||
                (source1_height == 32'd0) || (source1_width == 32'd0) ||
                (source1_height != source0_height) ||
                (source1_width != source0_width) ||
                (source1_channel_start >= source1_channel_end) ||
                (source1_channel_end > source1_channels) ||
                (source1_multiplier_q31 == 32'd0) ||
                (source1_multiplier_q31 > 32'h8000_0000)) begin
                bad_argument = 1'b1;
            end
        end

        if ((groups == 32'd1) &&
            ((source0_channel_start != 32'd0) ||
             (source0_channel_end != source0_channels))) begin
            bad_argument = 1'b1;
        end else if (groups == 32'd2) begin
            if ((source_count != 32'd1) || source0_channels[0]) begin
                bad_argument = 1'b1;
            end else begin
                expected_group_start = (group_id == 32'd1) ?
                    {32'd0, source0_channels[31:1]} : 64'd0;
                expected_group_end = expected_group_start +
                                     {33'd0, source0_channels[31:1]};
                if ((source0_channel_start != expected_group_start[31:0]) ||
                    (source0_channel_end != expected_group_end[31:0])) begin
                    bad_argument = 1'b1;
                end
            end
        end else if (groups > 32'd2) begin
            // 冻结tiny416的ROUTE只会产生1或2；通用多组语义保留在2A原件。
            bad_argument = 1'b1;
        end
        if ((source_count == 32'd2) &&
            ((source1_channel_start != 32'd0) ||
             (source1_channel_end != source1_channels) ||
             (groups != 32'd1))) begin
            bad_argument = 1'b1;
        end

        source0_selected_count = source0_channel_end - source0_channel_start;
        if (source_count == 32'd2) begin
            source1_selected_count = source1_channel_end - source1_channel_start;
        end
        output_channels_wide = {32'd0, source0_selected_count} +
                               {32'd0, source1_selected_count};
        if (output_channels_wide > 64'h0000_0000_FFFF_FFFF) begin
            bad_range = 1'b1;
        end
        if ((output_y >= source0_height) || (output_x >= source0_width) ||
            ({32'd0, output_channel} >= output_channels_wide)) begin
            bad_argument = 1'b1;
        end

        if (FROZEN_ROUTE_SHAPES) begin
            source0_frozen_shape = frozen_shape_lookup({source0_channels, source0_height, source0_width});
            source0_plane_elements = source0_frozen_shape[127:64];
            source0_shape_bytes = source0_frozen_shape[63:0];
            if (!source0_frozen_shape[128]) begin
                // 私有非冻结tuple拒绝；公开backend可达性由独立G0/G1证明。
                bad_argument = 1'b1;
            end
        end else begin
            source0_plane_elements = {32'd0, source0_channels} *
                                     {32'd0, source0_height};
            if (source0_plane_elements > 64'h0000_0000_FFFF_FFFF) begin
                bad_range = 1'b1;
            end else begin
                source0_shape_bytes = source0_plane_elements *
                                      {32'd0, source0_width};
                if (source0_shape_bytes > 64'h0000_0000_FFFF_FFFF) begin
                    bad_range = 1'b1;
                end
            end
        end
        source0_object_end = {32'd0, source0_base_address} +
                             {32'd0, source0_length_bytes};
        if ((source0_length_bytes == 32'd0) ||
            ({32'd0, source0_length_bytes} < source0_shape_bytes) ||
            (source0_object_end > 64'h0000_0001_0000_0000)) begin
            bad_range = 1'b1;
        end

        if (source_count == 32'd2) begin
            if (FROZEN_ROUTE_SHAPES) begin
                source1_frozen_shape = frozen_shape_lookup({source1_channels, source1_height, source1_width});
                source1_plane_elements = source1_frozen_shape[127:64];
                source1_shape_bytes = source1_frozen_shape[63:0];
                if (!source1_frozen_shape[128]) begin
                    // 私有非冻结tuple拒绝；公开backend可达性由独立G0/G1证明。
                    bad_argument = 1'b1;
                end
            end else begin
                source1_plane_elements = {32'd0, source1_channels} *
                                         {32'd0, source1_height};
                if (source1_plane_elements > 64'h0000_0000_FFFF_FFFF) begin
                    bad_range = 1'b1;
                end else begin
                    source1_shape_bytes = source1_plane_elements *
                                          {32'd0, source1_width};
                    if (source1_shape_bytes > 64'h0000_0000_FFFF_FFFF) begin
                        bad_range = 1'b1;
                    end
                end
            end
            source1_object_end = {32'd0, source1_base_address} +
                                 {32'd0, source1_length_bytes};
            if ((source1_length_bytes == 32'd0) ||
                ({32'd0, source1_length_bytes} < source1_shape_bytes) ||
                (source1_object_end > 64'h0000_0001_0000_0000)) begin
                bad_range = 1'b1;
            end
        end

        if (output_channel < source0_selected_count) begin
            selected_source_index = 32'd0;
            selected_source_channel = source0_channel_start + output_channel;
            selected_value = source0_value;
            selected_multiplier = source0_multiplier_q31;
            selected_base_address = source0_base_address;
        end else if (source_count == 32'd2) begin
            selected_source_index = 32'd1;
            selected_source_channel = source1_channel_start +
                                     (output_channel - source0_selected_count);
            selected_value = source1_value;
            selected_multiplier = source1_multiplier_q31;
            selected_base_address = source1_base_address;
        end

        if (selected_value == -8'sd128) begin
            bad_argument = 1'b1;
        end

        // 前置shape、坐标、长度及对象端点检查保证成功路径地址精确落在32位。
        selected_offset =
            ((selected_source_channel * source0_height) + output_y) *
            source0_width + output_x;
        selected_address = selected_base_address + selected_offset;

        if (bad_argument) begin
            error_code = BAD_ARGUMENT;
        end else if (bad_range) begin
            error_code = BAD_RANGE;
        end else begin
            if (selected_value < 8'sd0) begin
                selected_magnitude = $unsigned(-selected_value);
            end else begin
                selected_magnitude = $unsigned(selected_value);
            end
            scaled_product = {32'd0, selected_magnitude} *
                             {7'd0, selected_multiplier};
            rounded_product = {1'b0, scaled_product} + 40'd1_073_741_824;
            rounded_magnitude = rounded_product[39:31];
            if (selected_value < 8'sd0) begin
                scaled_signed = -$signed(rounded_magnitude);
            end else begin
                scaled_signed = $signed(rounded_magnitude);
            end
            if (scaled_signed > 9'sd127) begin
                scaled_signed = 9'sd127;
            end else if (scaled_signed < -9'sd127) begin
                scaled_signed = -9'sd127;
            end

            output_channels = output_channels_wide[31:0];
            output_height = source0_height;
            output_width = source0_width;
            source_index = selected_source_index;
            source_channel = selected_source_channel;
            source_address = selected_address;
            output_value = scaled_signed[7:0];
        end
    end
endmodule

de8794c2b7795a630a15b485c823bc958a49d181 blob 4633
// 阶段 2A：对 NCHW INT8 nearest-repeat 上采样执行单点查询和数值复制。
module int8_upsample_query (
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_channels,
    input  logic [31:0] input_height,
    input  logic [31:0] input_width,
    input  logic [31:0] stride,
    input  logic [31:0] input_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,
    // 当前查询通道的紧凑行优先平面，byte 0 位于最低 8 位。
    input  logic [1351:0] source_plane,
    output logic [63:0] output_height,
    output logic [63:0] output_width,
    output logic [31:0] source_channel,
    output logic [31:0] source_y,
    output logic [31:0] source_x,
    output logic [31:0] source_address,
    output logic signed [7:0] output_value,
    // 成功为 0；非法参数或坐标为 BAD_ARGUMENT(1)，uint32 地址溢出为 BAD_RANGE(2)。
    output logic [2:0] error_code
);
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    localparam logic [31:0] MAX_PLANE_DIMENSION = 32'd13;

    logic [63:0] output_height_work;
    logic [63:0] output_width_work;
    logic [7:0] plane_elements_work;
    logic [7:0] plane_index_work;
    logic [39:0] byte_offset_work;
    logic [40:0] address_work;

    always_comb begin
        output_height_work = 64'd0;
        output_width_work = 64'd0;
        plane_elements_work = 8'd0;
        plane_index_work = 8'd0;
        byte_offset_work = 40'd0;
        address_work = 41'd0;

        output_height = 64'd0;
        output_width = 64'd0;
        source_channel = 32'd0;
        source_y = 32'd0;
        source_x = 32'd0;
        source_address = 32'd0;
        output_value = 8'sd0;
        error_code = 3'd0;

        if ((input_channels == 32'd0) || (input_height == 32'd0) ||
            (input_width == 32'd0) || (stride == 32'd0) ||
            (input_height > MAX_PLANE_DIMENSION) ||
            (input_width > MAX_PLANE_DIMENSION)) begin
            error_code = BAD_ARGUMENT;
        end else begin
            // 步长为 2 时乘法可精确改为移位；其他合法步长保留通用乘法。
            if (stride == 32'd2) begin
                output_height_work = {32'd0, input_height} << 1;
                output_width_work = {32'd0, input_width} << 1;
            end else begin
                output_height_work = {32'd0, input_height} * {32'd0, stride};
                output_width_work = {32'd0, input_width} * {32'd0, stride};
            end
            output_height = output_height_work;
            output_width = output_width_work;

            if ((input_channel >= input_channels) ||
                ({32'd0, output_y} >= output_height_work) ||
                ({32'd0, output_x} >= output_width_work)) begin
                error_code = BAD_ARGUMENT;
            end else begin
                source_channel = input_channel;
                // 步长为 2 时来源坐标就是输出坐标去掉最低位。
                if (stride == 32'd2) begin
                    source_y = {1'b0, output_y[31:1]};
                    source_x = {1'b0, output_x[31:1]};
                end else begin
                    source_y = output_y / stride;
                    source_x = output_x / stride;
                end
                // 边长已限制在 1 到 13，紧凑平面与通道地址可由窄位宽精确表示。
                plane_elements_work =
                    {4'd0, input_height[3:0]} * {4'd0, input_width[3:0]};
                plane_index_work =
                    ({4'd0, source_y[3:0]} * {4'd0, input_width[3:0]}) +
                    {4'd0, source_x[3:0]};
                byte_offset_work =
                    ({8'd0, input_channel} * {32'd0, plane_elements_work}) +
                    {32'd0, plane_index_work};
                address_work = {9'd0, input_base_address} +
                               {1'b0, byte_offset_work};

                if (address_work[40:32] != 9'd0) begin
                    error_code = BAD_RANGE;
                end else begin
                    source_address = address_work[31:0];
                    output_value = $signed(
                        source_plane[{plane_index_work, 3'b000} +: 8]
                    );
                end
            end
        end

        if (error_code != 3'd0) begin
            output_height = 64'd0;
            output_width = 64'd0;
            source_channel = 32'd0;
            source_y = 32'd0;
            source_x = 32'd0;
            source_address = 32'd0;
            output_value = 8'sd0;
        end
    end
endmodule

b3d3e284fc7ebf230ffefcec60415d3db5f63631 blob 214434
