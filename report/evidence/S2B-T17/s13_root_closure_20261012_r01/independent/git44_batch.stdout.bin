module s2b_conv_tile_engine #(
    // 仅冻结network实例启用；默认保留原通用参数域和错误判据。
    parameter bit FROZEN_CONV_DESCRIPTOR = 1'b0
) (
    input  logic        clk,
    input  logic        hard_reset,
