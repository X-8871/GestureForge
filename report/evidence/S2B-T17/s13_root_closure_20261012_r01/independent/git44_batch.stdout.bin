        "        source_x_work = 64'sd0;\n        plane_work = 64'd0;\n        channel_offset_work = 64'd0;\n        channel_offset_high = 1'b0;\n        channel_row_sum_work = 33'd0;\n        logical_offset_work = 33'd0;\n"
    ],
    [
