// S2A-T14 tiny416 三个 maxpool 层的单元素 INT8 memory datapath。
module s2a_maxpool_engine (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,

    input  logic        start_valid,
    output logic        start_ready,
    input  logic [31:0] layer_index,
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_length_bytes,
    input  logic [31:0] input_channels,
    input  logic [31:0] input_height,
    input  logic [31:0] input_width,
    input  logic [31:0] output_base_address,
    input  logic [31:0] output_length_bytes,
    input  logic [31:0] output_channels,
    input  logic [31:0] output_height,
    input  logic [31:0] output_width,
    input  logic [31:0] kernel_height,
    input  logic [31:0] kernel_width,
    input  logic [31:0] stride_y,
    input  logic [31:0] stride_x,
    input  logic [31:0] darknet_padding_parameter,
    input  logic [31:0] output_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,

    output logic        backend_cancel,
    output logic        backend_req_valid,
    input  logic        backend_req_ready,
    output logic        backend_req_write,
    output logic [31:0] backend_req_addr,
    output logic [31:0] backend_req_wdata,
    output logic [3:0]  backend_req_rstrb,
    output logic [3:0]  backend_req_wstrb,
    input  logic        backend_rsp_valid,
    input  logic [31:0] backend_rsp_rdata,
    input  logic [2:0]  backend_rsp_error,

    output logic        result_valid,
    input  logic        result_ready,
    output logic [127:0] result_tap_addresses,
    output logic [31:0] result_output_address,
    output logic [7:0]  result_value,
    output logic [2:0]  result_error_code
);
    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    localparam logic [2:0] BAD_LENGTH = 3'd3;
    localparam logic [2:0] INTERNAL = 3'd6;

    localparam logic [31:0] L9_INPUT_BASE = 32'd21968896;
    localparam logic [31:0] L9_INPUT_LENGTH = 32'd1384448;
    localparam logic [31:0] L9_OUTPUT_BASE = 32'd23353344;
    localparam logic [31:0] L9_OUTPUT_LENGTH = 32'd346112;
    localparam logic [31:0] L17_INPUT_BASE = 32'd25256960;
    localparam logic [31:0] L17_INPUT_LENGTH = 32'd692224;
    localparam logic [31:0] L17_OUTPUT_BASE = 32'd25949184;
    localparam logic [31:0] L17_OUTPUT_LENGTH = 32'd173056;
    localparam logic [31:0] L25_INPUT_BASE = 32'd26900992;
    localparam logic [31:0] L25_INPUT_LENGTH = 32'd346112;
    localparam logic [31:0] L25_OUTPUT_BASE = 32'd27247104;
    localparam logic [31:0] L25_OUTPUT_LENGTH = 32'd86528;

    typedef enum logic [3:0] {
        IDLE,
        READ_REQUEST,
        READ_RESPONSE,
        REDUCE_WINDOW,
        WRITE_REQUEST,
        WRITE_RESPONSE,
        RESULT
    } state_t;

    state_t state;
    logic [31:0] tap_address_latched [0:3];
    logic [31:0] output_address_latched;
    logic [71:0] candidate_values_latched;
    logic [2:0] read_tap_index;
    logic [7:0] result_value_latched;
    logic [2:0] result_error_latched;

    logic [32:0] query_output_height;
    logic [32:0] query_output_width;
    logic [3:0] query_tap_count;
    logic [8:0] query_tap_valid_mask;
    logic [31:0] query_tap_address [0:8];
    logic [31:0] query_tap_source_channel [0:8];
    logic signed [63:0] query_tap_source_y [0:8];
    logic signed [63:0] query_tap_source_x [0:8];
    logic [2:0] query_error_code;
    logic query_inputs_valid;
    logic query_outputs_valid;
    logic [63:0] output_offset_work;
    logic [64:0] output_address_work;
    logic [31:0] selected_byte_shift;
    logic [31:0] selected_input_word_address;
    logic [3:0] selected_input_lane;
    logic [2:0] mapped_response_error;
    logic signed [7:0] window_max_value;
    logic [2:0] window_error_code;
    integer tap_index;

    int8_maxpool_geometry u_geometry (
        .input_base_address(input_base_address),
        .input_channels(input_channels),
        .input_height(input_height),
        .input_width(input_width),
        .kernel_height(kernel_height),
        .kernel_width(kernel_width),
        .stride_y(stride_y),
        .stride_x(stride_x),
        .darknet_padding_parameter(darknet_padding_parameter),
        .input_channel(output_channel),
        .output_y(output_y),
        .output_x(output_x),
        .output_height(query_output_height),
        .output_width(query_output_width),
        .tap_count(query_tap_count),
        .tap_valid_mask(query_tap_valid_mask),
        .tap_address(query_tap_address),
        .tap_source_channel(query_tap_source_channel),
        .tap_source_y(query_tap_source_y),
        .tap_source_x(query_tap_source_x),
        .error_code(query_error_code)
    );

    int8_maxpool_window u_window (
        .candidate_count(4'd4),
        .candidates(candidate_values_latched),
        .max_value(window_max_value),
        .error_code(window_error_code)
    );

    always_comb begin
        query_inputs_valid = 1'b0;
        case (layer_index)
            32'd9: begin
                query_inputs_valid =
                    (input_channels == 32'd128) &&
                    (input_height == 32'd104) && (input_width == 32'd104) &&
                    (output_channels == 32'd128) &&
                    (output_height == 32'd52) && (output_width == 32'd52) &&
                    (kernel_height == 32'd2) && (kernel_width == 32'd2) &&
                    (stride_y == 32'd2) && (stride_x == 32'd2) &&
                    (darknet_padding_parameter == 32'd1);
            end
            32'd17: begin
                query_inputs_valid =
                    (input_channels == 32'd256) &&
                    (input_height == 32'd52) && (input_width == 32'd52) &&
                    (output_channels == 32'd256) &&
                    (output_height == 32'd26) && (output_width == 32'd26) &&
                    (kernel_height == 32'd2) && (kernel_width == 32'd2) &&
                    (stride_y == 32'd2) && (stride_x == 32'd2) &&
                    (darknet_padding_parameter == 32'd1);
            end
            32'd25: begin
                query_inputs_valid =
                    (input_channels == 32'd512) &&
                    (input_height == 32'd26) && (input_width == 32'd26) &&
                    (output_channels == 32'd512) &&
                    (output_height == 32'd13) && (output_width == 32'd13) &&
                    (kernel_height == 32'd2) && (kernel_width == 32'd2) &&
                    (stride_y == 32'd2) && (stride_x == 32'd2) &&
                    (darknet_padding_parameter == 32'd1);
            end
            default: query_inputs_valid = 1'b0;
        endcase

        query_outputs_valid =
            (query_error_code == NONE) && (query_tap_count == 4'd4) &&
            (query_tap_valid_mask[3:0] == 4'b1111) &&
            (query_output_height == {1'b0, output_height}) &&
            (query_output_width == {1'b0, output_width});

        start_ready = (state == IDLE) && !hard_reset && !abort;
        backend_cancel = hard_reset || abort;
        backend_req_valid = 1'b0;
        backend_req_write = 1'b0;
        backend_req_addr = 32'd0;
        backend_req_wdata = 32'd0;
        backend_req_rstrb = 4'd0;
        backend_req_wstrb = 4'd0;

        selected_input_word_address = 32'd0;
        selected_input_lane = 4'd0;
        selected_byte_shift = 32'd0;
        if (read_tap_index < 3'd4) begin
            selected_input_word_address =
                {tap_address_latched[read_tap_index][31:2], 2'b00};
            selected_input_lane = 4'b0001 << tap_address_latched[read_tap_index][1:0];
            selected_byte_shift =
                {30'd0, tap_address_latched[read_tap_index][1:0]} * 32'd8;
        end

        if (!hard_reset && !abort) begin
            if (state == READ_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_addr = selected_input_word_address;
                backend_req_rstrb = selected_input_lane;
            end else if (state == WRITE_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_write = 1'b1;
                backend_req_addr = {output_address_latched[31:2], 2'b00};
                backend_req_wdata = {24'd0, result_value_latched} <<
                                    (output_address_latched[1:0] * 8);
                backend_req_wstrb = 4'b0001 << output_address_latched[1:0];
            end
        end

        result_valid = (state == RESULT);
        result_tap_addresses = {
            tap_address_latched[3], tap_address_latched[2],
            tap_address_latched[1], tap_address_latched[0]
        };
        result_output_address = output_address_latched;
        result_value = result_value_latched;
        result_error_code = result_error_latched;

        output_offset_work =
            ((({32'd0, output_channel} * {32'd0, output_height}) +
              {32'd0, output_y}) * {32'd0, output_width}) +
            {32'd0, output_x};
        output_address_work = {33'd0, output_base_address} +
                              {1'b0, output_offset_work};

        mapped_response_error = INTERNAL;
        if ((backend_rsp_error == BAD_ARGUMENT) ||
            (backend_rsp_error == BAD_RANGE) ||
            (backend_rsp_error == INTERNAL)) begin
            mapped_response_error = backend_rsp_error;
        end else if (backend_rsp_error == NONE) begin
            mapped_response_error = NONE;
        end
    end

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= IDLE;
            tap_address_latched[0] <= 32'd0;
            tap_address_latched[1] <= 32'd0;
            tap_address_latched[2] <= 32'd0;
            tap_address_latched[3] <= 32'd0;
            output_address_latched <= 32'd0;
            candidate_values_latched <= 72'd0;
            read_tap_index <= 3'd0;
            result_value_latched <= 8'd0;
            result_error_latched <= NONE;
        end else if (abort && (state != IDLE) && (state != RESULT)) begin
            state <= IDLE;
            tap_address_latched[0] <= 32'd0;
            tap_address_latched[1] <= 32'd0;
            tap_address_latched[2] <= 32'd0;
            tap_address_latched[3] <= 32'd0;
            output_address_latched <= 32'd0;
            candidate_values_latched <= 72'd0;
            read_tap_index <= 3'd0;
            result_value_latched <= 8'd0;
            result_error_latched <= NONE;
        end else begin
            case (state)
                IDLE: begin
                    if (start_valid && start_ready) begin
                        tap_address_latched[0] <= 32'd0;
                        tap_address_latched[1] <= 32'd0;
                        tap_address_latched[2] <= 32'd0;
                        tap_address_latched[3] <= 32'd0;
                        output_address_latched <= 32'd0;
                        candidate_values_latched <= 72'd0;
                        read_tap_index <= 3'd0;
                        result_value_latched <= 8'd0;
                        result_error_latched <= NONE;
                        if (!query_inputs_valid) begin
                            result_error_latched <= BAD_ARGUMENT;
                            state <= RESULT;
                        end else if ((input_length_bytes !=
                                      (input_channels * input_height * input_width)) ||
                                     (output_length_bytes !=
                                      (output_channels * output_height * output_width))) begin
                            result_error_latched <= BAD_LENGTH;
                            state <= RESULT;
                        end else if ((layer_index == 32'd9 &&
                                      ((input_base_address != L9_INPUT_BASE) ||
                                       (output_base_address != L9_OUTPUT_BASE) ||
                                       (input_length_bytes != L9_INPUT_LENGTH) ||
                                       (output_length_bytes != L9_OUTPUT_LENGTH)) ) ||
                                     (layer_index == 32'd17 &&
                                      ((input_base_address != L17_INPUT_BASE) ||
                                       (output_base_address != L17_OUTPUT_BASE) ||
                                       (input_length_bytes != L17_INPUT_LENGTH) ||
                                       (output_length_bytes != L17_OUTPUT_LENGTH)) ) ||
                                     (layer_index == 32'd25 &&
                                      ((input_base_address != L25_INPUT_BASE) ||
                                       (output_base_address != L25_OUTPUT_BASE) ||
                                       (input_length_bytes != L25_INPUT_LENGTH) ||
                                       (output_length_bytes != L25_OUTPUT_LENGTH)) )) begin
                            if ((input_length_bytes !=
                                 (input_channels * input_height * input_width)) ||
                                (output_length_bytes !=
                                 (output_channels * output_height * output_width))) begin
                                result_error_latched <= BAD_LENGTH;
                            end else begin
                                result_error_latched <= BAD_RANGE;
                            end
                            state <= RESULT;
                        end else if ((query_error_code != NONE) || !query_outputs_valid ||
                                     (output_channel >= output_channels) ||
                                     (output_y >= output_height) ||
                                     (output_x >= output_width) ||
                                     (output_offset_work >= {32'd0, output_length_bytes}) ||
                                     (output_address_work[64:32] != 33'd0)) begin
                            result_error_latched <=
                                (query_error_code == BAD_RANGE ||
                                 output_address_work[64:32] != 33'd0) ?
                                BAD_RANGE : BAD_ARGUMENT;
                            state <= RESULT;
                        end else begin
                            for (tap_index = 0; tap_index < 4; tap_index = tap_index + 1) begin
                                tap_address_latched[tap_index] <= query_tap_address[tap_index];
                            end
                            output_address_latched <= output_address_work[31:0];
                            state <= READ_REQUEST;
                        end
                    end
                end
                READ_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= READ_RESPONSE;
                    end
                end
                READ_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        if (mapped_response_error != NONE) begin
                            candidate_values_latched <= 72'd0;
                            result_value_latched <= 8'd0;
                            result_error_latched <= mapped_response_error;
                            state <= RESULT;
                        end else begin
                            candidate_values_latched[read_tap_index * 8 +: 8] <=
                                backend_rsp_rdata >> selected_byte_shift;
                            if (read_tap_index == 3'd3) begin
                                state <= REDUCE_WINDOW;
                            end else begin
                                read_tap_index <= read_tap_index + 3'd1;
                                state <= READ_REQUEST;
                            end
                        end
                    end
                end
                REDUCE_WINDOW: begin
                    if (window_error_code != NONE) begin
                        result_value_latched <= 8'd0;
                        result_error_latched <= window_error_code;
                        state <= RESULT;
                    end else begin
                        result_value_latched <= window_max_value;
                        state <= WRITE_REQUEST;
                    end
                end
                WRITE_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= WRITE_RESPONSE;
                    end
                end
                WRITE_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        result_error_latched <= mapped_response_error;
                        if (mapped_response_error != NONE) begin
                            result_value_latched <= 8'd0;
                        end
                        state <= RESULT;
                    end
                end
                RESULT: begin
                    if (result_valid && result_ready) begin
                        state <= IDLE;
                        result_error_latched <= NONE;
                    end
                end
                default: begin
                    state <= RESULT;
                    result_value_latched <= 8'd0;
                    result_error_latched <= INTERNAL;
                end
            endcase
        end
    end
endmodule

63686dc506303145b58e25855f95d393bf21f478 blob 17616
// S2A-T15：tiny416 route 单输出元素 INT8 memory datapath。
module s2a_route_engine (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,

    input  logic        start_valid,
    output logic        start_ready,
    input  logic [31:0] source_count,
    input  logic [31:0] groups,
    input  logic [31:0] group_id,
    input  logic [31:0] output_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,

    input  logic [31:0] source0_base_address,
    input  logic [31:0] source0_length_bytes,
    input  logic [31:0] source0_channels,
    input  logic [31:0] source0_height,
    input  logic [31:0] source0_width,
    input  logic [31:0] source0_channel_start,
    input  logic [31:0] source0_channel_end,
    input  logic [31:0] source0_multiplier_q31,

    input  logic [31:0] source1_base_address,
    input  logic [31:0] source1_length_bytes,
    input  logic [31:0] source1_channels,
    input  logic [31:0] source1_height,
    input  logic [31:0] source1_width,
    input  logic [31:0] source1_channel_start,
    input  logic [31:0] source1_channel_end,
    input  logic [31:0] source1_multiplier_q31,

    input  logic [31:0] output_base_address,
    input  logic [31:0] output_length_bytes,
    input  logic [31:0] output_channels,
    input  logic [31:0] output_height,
    input  logic [31:0] output_width,

    output logic        backend_cancel,
    output logic        backend_req_valid,
    input  logic        backend_req_ready,
    output logic        backend_req_write,
    output logic [31:0] backend_req_addr,
    output logic [31:0] backend_req_wdata,
    output logic [3:0]  backend_req_rstrb,
    output logic [3:0]  backend_req_wstrb,
    input  logic        backend_rsp_valid,
    input  logic [31:0] backend_rsp_rdata,
    input  logic [2:0]  backend_rsp_error,

    output logic        result_valid,
    input  logic        result_ready,
    output logic [31:0] result_source_index,
    output logic [31:0] result_source_address,
    output logic [31:0] result_output_address,
    output logic [7:0]  result_value,
    output logic [2:0]  result_error_code
);
    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    localparam logic [2:0] BAD_LENGTH = 3'd3;
    localparam logic [2:0] INTERNAL = 3'd6;

    typedef enum logic [3:0] {
        IDLE,
        VALIDATE,
        READ_REQUEST,
        READ_RESPONSE,
        CHECK_VALUE,
        WRITE_REQUEST,
        WRITE_RESPONSE,
        RESULT
    } state_t;

    state_t state;

    logic [31:0] source_count_latched;
    logic [31:0] groups_latched;
    logic [31:0] group_id_latched;
    logic [31:0] output_channel_latched;
    logic [31:0] output_y_latched;
    logic [31:0] output_x_latched;

    logic [31:0] source0_base_latched;
    logic [31:0] source0_length_latched;
    logic [31:0] source0_channels_latched;
    logic [31:0] source0_height_latched;
    logic [31:0] source0_width_latched;
    logic [31:0] source0_start_latched;
    logic [31:0] source0_end_latched;
    logic [31:0] source0_multiplier_latched;
    logic signed [7:0] source0_value_latched;

    logic [31:0] source1_base_latched;
    logic [31:0] source1_length_latched;
    logic [31:0] source1_channels_latched;
    logic [31:0] source1_height_latched;
    logic [31:0] source1_width_latched;
    logic [31:0] source1_start_latched;
    logic [31:0] source1_end_latched;
    logic [31:0] source1_multiplier_latched;
    logic signed [7:0] source1_value_latched;

    logic [31:0] output_base_latched;
    logic [31:0] output_length_latched;
    logic [31:0] output_channels_latched;
    logic [31:0] output_height_latched;
    logic [31:0] output_width_latched;

    logic [31:0] source_index_latched;
    logic [31:0] source_address_latched;
    logic [31:0] output_address_latched;
    logic [7:0] result_value_latched;
    logic [2:0] result_error_latched;

    logic [31:0] query_output_channels;
    logic [31:0] query_output_height;
    logic [31:0] query_output_width;
    logic [31:0] query_source_index;
    logic [31:0] query_source_channel;
    logic [31:0] query_source_address;
    logic signed [7:0] query_output_value;
    logic [2:0] query_error_code;

    logic [64:0] output_elements_work;
    logic [64:0] output_offset_work;
    logic [64:0] output_end_work;
    logic [31:0] selected_word_address;
    logic [3:0] selected_read_lane;
    logic [31:0] selected_byte_shift;
    logic [2:0] mapped_response_error;

    int8_route_query u_query (
        .source_count(source_count_latched),
        .groups(groups_latched),
        .group_id(group_id_latched),
        .output_channel(output_channel_latched),
        .output_y(output_y_latched),
        .output_x(output_x_latched),
        .source0_base_address(source0_base_latched),
        .source0_length_bytes(source0_length_latched),
        .source0_channels(source0_channels_latched),
        .source0_height(source0_height_latched),
        .source0_width(source0_width_latched),
        .source0_channel_start(source0_start_latched),
        .source0_channel_end(source0_end_latched),
        .source0_multiplier_q31(source0_multiplier_latched),
        .source0_value(source0_value_latched),
        .source1_base_address(source1_base_latched),
        .source1_length_bytes(source1_length_latched),
        .source1_channels(source1_channels_latched),
        .source1_height(source1_height_latched),
        .source1_width(source1_width_latched),
        .source1_channel_start(source1_start_latched),
        .source1_channel_end(source1_end_latched),
        .source1_multiplier_q31(source1_multiplier_latched),
        .source1_value(source1_value_latched),
        .output_channels(query_output_channels),
        .output_height(query_output_height),
        .output_width(query_output_width),
        .source_index(query_source_index),
        .source_channel(query_source_channel),
        .source_address(query_source_address),
        .output_value(query_output_value),
        .error_code(query_error_code)
    );

    always_comb begin
        output_elements_work = {33'd0, output_channels_latched} *
                               {33'd0, output_height_latched} *
                               {33'd0, output_width_latched};
        output_offset_work =
            (({33'd0, output_channel_latched} * {33'd0, output_height_latched}) +
             {33'd0, output_y_latched}) * {33'd0, output_width_latched} +
            {33'd0, output_x_latched};
        output_end_work = {33'd0, output_base_latched} +
                          {33'd0, output_length_latched};

        selected_word_address = {source_address_latched[31:2], 2'b00};
        selected_read_lane = 4'b0001 << source_address_latched[1:0];
        selected_byte_shift = {30'd0, source_address_latched[1:0]} * 32'd8;

        mapped_response_error = INTERNAL;
        if ((backend_rsp_error == BAD_ARGUMENT) ||
            (backend_rsp_error == BAD_RANGE) ||
            (backend_rsp_error == INTERNAL)) begin
            mapped_response_error = backend_rsp_error;
        end else if (backend_rsp_error == NONE) begin
            mapped_response_error = NONE;
        end

        start_ready = (state == IDLE) && !hard_reset && !abort;
        backend_cancel = hard_reset || abort;
        backend_req_valid = 1'b0;
        backend_req_write = 1'b0;
        backend_req_addr = 32'd0;
        backend_req_wdata = 32'd0;
        backend_req_rstrb = 4'd0;
        backend_req_wstrb = 4'd0;
        if (!hard_reset && !abort) begin
            if (state == READ_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_addr = selected_word_address;
                backend_req_rstrb = selected_read_lane;
            end else if (state == WRITE_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_write = 1'b1;
                backend_req_addr = {output_address_latched[31:2], 2'b00};
                backend_req_wdata = {24'd0, result_value_latched} <<
                                    (output_address_latched[1:0] * 8);
                backend_req_wstrb = 4'b0001 << output_address_latched[1:0];
            end
        end

        result_valid = (state == RESULT);
        result_source_index = source_index_latched;
        result_source_address = source_address_latched;
        result_output_address = output_address_latched;
        result_value = result_value_latched;
        result_error_code = result_error_latched;
    end

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= IDLE;
            source_count_latched <= 32'd0;
            groups_latched <= 32'd0;
            group_id_latched <= 32'd0;
            output_channel_latched <= 32'd0;
            output_y_latched <= 32'd0;
            output_x_latched <= 32'd0;
            source0_base_latched <= 32'd0;
            source0_length_latched <= 32'd0;
            source0_channels_latched <= 32'd0;
            source0_height_latched <= 32'd0;
            source0_width_latched <= 32'd0;
            source0_start_latched <= 32'd0;
            source0_end_latched <= 32'd0;
            source0_multiplier_latched <= 32'd0;
            source0_value_latched <= 8'sd0;
            source1_base_latched <= 32'd0;
            source1_length_latched <= 32'd0;
            source1_channels_latched <= 32'd0;
            source1_height_latched <= 32'd0;
            source1_width_latched <= 32'd0;
            source1_start_latched <= 32'd0;
            source1_end_latched <= 32'd0;
            source1_multiplier_latched <= 32'd0;
            source1_value_latched <= 8'sd0;
            output_base_latched <= 32'd0;
            output_length_latched <= 32'd0;
            output_channels_latched <= 32'd0;
            output_height_latched <= 32'd0;
            output_width_latched <= 32'd0;
            source_index_latched <= 32'd0;
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            result_value_latched <= 8'd0;
            result_error_latched <= NONE;
        end else if (abort && (state != IDLE) && (state != RESULT)) begin
            state <= IDLE;
            source_index_latched <= 32'd0;
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            result_value_latched <= 8'd0;
            result_error_latched <= NONE;
            source0_value_latched <= 8'sd0;
            source1_value_latched <= 8'sd0;
        end else begin
            case (state)
                IDLE: begin
                    if (start_valid && start_ready) begin
                        source_count_latched <= source_count;
                        groups_latched <= groups;
                        group_id_latched <= group_id;
                        output_channel_latched <= output_channel;
                        output_y_latched <= output_y;
                        output_x_latched <= output_x;
                        source0_base_latched <= source0_base_address;
                        source0_length_latched <= source0_length_bytes;
                        source0_channels_latched <= source0_channels;
                        source0_height_latched <= source0_height;
                        source0_width_latched <= source0_width;
                        source0_start_latched <= source0_channel_start;
                        source0_end_latched <= source0_channel_end;
                        source0_multiplier_latched <= source0_multiplier_q31;
                        source0_value_latched <= 8'sd0;
                        source1_base_latched <= source1_base_address;
                        source1_length_latched <= source1_length_bytes;
                        source1_channels_latched <= source1_channels;
                        source1_height_latched <= source1_height;
                        source1_width_latched <= source1_width;
                        source1_start_latched <= source1_channel_start;
                        source1_end_latched <= source1_channel_end;
                        source1_multiplier_latched <= source1_multiplier_q31;
                        source1_value_latched <= 8'sd0;
                        output_base_latched <= output_base_address;
                        output_length_latched <= output_length_bytes;
                        output_channels_latched <= output_channels;
                        output_height_latched <= output_height;
                        output_width_latched <= output_width;
                        source_index_latched <= 32'd0;
                        source_address_latched <= 32'd0;
                        output_address_latched <= 32'd0;
                        result_value_latched <= 8'd0;
                        result_error_latched <= NONE;
                        state <= VALIDATE;
                    end
                end
                VALIDATE: begin
                    if ((query_error_code != NONE) ||
                        (query_output_channels != output_channels_latched) ||
                        (query_output_height != output_height_latched) ||
                        (query_output_width != output_width_latched) ||
                        (output_channels_latched == 32'd0) ||
                        (output_height_latched == 32'd0) ||
                        (output_width_latched == 32'd0) ||
                        (output_length_latched == 32'd0) ||
                        (output_elements_work > {33'd0, output_length_latched})) begin
                        result_error_latched <=
                            (query_error_code == BAD_RANGE) ? BAD_RANGE :
                            ((query_error_code == BAD_ARGUMENT) ? BAD_ARGUMENT : BAD_LENGTH);
                        state <= RESULT;
                    end else if (output_end_work > 65'h0000_0001_0000_0000) begin
                        result_error_latched <= BAD_RANGE;
                        state <= RESULT;
                    end else if ((output_offset_work >= {33'd0, output_length_latched}) ||
                                 (output_base_latched + output_offset_work[31:0] < output_base_latched)) begin
                        result_error_latched <= BAD_RANGE;
                        state <= RESULT;
                    end else begin
                        source_index_latched <= query_source_index;
                        source_address_latched <= query_source_address;
                        output_address_latched <=
                            output_base_latched + output_offset_work[31:0];
                        state <= READ_REQUEST;
                    end
                end
                READ_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= READ_RESPONSE;
                    end
                end
                READ_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        if (mapped_response_error != NONE) begin
                            result_value_latched <= 8'd0;
                            result_error_latched <= mapped_response_error;
                            state <= RESULT;
                        end else if (source_index_latched == 32'd0) begin
                            source0_value_latched <=
                                $signed(backend_rsp_rdata >> selected_byte_shift);
                            state <= CHECK_VALUE;
                        end else if (source_index_latched == 32'd1) begin
                            source1_value_latched <=
                                $signed(backend_rsp_rdata >> selected_byte_shift);
                            state <= CHECK_VALUE;
                        end else begin
                            result_value_latched <= 8'd0;
                            result_error_latched <= INTERNAL;
                            state <= RESULT;
                        end
                    end
                end
                CHECK_VALUE: begin
                    if (query_error_code != NONE) begin
                        result_value_latched <= 8'd0;
                        result_error_latched <= query_error_code;
                        state <= RESULT;
                    end else begin
                        result_value_latched <= query_output_value;
                        result_error_latched <= NONE;
                        state <= WRITE_REQUEST;
                    end
                end
                WRITE_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= WRITE_RESPONSE;
                    end
                end
                WRITE_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        result_error_latched <= mapped_response_error;
                        if (mapped_response_error != NONE) begin
                            result_value_latched <= 8'd0;
                        end
                        state <= RESULT;
                    end
                end
                RESULT: begin
                    if (result_valid && result_ready) begin
                        state <= IDLE;
                        result_error_latched <= NONE;
                    end
                end
                default: begin
                    state <= IDLE;
                    result_value_latched <= 8'd0;
                    result_error_latched <= INTERNAL;
                end
            endcase
        end
    end
endmodule

7406d1c1dd7fb11b37d6d34663567f6e1f81b820 blob 10536
// S2A-T13：tiny416 layer33 单元素 INT8 nearest-repeat memory datapath。
module s2a_upsample_engine (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,

    input  logic        start_valid,
    output logic        start_ready,
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_length_bytes,
    input  logic [31:0] output_base_address,
    input  logic [31:0] output_length_bytes,
    input  logic [31:0] input_channels,
    input  logic [31:0] input_height,
    input  logic [31:0] input_width,
    input  logic [31:0] stride,
    input  logic [31:0] output_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,

    output logic        backend_cancel,
    output logic        backend_req_valid,
    input  logic        backend_req_ready,
    output logic        backend_req_write,
    output logic [31:0] backend_req_addr,
    output logic [31:0] backend_req_wdata,
    output logic [3:0]  backend_req_rstrb,
    output logic [3:0]  backend_req_wstrb,
    input  logic        backend_rsp_valid,
    input  logic [31:0] backend_rsp_rdata,
    input  logic [2:0]  backend_rsp_error,

    output logic        result_valid,
    input  logic        result_ready,
    output logic [31:0] result_source_address,
    output logic [31:0] result_output_address,
    output logic [7:0]  result_value,
    output logic [2:0]  result_error_code
);
    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    localparam logic [2:0] BAD_LENGTH = 3'd3;
    localparam logic [2:0] INTERNAL = 3'd6;

    localparam logic [31:0] INPUT_BASE = 32'd27598336;
    localparam logic [31:0] INPUT_LENGTH = 32'd21632;
    localparam logic [31:0] OUTPUT_BASE = 32'd27619968;
    localparam logic [31:0] OUTPUT_LENGTH = 32'd86528;
    localparam logic [31:0] CHANNELS = 32'd128;
    localparam logic [31:0] INPUT_DIMENSION = 32'd13;
    localparam logic [31:0] UPSAMPLE_STRIDE = 32'd2;

    typedef enum logic [2:0] {
        IDLE,
        READ_REQUEST,
        READ_RESPONSE,
        WRITE_REQUEST,
        WRITE_RESPONSE,
        RESULT
    } state_t;

    state_t state;
    logic [31:0] source_address_latched;
    logic [31:0] output_address_latched;
    logic [7:0] copied_value_latched;
    logic [2:0] result_error_latched;

    logic [63:0] query_output_height;
    logic [63:0] query_output_width;
    logic [31:0] query_source_channel;
    logic [31:0] query_source_y;
    logic [31:0] query_source_x;
    logic [31:0] query_source_address;
    logic signed [7:0] query_unused_value;
    logic [2:0] query_error_code;
    logic [1351:0] query_unused_plane;
    logic [63:0] output_offset_work;
    logic [64:0] output_address_work;
    logic [31:0] selected_byte_shift;
    logic [2:0] mapped_response_error;

    assign query_unused_plane = '0;

    int8_upsample_query u_query (
        .input_base_address(input_base_address),
        .input_channels(input_channels),
        .input_height(input_height),
        .input_width(input_width),
        .stride(stride),
        .input_channel(output_channel),
        .output_y(output_y),
        .output_x(output_x),
        .source_plane(query_unused_plane),
        .output_height(query_output_height),
        .output_width(query_output_width),
        .source_channel(query_source_channel),
        .source_y(query_source_y),
        .source_x(query_source_x),
        .source_address(query_source_address),
        .output_value(query_unused_value),
        .error_code(query_error_code)
    );

    always_comb begin
        start_ready = (state == IDLE) && !hard_reset && !abort;
        backend_cancel = hard_reset || abort;
        backend_req_valid = 1'b0;
        backend_req_write = 1'b0;
        backend_req_addr = 32'd0;
        backend_req_wdata = 32'd0;
        backend_req_rstrb = 4'd0;
        backend_req_wstrb = 4'd0;
        if (!hard_reset && !abort) begin
            if (state == READ_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_addr = {source_address_latched[31:2], 2'b00};
                backend_req_rstrb = 4'b0001 << source_address_latched[1:0];
            end else if (state == WRITE_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_write = 1'b1;
                backend_req_addr = {output_address_latched[31:2], 2'b00};
                backend_req_wdata = {24'd0, copied_value_latched} <<
                                    (output_address_latched[1:0] * 8);
                backend_req_wstrb = 4'b0001 << output_address_latched[1:0];
            end
        end
        result_valid = (state == RESULT);
        result_source_address = source_address_latched;
        result_output_address = output_address_latched;
        result_value = copied_value_latched;
        result_error_code = result_error_latched;

        output_offset_work =
            ((({32'd0, output_channel} * 64'd26) + {32'd0, output_y}) * 64'd26) +
            {32'd0, output_x};
        output_address_work = {33'd0, output_base_address} +
                              {33'd0, output_offset_work};
        selected_byte_shift = {30'd0, source_address_latched[1:0]} * 32'd8;
        mapped_response_error = INTERNAL;
        if ((backend_rsp_error == 3'd1) || (backend_rsp_error == 3'd2) ||
            (backend_rsp_error == 3'd6)) begin
            mapped_response_error = backend_rsp_error;
        end else if (backend_rsp_error == NONE) begin
            mapped_response_error = NONE;
        end
    end

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= IDLE;
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            copied_value_latched <= 8'd0;
            result_error_latched <= NONE;
        end else if (abort && (state != IDLE) && (state != RESULT)) begin
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            copied_value_latched <= 8'd0;
            result_error_latched <= NONE;
            state <= IDLE;
        end else begin
            case (state)
                IDLE: begin
                    if (start_valid && start_ready) begin
                        copied_value_latched <= 8'd0;
                        result_error_latched <= NONE;
                        source_address_latched <= 32'd0;
                        output_address_latched <= 32'd0;
                        if ((input_channels != CHANNELS) ||
                            (input_height != INPUT_DIMENSION) ||
                            (input_width != INPUT_DIMENSION) ||
                            (stride != UPSAMPLE_STRIDE) ||
                            (output_channel >= CHANNELS) ||
                            (output_y >= 32'd26) || (output_x >= 32'd26)) begin
                            result_error_latched <= BAD_ARGUMENT;
                            state <= RESULT;
                        end else if ((input_length_bytes != INPUT_LENGTH) ||
                                     (output_length_bytes != OUTPUT_LENGTH)) begin
                            result_error_latched <= BAD_LENGTH;
                            state <= RESULT;
                        end else if ((input_base_address != INPUT_BASE) ||
                                     (output_base_address != OUTPUT_BASE)) begin
                            result_error_latched <= BAD_RANGE;
                            state <= RESULT;
                        end else if ((query_error_code != NONE) ||
                                     (query_source_channel != output_channel) ||
                                     (query_source_address < input_base_address) ||
                                     (({1'b0, query_source_address} -
                                       {1'b0, input_base_address}) >=
                                      {1'b0, input_length_bytes}) ||
                                     (output_address_work[64:32] != 33'd0) ||
                                     (output_offset_work >= {32'd0, output_length_bytes})) begin
                            result_error_latched <=
                                (query_error_code == BAD_RANGE) ? BAD_RANGE : BAD_ARGUMENT;
                            state <= RESULT;
                        end else begin
                            source_address_latched <= query_source_address;
                            output_address_latched <= output_address_work[31:0];
                            state <= READ_REQUEST;
                        end
                    end
                end
                READ_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= READ_RESPONSE;
                    end
                end
                READ_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        if (mapped_response_error != NONE) begin
                            copied_value_latched <= 8'd0;
                            result_error_latched <= mapped_response_error;
                            state <= RESULT;
                        end else begin
                            copied_value_latched <=
                                (backend_rsp_rdata >> selected_byte_shift);
                            state <= WRITE_REQUEST;
                        end
                    end
                end
                WRITE_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= WRITE_RESPONSE;
                    end
                end
                WRITE_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        result_error_latched <= mapped_response_error;
                        if (mapped_response_error != NONE) begin
                            copied_value_latched <= 8'd0;
                        end
                        state <= RESULT;
                    end
                end
                RESULT: begin
                    if (result_valid && result_ready) begin
                        state <= IDLE;
                        result_error_latched <= NONE;
                    end
                end
                default: begin
                    state <= IDLE;
                    copied_value_latched <= 8'd0;
                    result_error_latched <= INTERNAL;
                end
            endcase
        end
    end
endmodule

ee3c4d229d64a1fafe80c53875715dd42f5e23ba blob 32459
// S2A-T64：按冻结 descriptor ROM 串行复用四类算子引擎。
module s2a_network_backend (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,
    input  logic        backend_start,
    input  logic        buffer_owner_pl,
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_length_bytes,
    input  logic [31:0] weight_package_base_address,
    input  logic [31:0] weight_package_length_bytes,

    output logic        mem_valid,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic        mem_ready,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code,

    output logic        backend_memory_error_valid,
    output logic [2:0]  backend_memory_error_code,
    output logic        operator_result_valid,
    output logic [2:0]  operator_error_code
);
    import s2a_network_descriptor_pkg::*;

    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] INTERNAL = 3'd6;

    typedef enum logic [2:0] {
        ST_IDLE,
        ST_DISPATCH,
        ST_WAIT_CONV,
        ST_WAIT_MAXPOOL,
        ST_WAIT_ROUTE,
        ST_WAIT_UPSAMPLE
    } state_t;

    state_t state;
    logic [5:0] layer_cursor;
    logic [31:0] output_element_index;
    logic response_pending;
    logic [31:0] response_data_latched;
    logic [2:0] response_error_latched;
    logic [2:0] response_target_latched;

    logic [2:0] current_op;
    logic [1:0] current_input_count;
    logic [31:0] source_base [0:1];
    logic [31:0] source_length [0:1];
    logic [15:0] source_n [0:1];
    logic [15:0] source_c [0:1];
    logic [15:0] source_h [0:1];
    logic [15:0] source_w [0:1];
    logic [15:0] source_route_start [0:1];
    logic [15:0] source_route_end [0:1];
    logic [31:0] output_base;
    logic [31:0] output_length;
    logic [15:0] output_n;
    logic [15:0] output_c;
    logic [15:0] output_h;
    logic [15:0] output_w;
    logic [63:0] output_plane_elements;
    logic [63:0] output_batch_elements;
    logic [63:0] output_element_count;
    logic [31:0] decoded_channel;
    logic [31:0] decoded_y;
    logic [31:0] decoded_x;
    logic [31:0] mq_index;
    logic descriptor_valid;
    logic alias_valid;
    logic descriptor_fault;
    logic is_alias_row;
    logic [5:0] alias_layer_index;
    logic [63:0] alias_output_plane_elements;
    logic [63:0] alias_output_element_count;

    logic conv_start_valid, conv_start_ready;
    logic maxpool_start_valid, maxpool_start_ready;
    logic route_start_valid, route_start_ready;
    logic upsample_start_valid, upsample_start_ready;
    logic maxpool_cancel, route_cancel, upsample_cancel;
    logic conv_req_valid, conv_req_ready, conv_req_write;
    logic [31:0] conv_req_addr, conv_req_wdata;
    logic [3:0] conv_req_rstrb, conv_req_wstrb;
    logic maxpool_req_valid, maxpool_req_ready, maxpool_req_write;
    logic [31:0] maxpool_req_addr, maxpool_req_wdata;
    logic [3:0] maxpool_req_rstrb, maxpool_req_wstrb;
    logic route_req_valid, route_req_ready, route_req_write;
    logic [31:0] route_req_addr, route_req_wdata;
    logic [3:0] route_req_rstrb, route_req_wstrb;
    logic upsample_req_valid, upsample_req_ready, upsample_req_write;
    logic [31:0] upsample_req_addr, upsample_req_wdata;
    logic [3:0] upsample_req_rstrb, upsample_req_wstrb;
    logic conv_rsp_valid, maxpool_rsp_valid, route_rsp_valid, upsample_rsp_valid;
    logic [31:0] conv_rsp_data, maxpool_rsp_data, route_rsp_data, upsample_rsp_data;
    logic [2:0] conv_rsp_error, maxpool_rsp_error, route_rsp_error, upsample_rsp_error;
    logic conv_result_valid, conv_result_ready;
    logic [2:0] conv_result_error;
    logic maxpool_result_valid, maxpool_result_ready;
    logic [127:0] maxpool_tap_addresses;
    logic [31:0] maxpool_result_address;
    logic [7:0] maxpool_result_value;
    logic [2:0] maxpool_result_error;
    logic route_result_valid, route_result_ready;
    logic [31:0] route_result_source_index;
    logic [31:0] route_result_source_address;
    logic [31:0] route_result_address;
    logic [7:0] route_result_value;
    logic [2:0] route_result_error;
    logic upsample_result_valid, upsample_result_ready;
    logic [31:0] upsample_result_source_address;
    logic [31:0] upsample_result_address;
    logic [7:0] upsample_result_value;
    logic [2:0] upsample_result_error;

    logic selected_req_valid;
    logic selected_req_write;
    logic [31:0] selected_req_addr;
    logic [31:0] selected_req_wdata;
    logic [3:0] selected_req_rstrb;
    logic [3:0] selected_req_wstrb;
    logic selected_result_valid;
    logic [2:0] selected_result_error;
    logic memory_handshake;
    logic selected_start_ready;

    function automatic logic [2:0] normalize_engine_error(input logic [2:0] code);
        begin
            case (code)
                3'd0: normalize_engine_error = NONE;
                3'd1, 3'd2, 3'd3, 3'd4, 3'd5, 3'd6, 3'd7:
                    normalize_engine_error = code;
                default: normalize_engine_error = INTERNAL;
            endcase
        end
    endfunction

    // 冻结包 activation 枚举映射到卷积引擎的方向性 M/Q 选择编码。
    function automatic logic [1:0] map_conv_activation(input logic [1:0] descriptor_activation);
        begin
            case (descriptor_activation)
                S2A_ACT_NONE, S2A_ACT_LINEAR: map_conv_activation = 2'd0;
                S2A_ACT_LEAKY: map_conv_activation = 2'd1;
                default: map_conv_activation = 2'd3;
            endcase
        end
    endfunction

    always_comb begin
        current_op = S2A_OP[layer_cursor];
        current_input_count = S2A_INPUT_COUNT[layer_cursor];
        output_base = S2A_OUTPUT_ADDRESS[layer_cursor];
        output_length = S2A_OUTPUT_LENGTH_BYTES[layer_cursor];
        output_n = S2A_OUTPUT_N[layer_cursor];
        output_c = S2A_OUTPUT_C[layer_cursor];
        output_h = S2A_OUTPUT_H[layer_cursor];
        output_w = S2A_OUTPUT_W[layer_cursor];
        output_plane_elements = {48'd0, output_h} * {48'd0, output_w};
        output_batch_elements = {48'd0, output_c} * output_plane_elements;
        output_element_count = {48'd0, output_n} * output_batch_elements;
        decoded_channel = 32'd0;
        decoded_y = 32'd0;
        decoded_x = 32'd0;
        if ((output_plane_elements != 64'd0) &&
            (output_batch_elements != 64'd0) && (output_w != 16'd0)) begin
            decoded_channel = (output_element_index / output_plane_elements) % output_c;
            decoded_y = (output_element_index / {48'd0, output_w}) % output_h;
            decoded_x = output_element_index % output_w;
        end

        for (integer source_slot = 0; source_slot < 2; source_slot = source_slot + 1) begin
            source_base[source_slot] = 32'd0;
            source_length[source_slot] = 32'd0;
            source_n[source_slot] = 16'd0;
            source_c[source_slot] = 16'd0;
            source_h[source_slot] = 16'd0;
            source_w[source_slot] = 16'd0;
            source_route_start[source_slot] = 16'd0;
            source_route_end[source_slot] = 16'd0;
            if (source_slot < current_input_count) begin
                if ((layer_cursor == 6'd0) && (source_slot == 0) &&
                    (S2A_INPUT_KIND[layer_cursor][source_slot] == S2A_INPUT_NETWORK)) begin
                    source_base[source_slot] = input_base_address;
                    source_length[source_slot] = input_length_bytes;
                end else begin
                    source_base[source_slot] = S2A_INPUT_ADDRESS[layer_cursor][source_slot];
                    source_length[source_slot] = S2A_INPUT_LENGTH_BYTES[layer_cursor][source_slot];
                end
                source_n[source_slot] = S2A_INPUT_N[layer_cursor][source_slot];
                source_c[source_slot] = S2A_INPUT_C[layer_cursor][source_slot];
                source_h[source_slot] = S2A_INPUT_H[layer_cursor][source_slot];
                source_w[source_slot] = S2A_INPUT_W[layer_cursor][source_slot];
                source_route_start[source_slot] = S2A_ROUTE_CHANNEL_START[layer_cursor][source_slot];
                source_route_end[source_slot] = S2A_ROUTE_CHANNEL_END[layer_cursor][source_slot];
            end
        end

        mq_index = {16'd0, S2A_T23_MQ_BASE[layer_cursor]} + decoded_channel;
        alias_layer_index = S2A_OUTPUT_ALIAS_LAYER_INDEX[layer_cursor];
        is_alias_row = (current_op == S2A_OP_YOLO);
        alias_valid = 1'b0;
        if (is_alias_row &&
            (S2A_OUTPUT_MEMORY_WRITE_REQUIRED[layer_cursor] == 1'b0) &&
            (S2A_OUTPUT_ALLOCATION_KIND[layer_cursor] == S2A_OUTPUT_HEAD_ALIAS) &&
            (alias_layer_index < S2A_LAYER_COUNT)) begin
            alias_output_plane_elements =
                {48'd0, S2A_OUTPUT_H[alias_layer_index]} *
                {48'd0, S2A_OUTPUT_W[alias_layer_index]};
            alias_output_element_count =
                {48'd0, S2A_OUTPUT_N[alias_layer_index]} *
                {48'd0, S2A_OUTPUT_C[alias_layer_index]} *
                alias_output_plane_elements;
            alias_valid =
                (S2A_OUTPUT_TENSOR_INDEX[alias_layer_index] ==
                 S2A_OUTPUT_TENSOR_INDEX[layer_cursor]) &&
                (S2A_OUTPUT_ADDRESS[alias_layer_index] == output_base) &&
                (S2A_OUTPUT_LENGTH_BYTES[alias_layer_index] == output_length) &&
                (S2A_OUTPUT_N[alias_layer_index] == output_n) &&
                (S2A_OUTPUT_C[alias_layer_index] == output_c) &&
                (S2A_OUTPUT_H[alias_layer_index] == output_h) &&
                (S2A_OUTPUT_W[alias_layer_index] == output_w) &&
                (alias_output_element_count == output_element_count);
        end else begin
            alias_output_plane_elements = 64'd0;
            alias_output_element_count = 64'd0;
        end

        descriptor_valid = 1'b1;
        if ((S2A_LAYER_INDEX[layer_cursor] != layer_cursor) ||
            (current_input_count == 2'd0) || (current_input_count > S2A_MAX_INPUTS) ||
            (output_n != 16'd1) || (output_c == 16'd0) ||
            (output_h == 16'd0) || (output_w == 16'd0) ||
            (output_length == 32'd0) || (output_element_count == 64'd0)) begin
            descriptor_valid = 1'b0;
        end
        for (integer validate_slot = 0; validate_slot < 2; validate_slot = validate_slot + 1) begin
            if (validate_slot < current_input_count) begin
                if ((source_n[validate_slot] != 16'd1) ||
                    (source_c[validate_slot] == 16'd0) ||
                    (source_h[validate_slot] == 16'd0) ||
                    (source_w[validate_slot] == 16'd0) ||
                    (source_length[validate_slot] == 32'd0)) begin
                    descriptor_valid = 1'b0;
                end
                if ((S2A_INPUT_KIND[layer_cursor][validate_slot] == S2A_INPUT_NETWORK) &&
                    !((layer_cursor == 6'd0) && (validate_slot == 0))) begin
                    descriptor_valid = 1'b0;
                end
            end
        end
        if (is_alias_row) begin
            if (!alias_valid) descriptor_valid = 1'b0;
        end else if ((S2A_OUTPUT_MEMORY_WRITE_REQUIRED[layer_cursor] != 1'b1) ||
                     (S2A_OUTPUT_ALLOCATION_KIND[layer_cursor] != S2A_OUTPUT_OWNED)) begin
            descriptor_valid = 1'b0;
        end
        if (current_op == S2A_OP_CONV) begin
            if ((current_input_count != 2'd1) ||
                (S2A_T23_MQ_CHANNEL_COUNT[layer_cursor] != output_c) ||
                (mq_index >= S2A_CONV_CHANNEL_COUNT) ||
                (({16'd0, S2A_T23_MQ_BASE[layer_cursor]} +
                  {16'd0, S2A_T23_MQ_CHANNEL_COUNT[layer_cursor]}) >
                 S2A_CONV_CHANNEL_COUNT) ||
                (map_conv_activation(S2A_ACTIVATION[layer_cursor]) == 2'd3) ||
                (S2A_WEIGHT_LAYER_INDEX[layer_cursor] != S2A_LAYER_INDEX[layer_cursor])) begin
                descriptor_valid = 1'b0;
            end
        end else if ((current_op == S2A_OP_MAXPOOL) ||
                     (current_op == S2A_OP_UPSAMPLE)) begin
            if (current_input_count != 2'd1) descriptor_valid = 1'b0;
        end else if (current_op == S2A_OP_ROUTE) begin
            if ((current_input_count != 2'd1) && (current_input_count != 2'd2))
                descriptor_valid = 1'b0;
        end else if (!is_alias_row) begin
            descriptor_valid = 1'b0;
        end

        descriptor_fault = !descriptor_valid;

        conv_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                           descriptor_valid && (current_op == S2A_OP_CONV);
        maxpool_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                              descriptor_valid && (current_op == S2A_OP_MAXPOOL);
        route_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                            descriptor_valid && (current_op == S2A_OP_ROUTE);
        upsample_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                               descriptor_valid && (current_op == S2A_OP_UPSAMPLE);
        selected_start_ready = 1'b0;
        case (current_op)
            S2A_OP_CONV: selected_start_ready = conv_start_ready;
            S2A_OP_MAXPOOL: selected_start_ready = maxpool_start_ready;
            S2A_OP_ROUTE: selected_start_ready = route_start_ready;
            S2A_OP_UPSAMPLE: selected_start_ready = upsample_start_ready;
            default: selected_start_ready = 1'b0;
        endcase

        selected_req_valid = 1'b0;
        selected_req_write = 1'b0;
        selected_req_addr = 32'd0;
        selected_req_wdata = 32'd0;
        selected_req_rstrb = 4'd0;
        selected_req_wstrb = 4'd0;
        case (state)
            ST_WAIT_CONV: begin
                selected_req_valid = conv_req_valid;
                selected_req_write = conv_req_write;
                selected_req_addr = conv_req_addr;
                selected_req_wdata = conv_req_wdata;
                selected_req_rstrb = conv_req_rstrb;
                selected_req_wstrb = conv_req_wstrb;
            end
            ST_WAIT_MAXPOOL: begin
                selected_req_valid = maxpool_req_valid;
                selected_req_write = maxpool_req_write;
                selected_req_addr = maxpool_req_addr;
                selected_req_wdata = maxpool_req_wdata;
                selected_req_rstrb = maxpool_req_rstrb;
                selected_req_wstrb = maxpool_req_wstrb;
            end
            ST_WAIT_ROUTE: begin
                selected_req_valid = route_req_valid;
                selected_req_write = route_req_write;
                selected_req_addr = route_req_addr;
                selected_req_wdata = route_req_wdata;
                selected_req_rstrb = route_req_rstrb;
                selected_req_wstrb = route_req_wstrb;
            end
            ST_WAIT_UPSAMPLE: begin
                selected_req_valid = upsample_req_valid;
                selected_req_write = upsample_req_write;
                selected_req_addr = upsample_req_addr;
                selected_req_wdata = upsample_req_wdata;
                selected_req_rstrb = upsample_req_rstrb;
                selected_req_wstrb = upsample_req_wstrb;
            end
            default: begin end
        endcase

        mem_valid = selected_req_valid && buffer_owner_pl && !hard_reset &&
                    !abort && !response_pending;
        mem_write = mem_valid && selected_req_write;
        mem_addr = selected_req_addr;
        mem_wdata = selected_req_wdata;
        mem_rstrb = mem_valid ? selected_req_rstrb : 4'd0;
        mem_wstrb = mem_valid ? selected_req_wstrb : 4'd0;
        conv_req_ready = (state == ST_WAIT_CONV) && mem_valid && mem_ready;
        maxpool_req_ready = (state == ST_WAIT_MAXPOOL) && mem_valid && mem_ready;
        route_req_ready = (state == ST_WAIT_ROUTE) && mem_valid && mem_ready;
        upsample_req_ready = (state == ST_WAIT_UPSAMPLE) && mem_valid && mem_ready;
        memory_handshake = mem_valid && mem_ready;
        backend_memory_error_valid = memory_handshake && (mem_error_code != NONE);
        backend_memory_error_code = mem_error_code;

        conv_rsp_valid = response_pending && (response_target_latched == S2A_OP_CONV) &&
                         !hard_reset && !abort;
        maxpool_rsp_valid = response_pending && (response_target_latched == S2A_OP_MAXPOOL) &&
                            !hard_reset && !abort;
        route_rsp_valid = response_pending && (response_target_latched == S2A_OP_ROUTE) &&
                          !hard_reset && !abort;
        upsample_rsp_valid = response_pending && (response_target_latched == S2A_OP_UPSAMPLE) &&
                             !hard_reset && !abort;
        conv_rsp_data = response_data_latched;
        maxpool_rsp_data = response_data_latched;
        route_rsp_data = response_data_latched;
        upsample_rsp_data = response_data_latched;
        conv_rsp_error = response_error_latched;
        maxpool_rsp_error = response_error_latched;
        route_rsp_error = response_error_latched;
        upsample_rsp_error = response_error_latched;

        selected_result_valid = 1'b0;
        selected_result_error = INTERNAL;
        conv_result_ready = !hard_reset && (state == ST_WAIT_CONV) && conv_result_valid;
        maxpool_result_ready = !hard_reset && (state == ST_WAIT_MAXPOOL) && maxpool_result_valid;
        route_result_ready = !hard_reset && (state == ST_WAIT_ROUTE) && route_result_valid;
        upsample_result_ready = !hard_reset && (state == ST_WAIT_UPSAMPLE) && upsample_result_valid;
        case (state)
            ST_WAIT_CONV: begin
                selected_result_valid = conv_result_valid && conv_result_ready;
                selected_result_error = conv_result_error;
            end
            ST_WAIT_MAXPOOL: begin
                selected_result_valid = maxpool_result_valid && maxpool_result_ready;
                selected_result_error = maxpool_result_error;
            end
            ST_WAIT_ROUTE: begin
                selected_result_valid = route_result_valid && route_result_ready;
                selected_result_error = route_result_error;
            end
            ST_WAIT_UPSAMPLE: begin
                selected_result_valid = upsample_result_valid && upsample_result_ready;
                selected_result_error = upsample_result_error;
            end
            default: begin end
        endcase
    end

    always_comb begin
        operator_result_valid = 1'b0;
        operator_error_code = NONE;
        if (!hard_reset && !abort && buffer_owner_pl) begin
            case (state)
                ST_DISPATCH: begin
                    if ((layer_cursor >= S2A_LAYER_COUNT) || descriptor_fault ||
                        (!is_alias_row && !selected_start_ready) ||
                        (is_alias_row && !alias_valid)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = INTERNAL;
                    end else if (is_alias_row &&
                                 ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = NONE;
                    end
                end
                ST_WAIT_CONV, ST_WAIT_MAXPOOL, ST_WAIT_ROUTE, ST_WAIT_UPSAMPLE: begin
                    if (selected_result_valid &&
                        (normalize_engine_error(selected_result_error) != NONE)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = normalize_engine_error(selected_result_error);
                    end else if (selected_result_valid &&
                                 ((current_op == S2A_OP_CONV) ||
                                  (({32'd0, output_element_index} + 64'd1) >=
                                   output_element_count)) &&
                                 ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = NONE;
                    end
                end
                ST_IDLE: begin end
                default: begin
                    operator_result_valid = 1'b1;
                    operator_error_code = INTERNAL;
                end
            endcase
        end
    end

    s2a_conv_tile_engine u_conv_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .buffer_owner_pl(buffer_owner_pl),
        .start_valid(conv_start_valid), .start_ready(conv_start_ready),
        .layer_index({26'd0, S2A_LAYER_INDEX[layer_cursor]}),
        .weight_layer_index({26'd0, S2A_WEIGHT_LAYER_INDEX[layer_cursor]}),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .input_batch_count({16'd0, source_n[0]}),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .output_batch_count({16'd0, output_n}), .output_channels({16'd0, output_c}),
        .output_height({16'd0, output_h}), .output_width({16'd0, output_w}),
        .kernel_height({24'd0, S2A_KERNEL_H[layer_cursor]}),
        .kernel_width({24'd0, S2A_KERNEL_W[layer_cursor]}),
        .stride_y({24'd0, S2A_STRIDE_H[layer_cursor]}),
        .stride_x({24'd0, S2A_STRIDE_W[layer_cursor]}),
        .pad_left({24'd0, S2A_PADDING_LEFT[layer_cursor]}),
        .pad_right({24'd0, S2A_PADDING_RIGHT[layer_cursor]}),
        .pad_top({24'd0, S2A_PADDING_TOP[layer_cursor]}),
        .pad_bottom({24'd0, S2A_PADDING_BOTTOM[layer_cursor]}),
        .groups({16'd0, S2A_GROUP_COUNT[layer_cursor]}),
        .padding_value_int8($signed({{24{S2A_PADDING_VALUE_INT8[layer_cursor][7]}},
                                     S2A_PADDING_VALUE_INT8[layer_cursor]})),
        .weight_package_base_address(weight_package_base_address),
        .weight_package_length_bytes(weight_package_length_bytes),
        .quantized_weight_offset(S2A_GF8_WEIGHT_OFFSET[layer_cursor]),
        .quantized_weight_bytes(S2A_GF8_WEIGHT_BYTES[layer_cursor]),
        .output_batch(32'd0),
        .activation_mode(map_conv_activation(S2A_ACTIVATION[layer_cursor])),
        .backend_cancel(), .backend_req_valid(conv_req_valid),
        .backend_req_ready(conv_req_ready), .backend_req_write(conv_req_write),
        .backend_req_addr(conv_req_addr), .backend_req_wdata(conv_req_wdata),
        .backend_req_rstrb(conv_req_rstrb), .backend_req_wstrb(conv_req_wstrb),
        .backend_rsp_valid(conv_rsp_valid), .backend_rsp_rdata(conv_rsp_data),
        .backend_rsp_error(conv_rsp_error), .busy(),
        .result_valid(conv_result_valid), .result_ready(conv_result_ready),
        .result_error_code(conv_result_error)
    );

    s2a_maxpool_engine u_maxpool_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(maxpool_start_valid), .start_ready(maxpool_start_ready),
        .layer_index({26'd0, S2A_LAYER_INDEX[layer_cursor]}),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}), .output_base_address(output_base),
        .output_length_bytes(output_length), .output_channels({16'd0, output_c}),
        .output_height({16'd0, output_h}), .output_width({16'd0, output_w}),
        .kernel_height({24'd0, S2A_KERNEL_H[layer_cursor]}),
        .kernel_width({24'd0, S2A_KERNEL_W[layer_cursor]}),
        .stride_y({24'd0, S2A_STRIDE_H[layer_cursor]}),
        .stride_x({24'd0, S2A_STRIDE_W[layer_cursor]}),
        .darknet_padding_parameter({24'd0, S2A_MAXPOOL_DARKNET_PADDING[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .backend_cancel(maxpool_cancel), .backend_req_valid(maxpool_req_valid),
        .backend_req_ready(maxpool_req_ready), .backend_req_write(maxpool_req_write),
        .backend_req_addr(maxpool_req_addr), .backend_req_wdata(maxpool_req_wdata),
        .backend_req_rstrb(maxpool_req_rstrb), .backend_req_wstrb(maxpool_req_wstrb),
        .backend_rsp_valid(maxpool_rsp_valid), .backend_rsp_rdata(maxpool_rsp_data),
        .backend_rsp_error(maxpool_rsp_error), .result_valid(maxpool_result_valid),
        .result_ready(maxpool_result_ready), .result_tap_addresses(maxpool_tap_addresses),
        .result_output_address(maxpool_result_address), .result_value(maxpool_result_value),
        .result_error_code(maxpool_result_error)
    );

    s2a_route_engine u_route_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(route_start_valid), .start_ready(route_start_ready),
        .source_count({30'd0, current_input_count}),
        .groups({16'd0, S2A_GROUP_COUNT[layer_cursor]}),
        .group_id({16'd0, S2A_ROUTE_GROUP_ID[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .source0_base_address(source_base[0]), .source0_length_bytes(source_length[0]),
        .source0_channels({16'd0, source_c[0]}), .source0_height({16'd0, source_h[0]}),
        .source0_width({16'd0, source_w[0]}),
        .source0_channel_start({16'd0, source_route_start[0]}),
        .source0_channel_end({16'd0, source_route_end[0]}),
        .source0_multiplier_q31(S2A_ROUTE_SOURCE_MULTIPLIER_Q31[layer_cursor][0]),
        .source1_base_address(source_base[1]), .source1_length_bytes(source_length[1]),
        .source1_channels({16'd0, source_c[1]}), .source1_height({16'd0, source_h[1]}),
        .source1_width({16'd0, source_w[1]}),
        .source1_channel_start({16'd0, source_route_start[1]}),
        .source1_channel_end({16'd0, source_route_end[1]}),
        .source1_multiplier_q31(S2A_ROUTE_SOURCE_MULTIPLIER_Q31[layer_cursor][1]),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .output_channels({16'd0, output_c}), .output_height({16'd0, output_h}),
        .output_width({16'd0, output_w}),
        .backend_cancel(route_cancel), .backend_req_valid(route_req_valid),
        .backend_req_ready(route_req_ready), .backend_req_write(route_req_write),
        .backend_req_addr(route_req_addr), .backend_req_wdata(route_req_wdata),
        .backend_req_rstrb(route_req_rstrb), .backend_req_wstrb(route_req_wstrb),
        .backend_rsp_valid(route_rsp_valid), .backend_rsp_rdata(route_rsp_data),
        .backend_rsp_error(route_rsp_error), .result_valid(route_result_valid),
        .result_ready(route_result_ready), .result_source_index(route_result_source_index),
        .result_source_address(route_result_source_address),
        .result_output_address(route_result_address), .result_value(route_result_value),
        .result_error_code(route_result_error)
    );

    s2a_upsample_engine u_upsample_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(upsample_start_valid), .start_ready(upsample_start_ready),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}),
        .stride({16'd0, S2A_UPSAMPLE_STRIDE[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .backend_cancel(upsample_cancel), .backend_req_valid(upsample_req_valid),
        .backend_req_ready(upsample_req_ready), .backend_req_write(upsample_req_write),
        .backend_req_addr(upsample_req_addr), .backend_req_wdata(upsample_req_wdata),
        .backend_req_rstrb(upsample_req_rstrb), .backend_req_wstrb(upsample_req_wstrb),
        .backend_rsp_valid(upsample_rsp_valid), .backend_rsp_rdata(upsample_rsp_data),
        .backend_rsp_error(upsample_rsp_error), .result_valid(upsample_result_valid),
        .result_ready(upsample_result_ready),
        .result_source_address(upsample_result_source_address),
        .result_output_address(upsample_result_address), .result_value(upsample_result_value),
        .result_error_code(upsample_result_error)
    );

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= ST_IDLE;
            layer_cursor <= 6'd0;
            output_element_index <= 32'd0;
            response_pending <= 1'b0;
            response_data_latched <= 32'd0;
            response_error_latched <= NONE;
            response_target_latched <= S2A_OP_CONV;
        end else if (abort) begin
            state <= ST_IDLE;
            layer_cursor <= 6'd0;
            output_element_index <= 32'd0;
            response_pending <= 1'b0;
            response_data_latched <= 32'd0;
            response_error_latched <= NONE;
            response_target_latched <= S2A_OP_CONV;
        end else begin
            if (response_pending) response_pending <= 1'b0;
            if (memory_handshake) begin
                response_pending <= 1'b1;
                response_data_latched <= mem_rdata;
                response_error_latched <= mem_error_code;
                response_target_latched <= current_op;
            end

            case (state)
                ST_IDLE: begin
                    if (backend_start && buffer_owner_pl) begin
                        layer_cursor <= 6'd0;
                        output_element_index <= 32'd0;
                        state <= ST_DISPATCH;
                    end
                end
                ST_DISPATCH: begin
                    if (buffer_owner_pl) begin
                        if ((layer_cursor >= S2A_LAYER_COUNT) || descriptor_fault) begin
                            state <= ST_IDLE;
                        end else if (is_alias_row) begin
                            if (!alias_valid) begin
                                state <= ST_IDLE;
                            end else if ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT) begin
                                state <= ST_IDLE;
                            end else begin
                                layer_cursor <= layer_cursor + 6'd1;
                                output_element_index <= 32'd0;
                            end
                        end else if (!selected_start_ready) begin
                            state <= ST_IDLE;
                        end else begin
                            case (current_op)
                                S2A_OP_CONV: state <= ST_WAIT_CONV;
                                S2A_OP_MAXPOOL: state <= ST_WAIT_MAXPOOL;
                                S2A_OP_ROUTE: state <= ST_WAIT_ROUTE;
                                S2A_OP_UPSAMPLE: state <= ST_WAIT_UPSAMPLE;
                                default: begin
                                    state <= ST_IDLE;
                                end
                            endcase
                        end
                    end
                end
                ST_WAIT_CONV, ST_WAIT_MAXPOOL, ST_WAIT_ROUTE, ST_WAIT_UPSAMPLE: begin
                    if (selected_result_valid) begin
                        if (normalize_engine_error(selected_result_error) != NONE) begin
                            state <= ST_IDLE;
                        end else if ((current_op != S2A_OP_CONV) &&
                                     (({32'd0, output_element_index} + 64'd1) <
                                      output_element_count)) begin
                            output_element_index <= output_element_index + 32'd1;
                            state <= ST_DISPATCH;
                        end else if ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT) begin
                            state <= ST_IDLE;
                        end else begin
                            layer_cursor <= layer_cursor + 6'd1;
                            output_element_index <= 32'd0;
                            state <= ST_DISPATCH;
                        end
                    end
                end
                default: begin
                    state <= ST_IDLE;
                end
            endcase
        end
    end
endmodule

54e58173ec1e1a596c33296d4329053a9f78e83e blob 5431
// S2A OOC 顶层：将冻结 CSR/memory master 与 tiny416 网络后端组合。
module s2a_stage2a_core_ooc #(
    // 默认值逐项绑定 S2A-T01 冻结清单 address_map.input.address/length_bytes。
    // 权威文件：report/evidence/S2A-T01/tiny416_model_manifest.json。
    // 该清单 SHA-256：9dd2477bc6f12b556ded8bed71e5acd9efb22f6e314564973a3bbbda8279453a。
    parameter logic [31:0] INPUT_BASE_ADDRESS = 32'h00000000,
    parameter logic [31:0] INPUT_LENGTH_BYTES = 32'd519168,
    // 默认值逐项绑定同一冻结清单 address_map.weight_package.address/length_bytes。
    parameter logic [31:0] WEIGHT_PACKAGE_BASE_ADDRESS = 32'h00100000,
    parameter logic [31:0] WEIGHT_PACKAGE_LENGTH_BYTES = 32'd5903100
) (
    input  logic        clk,
    input  logic        hard_reset,

    input  logic        csr_valid,
    output logic        csr_ready,
    input  logic        csr_write,
    input  logic [7:0]  csr_addr,
    input  logic [31:0] csr_wdata,
    output logic [31:0] csr_rdata,

    output logic        mem_valid,
    input  logic        mem_ready,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code
);
    logic backend_req_valid;
    logic backend_req_ready;
    logic backend_req_write;
    logic [31:0] backend_req_addr;
    logic [31:0] backend_req_wdata;
    logic [3:0] backend_req_rstrb;
    logic [3:0] backend_req_wstrb;
    logic backend_rsp_valid;
    logic [31:0] backend_rsp_rdata;
    logic [2:0] backend_rsp_error;

    logic backend_mem_valid;
    logic backend_mem_write;
    logic [31:0] backend_mem_addr;
    logic [31:0] backend_mem_wdata;
    logic [3:0] backend_mem_rstrb;
    logic [3:0] backend_mem_wstrb;

    logic backend_start;
    logic backend_abort;
    logic buffer_owner_pl;
    logic busy;
    logic done;
    logic error;
    logic head_output_valid;
    logic operator_result_valid;
    logic [2:0] operator_error_code;
    // shell 已按同一响应错误码上报 memory error；后端诊断口仅保留内部观察，不外露为顶层引脚。
    logic backend_memory_error_valid;
    logic [2:0] backend_memory_error_code;

    // 直接请求保持有效至外部 memory 返回，runtime shell 锁存单笔请求并产生完成响应。
    // 因此后端的 ready/data/error 接收端使用 shell 的响应通道，而非请求入队 ready。
    s2a_runtime_shell u_runtime_shell (
        .clk(clk),
        .hard_reset(hard_reset),
        .csr_valid(csr_valid),
        .csr_ready(csr_ready),
        .csr_write(csr_write),
        .csr_addr(csr_addr),
        .csr_wdata(csr_wdata),
        .csr_rdata(csr_rdata),
        .backend_req_valid(backend_req_valid),
        .backend_req_ready(backend_req_ready),
        .backend_req_write(backend_req_write),
        .backend_req_addr(backend_req_addr),
        .backend_req_wdata(backend_req_wdata),
        .backend_req_rstrb(backend_req_rstrb),
        .backend_req_wstrb(backend_req_wstrb),
        .backend_rsp_valid(backend_rsp_valid),
        .backend_rsp_rdata(backend_rsp_rdata),
        .backend_rsp_error(backend_rsp_error),
        .operator_result_valid(operator_result_valid),
        .operator_error_code(operator_error_code),
        .backend_start(backend_start),
        .backend_abort(backend_abort),
        .busy(busy),
        .done(done),
        .error(error),
        .pl_owns_buffers(buffer_owner_pl),
        .head_output_valid(head_output_valid),
        .mem_valid(mem_valid),
        .mem_ready(mem_ready),
        .mem_write(mem_write),
        .mem_addr(mem_addr),
        .mem_wdata(mem_wdata),
        .mem_rstrb(mem_rstrb),
        .mem_wstrb(mem_wstrb),
        .mem_rdata(mem_rdata),
        .mem_error_code(mem_error_code)
    );

    // 后端请求经 shell 的单 outstanding master 发往顶层 memory 总线。
    // shell 的 backend_req_ready 仅负责入队；后端事务在 backend_rsp_valid 时完成。
    assign backend_req_valid = backend_mem_valid;
    assign backend_req_write = backend_mem_write;
    assign backend_req_addr = backend_mem_addr;
    assign backend_req_wdata = backend_mem_wdata;
    assign backend_req_rstrb = backend_mem_rstrb;
    assign backend_req_wstrb = backend_mem_wstrb;

    s2a_network_backend u_network_backend (
        .clk(clk),
        .hard_reset(hard_reset),
        .abort(backend_abort),
        .backend_start(backend_start),
        .buffer_owner_pl(buffer_owner_pl),
        .input_base_address(INPUT_BASE_ADDRESS),
        .input_length_bytes(INPUT_LENGTH_BYTES),
        .weight_package_base_address(WEIGHT_PACKAGE_BASE_ADDRESS),
        .weight_package_length_bytes(WEIGHT_PACKAGE_LENGTH_BYTES),
        .mem_valid(backend_mem_valid),
        .mem_write(backend_mem_write),
        .mem_addr(backend_mem_addr),
        .mem_wdata(backend_mem_wdata),
        .mem_rstrb(backend_mem_rstrb),
        .mem_wstrb(backend_mem_wstrb),
        .mem_ready(backend_rsp_valid),
        .mem_rdata(backend_rsp_rdata),
        .mem_error_code(backend_rsp_error),
        .backend_memory_error_valid(backend_memory_error_valid),
        .backend_memory_error_code(backend_memory_error_code),
        .operator_result_valid(operator_result_valid),
        .operator_error_code(operator_error_code)
    );
endmodule

d0db34b36c2394dddf807fc08225a46611ec181f blob 19157
# S2B-T13：隔离目录重建全模型 PS/PL 平台；不启动综合、实现或板卡操作。
namespace eval ::s2b_inference_platform {
    variable version 0.1.12
    variable part xc7z020clg400-2
    variable bd_name s2b_inference
    variable rtl_sources {
        src/s2a_network_descriptor_pkg.sv
        src/s2b_maxpool_geometry.sv
        src/int8_maxpool_window.sv
        src/s2b_route_query.sv
        src/int8_upsample_query.sv
        src/s2b_conv_tile_engine.sv
        src/s2b_maxpool_engine.sv
        src/s2b_route_engine.sv
        src/s2b_upsample_engine.sv
        src/s2b_network_backend.sv
        src/s2a_memory_master.sv
        src/s2a_runtime_shell.sv
        src/s2b_stage2b_core.sv
        src/s2a_control_csr.sv
        src/s2b_request_guard.sv
        src/s2b_hp0_word_adapter.sv
        src/s2b_control_csr.sv
        src/s2b_inference_top.sv
    }
}

proc ::s2b_inference_platform::literal_absolute {path} {
    # 拒绝工具可能折叠的点组件、重复分隔符和 Windows 非法尾部名称。
    if {[file pathtype $path] ne "absolute" ||
        [regexp {(^|[/\\])\.{1,2}([/\\]|$)} $path] ||
        [regexp {[/\\]{2}} $path] || [regexp {[ .]$} $path]} {
        error "PATH_LITERAL_FAIL:$path"
    }
    return [file split $path]
}

proc ::s2b_inference_platform::exact_existing {path kind} {
    set parts [literal_absolute $path]
    set current [lindex $parts 0]
    set checked [list $current]
    foreach component [lrange $parts 1 end] {
        if {![file isdirectory $current]} {error "PATH_PARENT_TYPE_FAIL:$current"}
        set names [glob -nocomplain -directory $current -tails -- * .*]
        if {[lsearch -exact $names $component] < 0} {error "PATH_EXACT_NAME_FAIL:$path:$component"}
        set current [file join $current $component]
        file lstat $current info
        if {$info(type) eq "link"} {error "PATH_LINK_FAIL:$current"}
        lappend checked $current
    }
    if {($kind eq "directory" && ![file isdirectory $current]) ||
        ($kind eq "file" && ![file isfile $current])} {error "PATH_TARGET_TYPE_FAIL:$path:$kind"}
    return $checked
}

proc ::s2b_inference_platform::new_directory {path} {
    literal_absolute $path
    set name [file tail $path]
    if {$name eq "" || [regexp {[<>:"/\\|?*\x00-\x1f]} $name] || [regexp {[ .]$} $name]} {
        error "PATH_NEW_NAME_FAIL:$path"
    }
    set checked [exact_existing [file dirname $path] directory]
    # exists 会同时拒绝 Windows 大小写别名，lstat 也拒绝悬空链接占据名称。
    if {[file exists $path] || ![catch {file lstat $path info}]} {error "PATH_ALREADY_EXISTS:$path"}
    return $checked
}

proc ::s2b_inference_platform::reject_overlap {project_dir evidence_dir} {
    set a [literal_absolute $project_dir]
    set b [literal_absolute $evidence_dir]
    if {$::tcl_platform(platform) eq "windows"} {
        set a [string tolower $a]
        set b [string tolower $b]
    }
    set count [expr {min([llength $a], [llength $b])}]
    if {[lrange $a 0 [expr {$count-1}]] eq [lrange $b 0 [expr {$count-1}]]} {
        error "PATH_OUTPUT_OVERLAP:$project_dir:$evidence_dir"
    }
}

proc ::s2b_inference_platform::reject_reparse {components} {
    if {$::tcl_platform(platform) ne "windows"} {return}
    # Tcl 的 lstat 不能可靠识别所有 junction/reparse 类型；固定只读 .NET 调用补核。
    # 路径仅作为 Base64 UTF-8 数据传入，绝不插入可执行表达式。
    set payload [binary encode base64 -maxlen 0 [encoding convertto utf-8 [join [lsort -unique $components] \n]]]
    set script [string map [list @DATA@ $payload] {
        $ErrorActionPreference = 'Stop'
        $taskPaths = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('@DATA@')).Split([char]10)
        foreach ($taskPath in $taskPaths) {
            $taskAttributes = [IO.File]::GetAttributes($taskPath)
            if (($taskAttributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                throw 'PATH_REPARSE_FAIL'
            }
        }
        Write-Output 'PATH_REPARSE:OK'
    }]
    set result [exec powershell.exe -NoLogo -NoProfile -NonInteractive -Command $script]
    if {[string trim $result] ne "PATH_REPARSE:OK"} {error "PATH_REPARSE_CHECK_FAIL:$result"}
}

proc ::s2b_inference_platform::path_preflight {repo_root project_dir evidence_dir helper native_log proof review} {
    set checked [exact_existing $repo_root directory]
    reject_overlap $project_dir $evidence_dir
    set checked [concat $checked [new_directory $project_dir] [new_directory $evidence_dir]]
    set files [list $helper $native_log [file join $repo_root vivado/s2b_ps_platform.tcl] \
        [file join $repo_root verification/check_s2b_inference_platform.py]]
    if {$proof ne "" || $review ne ""} {
        if {$proof eq "" || $review eq ""} {error "可见性证明和独立审查必须成对提供"}
        lappend files $proof $review
    }
    foreach path $files {set checked [concat $checked [exact_existing $path file]]}
    reject_reparse $checked
    return "PATH_PREFLIGHT:OK"
}

proc ::s2b_inference_platform::capture {evidence_dir name script expected} {
    set receipt [ipcfg::capture [file join $evidence_dir ${name}.tcldict] $script $expected]
    puts $receipt
    if {[dict get $receipt status] ne "OK"} {error "PLATFORM_CAPTURE_FAIL:$name"}
}

proc ::s2b_inference_platform::create_ip {evidence_dir name vlnv requested} {
    capture $evidence_dir ${name}_configure [list ipcfg::create_cell_cfg $vlnv $name $requested] {SUCCESS:}
    set stuck [ipcfg::verify_stuck $name $requested]
    if {[llength $stuck]} {error "PLATFORM_CONFIG_READBACK_FAIL:$name:$stuck"}
    ipcfg::write_evidence [file join $evidence_dir ${name}_readback.tcldict] \
        [dict create requested $requested actual [ipcfg::snapshot $name [dict keys $requested]]]
}

proc ::s2b_inference_platform::construct {evidence_dir visibility} {
    # 复用冻结 PS-only DDR/UART 请求，PL 侧只增加当前接口所需的六个配置。
    set ps_request [dict replace [::s2b_ps_platform::requested] \
        CONFIG.PCW_USE_M_AXI_GP0 1 CONFIG.PCW_USE_S_AXI_HP0 1 \
        CONFIG.PCW_S_AXI_HP0_DATA_WIDTH 64 CONFIG.PCW_EN_CLK0_PORT 1 \
        CONFIG.PCW_EN_RST0_PORT 1 CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ 50]
    create_ip $evidence_dir ps7 xilinx.com:ip:processing_system7 $ps_request
    create_ip $evidence_dir axi_gp0_lite xilinx.com:ip:axi_protocol_converter \
        [dict create CONFIG.SI_PROTOCOL AXI3 CONFIG.MI_PROTOCOL AXI4LITE \
            CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 32 CONFIG.ID_WIDTH 12 CONFIG.TRANSLATION_MODE 0]
    create_ip $evidence_dir rst_fclk0 xilinx.com:ip:proc_sys_reset \
        [dict create CONFIG.C_EXT_RESET_HIGH 0 CONFIG.C_AUX_RESET_HIGH 1]
    create_ip $evidence_dir const_zero xilinx.com:ip:xlconstant \
        [dict create CONFIG.CONST_WIDTH 1 CONFIG.CONST_VAL 0]
    create_ip $evidence_dir const_one xilinx.com:ip:xlconstant \
        [dict create CONFIG.CONST_WIDTH 1 CONFIG.CONST_VAL 1]
    capture $evidence_dir connect [list ::s2b_inference_platform::connect $visibility] {CONNECT:OK}
    return "CONSTRUCT:OK"
}

proc ::s2b_inference_platform::externalize_unique {pin_path name} {
    # 外口创建命令只保证副作用，返回值可能为空；从真实接口网查询新增端点。
    set pin [get_bd_intf_pins $pin_path]
    if {[llength $pin] != 1} {error "EXTERNAL_SOURCE_PIN_COUNT_FAIL:$pin_path"}
    set before [get_bd_intf_ports]
    make_bd_intf_pins_external $pin
    set nets [get_bd_intf_nets -of_objects $pin]
    if {[llength $nets] != 1} {error "EXTERNAL_INTERFACE_NET_COUNT_FAIL:$pin_path:$nets"}
    set endpoints [get_bd_intf_ports -of_objects $nets]
    set created {}
    foreach port $endpoints {
        if {[lsearch -exact $before $port] < 0} {lappend created $port}
    }
    if {[llength $endpoints] != 1 || [llength $created] != 1} {
        error "EXTERNAL_NEW_ENDPOINT_COUNT_FAIL:$pin_path:$endpoints:$created"
    }
    set_property name $name [lindex $created 0]
    set renamed [get_bd_intf_ports -of_objects $nets]
    if {[llength $renamed] != 1 || [file tail $renamed] ne $name} {
        error "EXTERNAL_ENDPOINT_NAME_READBACK_FAIL:$pin_path:$renamed"
    }
    return $renamed
}

proc ::s2b_inference_platform::connect {visibility} {
    create_bd_cell -type module -reference s2b_inference_top infer
    set_property CONFIG.PROFILE_VISIBILITY_PROVEN $visibility [get_bd_cells infer]
    if {[get_property CONFIG.PROFILE_VISIBILITY_PROVEN [get_bd_cells infer]] != $visibility} {
        error "VISIBILITY_PARAMETER_READBACK_FAIL"
    }
    connect_bd_intf_net [get_bd_intf_pins ps7/M_AXI_GP0] [get_bd_intf_pins axi_gp0_lite/S_AXI]
    connect_bd_intf_net [get_bd_intf_pins axi_gp0_lite/M_AXI] [get_bd_intf_pins infer/S_AXI]
    # HP0 原生 AXI3 直接连接；任何额外 bridge/buffer 都使当前可见性证明失效。
    connect_bd_intf_net [get_bd_intf_pins infer/M_AXI] [get_bd_intf_pins ps7/S_AXI_HP0]
    connect_bd_net [get_bd_pins ps7/FCLK_CLK0] \
        [get_bd_pins ps7/M_AXI_GP0_ACLK] [get_bd_pins ps7/S_AXI_HP0_ACLK] \
        [get_bd_pins axi_gp0_lite/aclk] [get_bd_pins rst_fclk0/slowest_sync_clk] [get_bd_pins infer/clk]
    # FCLK reset 是冷初始化输入，软件不得在运行期单独重置 PL。
    connect_bd_net [get_bd_pins ps7/FCLK_RESET0_N] [get_bd_pins rst_fclk0/ext_reset_in]
    connect_bd_net [get_bd_pins const_zero/dout] [get_bd_pins rst_fclk0/aux_reset_in] [get_bd_pins rst_fclk0/mb_debug_sys_rst]
    # 时钟直接来自 PS FCLK0，无额外 MMCM；此常量不是可见性证明。
    connect_bd_net [get_bd_pins const_one/dout] [get_bd_pins rst_fclk0/dcm_locked]
    connect_bd_net [get_bd_pins rst_fclk0/peripheral_aresetn] \
        [get_bd_pins axi_gp0_lite/aresetn] [get_bd_pins infer/cold_resetn]
    externalize_unique ps7/DDR DDR
    externalize_unique ps7/FIXED_IO FIXED_IO
    set control_segments [get_bd_addr_segs -of_objects [get_bd_intf_pins infer/S_AXI]]
    if {[llength $control_segments] != 1} {error "CONTROL_SEGMENT_COUNT_FAIL:$control_segments"}
    assign_bd_address -offset 0x43C00000 -range 0x00010000 \
        -target_address_space [get_bd_addr_spaces ps7/Data] $control_segments
    # PS 可寻址 1 GiB 不等于 PL 白名单；adapter/guard 限制逐对象物理范围。
    assign_bd_address -offset 0x00000000 -range 0x40000000 \
        -target_address_space [get_bd_addr_spaces infer/M_AXI] [get_bd_addr_segs ps7/S_AXI_HP0/HP0_DDR_LOWOCM]
    return "CONNECT:OK"
}

proc ::s2b_inference_platform::assert_property {object property expected} {
    set actual [get_property $property $object]
    if {$actual ne $expected} {error "PLATFORM_AUDIT_FAIL:$object:$property:expected=$expected:actual=$actual"}
}

proc ::s2b_inference_platform::physical_port_members {} {
    # get_bd_ports 包含接口的合法标量成员；唯一允许集合是两接口成员的并集。
    set externals {}
    set members {}
    set union {}
    foreach port [get_bd_intf_ports] {
        set name [file tail $port]
        lappend externals $name
        set scalar [get_bd_ports -of_objects $port]
        if {![llength $scalar]} {error "PHYSICAL_INTERFACE_MEMBERS_EMPTY:$port"}
        dict set members $name [lsort $scalar]
        set union [concat $union $scalar]
    }
    if {[lsort $externals] ne [lsort [list DDR FIXED_IO]]} {
        error "PHYSICAL_INTERFACE_SET_FAIL:$externals"
    }
    set actual [lsort [get_bd_ports]]
    set expected [lsort -unique $union]
    if {$actual ne $expected} {error "PHYSICAL_SCALAR_MEMBERS_FAIL:actual=$actual:expected=$expected"}
    return [dict create interfaces [lsort $externals] members $members scalar_ports $actual]
}

proc ::s2b_inference_platform::audit {evidence_dir visibility} {
    variable part
    assert_property [current_project] PART $part
    foreach {pin protocol data id} {
        ps7/M_AXI_GP0 AXI3 32 12
        axi_gp0_lite/S_AXI AXI3 32 12
        axi_gp0_lite/M_AXI AXI4LITE 32 0
        infer/S_AXI AXI4LITE 32 0
        infer/M_AXI AXI3 64 6
        ps7/S_AXI_HP0 AXI3 64 6
    } {
        set object [get_bd_intf_pins $pin]
        assert_property $object CONFIG.PROTOCOL $protocol
        assert_property $object CONFIG.ADDR_WIDTH 32
        assert_property $object CONFIG.DATA_WIDTH $data
        if {$protocol eq "AXI3"} {assert_property $object CONFIG.ID_WIDTH $id}
    }
    set hp_net [get_bd_intf_nets -of_objects [get_bd_intf_pins infer/M_AXI]]
    set endpoints [lsort [get_bd_intf_pins -of_objects $hp_net]]
    if {$endpoints ne [lsort [concat [get_bd_intf_pins infer/M_AXI] [get_bd_intf_pins ps7/S_AXI_HP0]]]} {
        error "DIRECT_HP0_AUDIT_FAIL:$endpoints"
    }
    set physical_ports [physical_port_members]
    set expected_cells [lsort [list /ps7 /axi_gp0_lite /rst_fclk0 /const_zero /const_one /infer]]
    if {[lsort [get_bd_cells]] ne $expected_cells} {error "PLATFORM_CELL_CLOSURE_FAIL"}
    assert_property [get_bd_pins ps7/FCLK_CLK0] CONFIG.FREQ_HZ 50000000
    assert_property [get_bd_pins infer/clk] CONFIG.ASSOCIATED_BUSIF S_AXI:M_AXI
    set clock_net [get_bd_nets -of_objects [get_bd_pins ps7/FCLK_CLK0]]
    foreach pin {ps7/M_AXI_GP0_ACLK ps7/S_AXI_HP0_ACLK axi_gp0_lite/aclk rst_fclk0/slowest_sync_clk infer/clk} {
        if {[get_bd_nets -of_objects [get_bd_pins $pin]] ne $clock_net} {error "CLOCK_DOMAIN_AUDIT_FAIL:$pin"}
    }
    set reset_net [get_bd_nets -of_objects [get_bd_pins rst_fclk0/peripheral_aresetn]]
    foreach pin {axi_gp0_lite/aresetn infer/cold_resetn} {
        if {[get_bd_nets -of_objects [get_bd_pins $pin]] ne $reset_net} {error "RESET_DOMAIN_AUDIT_FAIL:$pin"}
    }
    set control_mappings 0
    foreach seg [get_bd_addr_segs -of_objects [get_bd_addr_spaces ps7/Data]] {
        if {[get_property OFFSET $seg] == 0x43C00000 && [get_property RANGE $seg] == 0x00010000} {
            incr control_mappings
        }
    }
    if {$control_mappings != 1} {error "CONTROL_ADDRESS_AUDIT_FAIL:$control_mappings"}
    set data [dict create version [version -short] part $part requested_part_literal XC7Z020-2CLG400I \
        visibility_parameter $visibility physical_ports $physical_ports \
        interfaces {} scalar_pins {} nets {} addresses {} part_properties {}]
    foreach property [list_property [get_parts $part]] {
        if {[regexp -nocase {temp|grade|speed|package} $property]} {
            dict set data part_properties $property [get_property $property [get_parts $part]]
        }
    }
    foreach pin [get_bd_intf_pins -of_objects [get_bd_cells]] {
        foreach property {MODE CONFIG.PROTOCOL CONFIG.ADDR_WIDTH CONFIG.DATA_WIDTH CONFIG.ID_WIDTH} {
            if {[lsearch -exact [list_property $pin] $property] >= 0} {
                dict set data interfaces $pin $property [get_property $property $pin]
            }
        }
    }
    foreach pin {infer/clk infer/cold_resetn ps7/FCLK_CLK0 rst_fclk0/peripheral_aresetn} {
        set object [get_bd_pins $pin]
        foreach property {TYPE DIR CONFIG.FREQ_HZ CONFIG.ASSOCIATED_BUSIF CONFIG.ASSOCIATED_RESET CONFIG.POLARITY} {
            if {[lsearch -exact [list_property $object] $property] >= 0} {
                dict set data scalar_pins $pin $property [get_property $property $object]
            }
        }
    }
    foreach net [get_bd_nets] {dict set data nets $net [get_bd_pins -of_objects $net]}
    foreach seg [get_bd_addr_segs] {
        dict set data addresses $seg [list OFFSET [get_property OFFSET $seg] RANGE [get_property RANGE $seg]]
    }
    ipcfg::write_evidence [file join $evidence_dir platform_readback.tcldict] $data
    return "AUDIT:OK"
}

proc ::s2b_inference_platform::products {evidence_dir} {
    variable bd_name
    set bd_file [get_files */${bd_name}.bd]
    if {[llength $bd_file] != 1} {error "PRODUCTS_BD_OBJECT_COUNT_FAIL:$bd_file"}
    generate_target all $bd_file
    # 返回值只表示创建信息；由官方 import 副作用导入，再查询唯一文件对象。
    make_wrapper -files $bd_file -top -import
    set wrapper [get_files */${bd_name}_wrapper.v]
    if {[llength $wrapper] != 1} {error "PRODUCTS_WRAPPER_OBJECT_COUNT_FAIL:$wrapper"}
    set_property top ${bd_name}_wrapper [current_fileset]
    update_compile_order -fileset sources_1
    write_bd_tcl [file join $evidence_dir s2b_inference_bd.tcl]
    file copy [get_property NAME $bd_file] [file join $evidence_dir s2b_inference.bd]
    write_hw_platform -fixed [file join $evidence_dir s2b_inference_no_bit.xsa]
    return "PRODUCTS:OK"
}

proc ::s2b_inference_platform::run {repo_root project_dir evidence_dir helper native_log {proof ""} {review ""} {review_sha256 ""}} {
    variable part
    variable bd_name
    variable rtl_sources
    # 必须在无项目的归属明确 Tcl 会话调用，不触碰用户已打开的 GUI 项目。
    if {[current_project -quiet] ne ""} {error "已有打开项目，停止创建"}
    puts [path_preflight $repo_root $project_dir $evidence_dir $helper $native_log $proof $review]
    if {($proof ne "" || $review ne "") && ![regexp {^[0-9a-f]{64}$} $review_sha256]} {
        error "独立审查原件固定SHA-256必需"
    }
    if {$proof eq "" && $review eq "" && $review_sha256 ne ""} {error "不能单独提供审查哈希"}
    if {[llength [get_parts $part]] != 1} {error "精确器件不存在：$part"}
    uplevel #0 [list source -notrace [file join $repo_root vivado/s2b_ps_platform.tcl]]
    if {![llength [info commands ::ipcfg::help]]} {uplevel #0 [list source -notrace $helper]}
    set ::ipcfg::native_log_path $native_log
    set python [ipcfg::python_status]
    if {![string match {PYTHON:OK *} $python]} {error $python}
    puts $python
    puts [ipcfg::python_exec -c {import argparse, hashlib, json, pathlib, re, sys; print("PYTHON_IMPORTS:OK")}]
    set checker [file join $repo_root verification/check_s2b_inference_platform.py]
    puts [ipcfg::python_script $checker --root $repo_root]
    set visibility 0
    if {$proof ne "" || $review ne ""} {
        if {$proof eq "" || $review eq ""} {error "可见性证明和独立审查必须成对提供"}
        set result [ipcfg::python_script $checker --root $repo_root --visibility-proof $proof \
            --review $review --review-sha256 $review_sha256]
        if {$result ne "VISIBILITY_PROFILE:BINDINGS_VERIFIED"} {error "VISIBILITY_BINDING_CHECK_FAIL:$result"}
        set visibility 1
    }
    file mkdir $evidence_dir
    file mkdir $project_dir
    create_project s2b_inference_candidate $project_dir -part $part
    set_property target_language Verilog [current_project]
    foreach relative $rtl_sources {add_files [file join $repo_root $relative]}
    update_compile_order -fileset sources_1
    create_bd_design $bd_name
    puts [construct $evidence_dir $visibility]
    capture $evidence_dir validate {validate_bd_design -force; save_bd_design; set status VALIDATE:OK} {VALIDATE:OK}
    capture $evidence_dir audit [list ::s2b_inference_platform::audit $evidence_dir $visibility] {AUDIT:OK}
    capture $evidence_dir products [list ::s2b_inference_platform::products $evidence_dir] {PRODUCTS:OK}
    return "INFERENCE_PLATFORM:BUILD_CANDIDATE_OK"
}

fa8e17d47bcc9e2b1a2bbf2a0315243a598fea05 blob 12717
# S2B-T04：仅创建 PS7 的 UART/DDR 离线候选，不连接 PL AXI，不操作硬件。
# 厂商字段和候选限制见 board/ps_platform_fields.json 与 board/ps_platform.md。

namespace eval ::s2b_ps_platform {
    variable version 1.0.1
    variable cell ps7
    variable bd_name s2b_ps_only
    variable part xc7z020clg400-2
}

proc ::s2b_ps_platform::fresh_dir {path} {
    # 按传入字面路径核验父目录；不修正分隔符，不覆盖任何已有目标。
    if {[file pathtype $path] ne "absolute"} {error "绝对路径必需：$path"}
    if {![file isdirectory [file dirname $path]]} {error "父目录不存在：$path"}
    if {[file exists $path]} {error "拒绝复用已有目录：$path"}
    file mkdir $path
    return $path
}

proc ::s2b_ps_platform::write_new {path text} {
    # EXCL 保证已有报告或导出文件不可被悄悄覆盖。
    set channel [open $path {WRONLY CREAT EXCL}]
    fconfigure $channel -encoding utf-8 -translation lf
    try {puts $channel $text} finally {close $channel}
}

proc ::s2b_ps_platform::prepare {project_dir} {
    variable part
    variable bd_name
    if {[current_project -quiet] ne ""} {error "已有打开项目，停止创建"}
    if {[llength [get_parts $part]] != 1} {error "精确器件不存在：$part"}
    fresh_dir $project_dir
    create_project s2b_ps_candidate $project_dir -part $part
    set_property target_language Verilog [current_project]
    create_bd_design $bd_name
    return "PREPARE:OK"
}

proc ::s2b_ps_platform::requested {} {
    # 新版 V2.2 兼容 MT41J256M16RE-125；0.25ns 延时仅为旧例程候选。
    # 不导入旧工具的封装延时；由当前精确器件在 Vivado 2026.1 派生。
    return [dict create \
        CONFIG.PCW_IMPORT_BOARD_PRESET {None} \
        CONFIG.PCW_CRYSTAL_PERIPHERAL_FREQMHZ {33.333333} \
        CONFIG.PCW_PRESET_BANK0_VOLTAGE {LVCMOS 3.3V} \
        CONFIG.PCW_PRESET_BANK1_VOLTAGE {LVCMOS 1.8V} \
        CONFIG.PCW_UART0_PERIPHERAL_ENABLE {0} \
        CONFIG.PCW_UART1_PERIPHERAL_ENABLE {1} \
        CONFIG.PCW_UART1_UART1_IO {MIO 48 .. 49} \
        CONFIG.PCW_UART1_GRP_FULL_ENABLE {0} \
        CONFIG.PCW_UART_PERIPHERAL_FREQMHZ {100} \
        CONFIG.PCW_MIO_48_IOTYPE {LVCMOS 1.8V} \
        CONFIG.PCW_MIO_49_IOTYPE {LVCMOS 1.8V} \
        CONFIG.PCW_UIPARAM_DDR_ENABLE {1} \
        CONFIG.PCW_UIPARAM_DDR_PARTNO {MT41J256M16 RE-125} \
        CONFIG.PCW_UIPARAM_DDR_MEMORY_TYPE {DDR 3} \
        CONFIG.PCW_UIPARAM_DDR_BUS_WIDTH {32 Bit} \
        CONFIG.PCW_UIPARAM_DDR_DRAM_WIDTH {16 Bits} \
        CONFIG.PCW_UIPARAM_DDR_DEVICE_CAPACITY {4096 MBits} \
        CONFIG.PCW_UIPARAM_DDR_ROW_ADDR_COUNT {15} \
        CONFIG.PCW_UIPARAM_DDR_COL_ADDR_COUNT {10} \
        CONFIG.PCW_UIPARAM_DDR_BANK_ADDR_COUNT {3} \
        CONFIG.PCW_UIPARAM_DDR_FREQ_MHZ {533.333333} \
        CONFIG.PCW_UIPARAM_DDR_ECC {Disabled} \
        CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY0 {0.25} \
        CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY1 {0.25} \
        CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY2 {0.25} \
        CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY3 {0.25} \
        CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_0 {0.0} \
        CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_1 {0.0} \
        CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_2 {0.0} \
        CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_3 {0.0} \
        CONFIG.PCW_UIPARAM_DDR_TRAIN_WRITE_LEVEL {1} \
        CONFIG.PCW_UIPARAM_DDR_TRAIN_READ_GATE {1} \
        CONFIG.PCW_UIPARAM_DDR_TRAIN_DATA_EYE {1} \
        CONFIG.PCW_USE_M_AXI_GP0 {0} \
        CONFIG.PCW_USE_M_AXI_GP1 {0} \
        CONFIG.PCW_USE_S_AXI_GP0 {0} \
        CONFIG.PCW_USE_S_AXI_GP1 {0} \
        CONFIG.PCW_USE_S_AXI_HP0 {0} \
        CONFIG.PCW_USE_S_AXI_HP1 {0} \
        CONFIG.PCW_USE_S_AXI_HP2 {0} \
        CONFIG.PCW_USE_S_AXI_HP3 {0} \
        CONFIG.PCW_USE_S_AXI_ACP {0} \
        CONFIG.PCW_EN_CLK0_PORT {0} \
        CONFIG.PCW_EN_CLK1_PORT {0} \
        CONFIG.PCW_EN_CLK2_PORT {0} \
        CONFIG.PCW_EN_CLK3_PORT {0} \
        CONFIG.PCW_EN_RST0_PORT {0} \
        CONFIG.PCW_EN_RST1_PORT {0} \
        CONFIG.PCW_EN_RST2_PORT {0} \
        CONFIG.PCW_EN_RST3_PORT {0}]
}

proc ::s2b_ps_platform::configure {evidence_dir} {
    variable cell
    if {![file isdirectory $evidence_dir]} {error "证据目录不存在"}
    foreach name {baseline.tcldict intent.tcldict} {
        if {[file exists [file join $evidence_dir $name]]} {error "拒绝覆盖配置证据：$name"}
    }
    if {![ipcfg::vlnv_ok xilinx.com:ip:processing_system7]} {error "PS7 不支持当前器件"}
    set requested [requested]
    # 独立默认单元提供真实默认值；读取后删除，不遗留在交付 BD。
    set default_result [ipcfg::create_cell xilinx.com:ip:processing_system7 defaults]
    if {![string match {SUCCESS:*} $default_result]} {error $default_result}
    set baseline [ipcfg::snapshot defaults [dict keys $requested]]
    ipcfg::write_evidence [file join $evidence_dir baseline.tcldict] $baseline
    puts [ipcfg::cleanup defaults]
    set result [ipcfg::create_cell_cfg xilinx.com:ip:processing_system7 $cell $requested]
    if {![string match {SUCCESS:*} $result]} {error $result}
    set stuck [ipcfg::verify_stuck $cell $requested]
    if {[llength $stuck]} {error "STUCK_FAIL:$stuck"}
    set reqmap {}
    dict for {key want} $requested {lappend reqmap $key $want [dict get $baseline $key]}
    set intent [ipcfg::verify_intent $cell $reqmap 0]
    if {[llength $intent]} {error "INTENT_FAIL:$intent"}
    ipcfg::write_evidence [file join $evidence_dir intent.tcldict] [dict create baseline $baseline requested $requested audit [ipcfg::audit_intent $cell $reqmap]]
    return "CONFIG:OK"
}

proc ::s2b_ps_platform::validate {} {
    variable cell
    make_bd_intf_pins_external [get_bd_intf_pins $cell/DDR]
    make_bd_intf_pins_external [get_bd_intf_pins $cell/FIXED_IO]
    validate_bd_design -force
    save_bd_design
    return "VALIDATE:OK"
}

proc ::s2b_ps_platform::products {} {
    variable bd_name
    set bd_file [get_files */${bd_name}.bd]
    generate_target all $bd_file
    set wrapper [make_wrapper -files $bd_file -top]
    if {![llength [get_files -quiet $wrapper]]} {add_files $wrapper}
    set_property top ${bd_name}_wrapper [current_fileset]
    update_compile_order -fileset sources_1
    return "PRODUCTS:OK"
}

proc ::s2b_ps_platform::export {evidence_dir} {
    variable cell
    variable bd_name
    set ps [get_bd_cells $cell]
    set bd_file [get_files */${bd_name}.bd]
    foreach name {s2b_ps_only.xsa s2b_ps_only.bd readback.tcldict readback.tsv interfaces.tcldict} {
        if {[file exists [file join $evidence_dir $name]]} {error "拒绝覆盖导出证据：$name"}
    }
    # 导出硬件描述但不请求位流；不存在任何综合、实现或器件操作。
    set xsa [file join $evidence_dir s2b_ps_only.xsa]
    if {[file exists $xsa]} {error "拒绝覆盖 XSA：$xsa"}
    write_hw_platform -fixed $xsa
    set bd_copy [file join $evidence_dir s2b_ps_only.bd]
    if {[file exists $bd_copy]} {error "拒绝覆盖 BD：$bd_copy"}
    file copy $bd_file $bd_copy
    set keys [concat [dict keys [requested]] {
        CONFIG.PCW_EN_DDR CONFIG.PCW_EN_UART1
        CONFIG.PCW_UART1_BASEADDR CONFIG.PCW_UART1_HIGHADDR
        CONFIG.PCW_MIO_48_DIRECTION CONFIG.PCW_MIO_49_DIRECTION
        CONFIG.PCW_UIPARAM_DDR_CL CONFIG.PCW_UIPARAM_DDR_CWL
        CONFIG.PCW_UIPARAM_DDR_SPEED_BIN CONFIG.PCW_UIPARAM_ACT_DDR_FREQ_MHZ
        CONFIG.PCW_UIPARAM_DDR_T_FAW CONFIG.PCW_UIPARAM_DDR_T_RAS_MIN
        CONFIG.PCW_UIPARAM_DDR_T_RC CONFIG.PCW_UIPARAM_DDR_T_RCD CONFIG.PCW_UIPARAM_DDR_T_RP
        CONFIG.PCW_PACKAGE_DDR_BOARD_DELAY0 CONFIG.PCW_PACKAGE_DDR_BOARD_DELAY1
        CONFIG.PCW_PACKAGE_DDR_BOARD_DELAY2 CONFIG.PCW_PACKAGE_DDR_BOARD_DELAY3
        CONFIG.PCW_PACKAGE_DDR_DQS_TO_CLK_DELAY_0 CONFIG.PCW_PACKAGE_DDR_DQS_TO_CLK_DELAY_1
        CONFIG.PCW_PACKAGE_DDR_DQS_TO_CLK_DELAY_2 CONFIG.PCW_PACKAGE_DDR_DQS_TO_CLK_DELAY_3
    }]
    set readback [ipcfg::snapshot $cell $keys]
    ipcfg::write_evidence [file join $evidence_dir readback.tcldict] $readback
    set lines [list "parameter\tactual"]
    dict for {key value} $readback {lappend lines "$key\t$value"}
    write_new [file join $evidence_dir readback.tsv] [join $lines \n]
    ipcfg::write_evidence [file join $evidence_dir interfaces.tcldict] [dict create cells [get_bd_cells] interfaces [get_bd_intf_pins -of_objects $ps] external_interfaces [get_bd_intf_ports] scalar_pins [get_bd_pins -of_objects $ps] part [get_property PART [current_project]]]
    return "EXPORT:OK"
}

proc ::s2b_ps_platform::run {project_dir evidence_dir helper native_log} {
    # 从新目录重建的入口；依赖已安装 ROSS library 及本次 Vivado 原生日志路径。
    if {![file isfile $helper] || ![file isfile $native_log]} {error "helper 或原生日志不存在"}
    if {[current_project -quiet] ne ""} {error "已有打开项目，停止创建"}
    foreach path [list $project_dir $evidence_dir] {
        if {[file pathtype $path] ne "absolute" || ![file isdirectory [file dirname $path]] || [file exists $path]} {
            error "新目录精确路径或父目录不满足要求：$path"
        }
    }
    fresh_dir $evidence_dir
    prepare $project_dir
    # helper 内有相对 namespace eval，首次加载必须在 Tcl 全局作用域执行。
    # 不预加载、不改 helper、不清理命名空间或次数账；保存首次加载事实供复核。
    set helper_preexisting [llength [info commands ::ipcfg::help]]
    set helper_namespace_before [namespace exists ::ipcfg]
    if {!$helper_preexisting} {uplevel #0 [list source -notrace $helper]}
    if {![llength [info commands ::ipcfg::help]] ||
        [namespace origin ::ipcfg::help] ne "::ipcfg::help" ||
        [namespace exists ::s2b_ps_platform::ipcfg]} {
        error "helper 全局作用域核验失败"
    }
    set ::ipcfg::native_log_path $native_log
    ipcfg::write_evidence [file join $evidence_dir helper_load.tcldict] [dict create \
        helper_path $helper caller_namespace [namespace current] \
        helper_preexisting $helper_preexisting helper_namespace_before $helper_namespace_before \
        helper_namespace_after [namespace exists ::ipcfg] api_origin [namespace origin ::ipcfg::help] \
        nested_namespace_present [namespace exists ::s2b_ps_platform::ipcfg] \
        initial_source_global [expr {!$helper_preexisting}] loaded_signature $::ipcfg::loaded_signature]
    set python [ipcfg::python_status]
    if {![string match {PYTHON:OK*} $python]} {error $python}
    puts $python
    puts [ipcfg::python_exec -c {import argparse, base64, hashlib, json, pathlib, re, sys, typing; print("PYTHON_IMPORTS:OK")}]
    set configure_receipt [ipcfg::capture [file join $evidence_dir configure.tcldict] [list ::s2b_ps_platform::configure $evidence_dir] {CONFIG:OK}]
    puts $configure_receipt
    if {[dict get $configure_receipt status] ne "OK"} {error "配置 capture 未通过"}
    set validate_receipt [ipcfg::capture [file join $evidence_dir validate.tcldict] [list ::s2b_ps_platform::validate] {VALIDATE:OK}]
    puts $validate_receipt
    if {[dict get $validate_receipt status] ne "OK"} {error "验证 capture 未通过"}
    set products_receipt [ipcfg::capture [file join $evidence_dir products.tcldict] [list ::s2b_ps_platform::products] {PRODUCTS:OK}]
    puts $products_receipt
    # Vivado 2026.1 生成输出时会重排普通警告历史，ROSS 严格计数可误报。
    # 只在本次 Tcl 成功且没有错误/关键警告、原因精确为 WARNING 计数变化时重验一次。
    # 失败原证据保留；第二次仍需严格 OK，绝不放行真实配置或生成失败。
    if {[dict get $products_receipt status] ne "OK" &&
        [dict get $products_receipt code] == 0 &&
        [dict get $products_receipt error_count] == 0 &&
        [dict get $products_receipt critical_count] == 0 &&
        [dict exists $products_receipt capture_error] &&
        [string match {CAPTURE_FAIL:native message export incomplete or counters changed: WARNING emitted=*} [dict get $products_receipt capture_error]]} {
        set products_receipt [ipcfg::capture [file join $evidence_dir products_recheck.tcldict] [list ::s2b_ps_platform::products] {PRODUCTS:OK}]
        puts $products_receipt
    }
    if {[dict get $products_receipt status] ne "OK"} {error "输出生成 capture 未通过"}
    set export_receipt [ipcfg::capture [file join $evidence_dir export.tcldict] [list ::s2b_ps_platform::export $evidence_dir] {EXPORT:OK}]
    puts $export_receipt
    if {[dict get $export_receipt status] ne "OK"} {error "导出 capture 未通过"}
    return "PS_PLATFORM:OFFLINE_CANDIDATE_OK"
}

