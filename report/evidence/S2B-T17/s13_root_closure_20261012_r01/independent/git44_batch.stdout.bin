// S2A-T13：tiny416 layer33 单元素 INT8 nearest-repeat memory datapath。
module s2b_upsample_engine (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,

    input  logic        start_valid,
    output logic        start_ready,
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_length_bytes,
    input  logic [31:0] output_base_address,
    input  logic [31:0] output_length_bytes,
    input  logic [31:0] input_channels,
    input  logic [31:0] input_height,
    input  logic [31:0] input_width,
    input  logic [31:0] stride,
    input  logic [31:0] output_channel,
    input  logic [31:0] output_y,
    input  logic [31:0] output_x,

    output logic        backend_cancel,
    output logic        backend_req_valid,
    input  logic        backend_req_ready,
    output logic        backend_req_write,
    output logic [31:0] backend_req_addr,
    output logic [31:0] backend_req_wdata,
    output logic [3:0]  backend_req_rstrb,
    output logic [3:0]  backend_req_wstrb,
    input  logic        backend_rsp_valid,
    input  logic [31:0] backend_rsp_rdata,
    input  logic [2:0]  backend_rsp_error,

    output logic        result_valid,
    input  logic        result_ready,
    output logic [31:0] result_source_address,
    output logic [31:0] result_output_address,
    output logic [7:0]  result_value,
    output logic [2:0]  result_error_code
);
    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    localparam logic [2:0] BAD_LENGTH = 3'd3;
    localparam logic [2:0] INTERNAL = 3'd6;

    localparam logic [31:0] INPUT_BASE = 32'd27598336;
    localparam logic [31:0] INPUT_LENGTH = 32'd21632;
    localparam logic [31:0] OUTPUT_BASE = 32'd27619968;
    localparam logic [31:0] OUTPUT_LENGTH = 32'd86528;
    localparam logic [31:0] CHANNELS = 32'd128;
    localparam logic [31:0] INPUT_DIMENSION = 32'd13;
    localparam logic [31:0] UPSAMPLE_STRIDE = 32'd2;

    typedef enum logic [2:0] {
        IDLE,
        READ_REQUEST,
        READ_RESPONSE,
        WRITE_REQUEST,
        WRITE_RESPONSE,
        RESULT
    } state_t;

    state_t state;
    logic [31:0] source_address_latched;
    logic [31:0] output_address_latched;
    logic [7:0] copied_value_latched;
    logic [2:0] result_error_latched;

    logic [63:0] query_output_height;
    logic [63:0] query_output_width;
    logic [31:0] query_source_channel;
    logic [31:0] query_source_y;
    logic [31:0] query_source_x;
    logic [31:0] query_source_address;
    logic signed [7:0] query_unused_value;
    logic [2:0] query_error_code;
    logic [1351:0] query_unused_plane;
    logic [63:0] output_offset_work;
    logic [64:0] output_address_work;
    logic [31:0] selected_byte_shift;
    logic [2:0] mapped_response_error;

    assign query_unused_plane = '0;

    int8_upsample_query u_query (
        .input_base_address(input_base_address),
        .input_channels(input_channels),
        .input_height(input_height),
        .input_width(input_width),
        .stride(32'd2),
        .input_channel(output_channel),
        .output_y(output_y),
        .output_x(output_x),
        .source_plane(query_unused_plane),
        .output_height(query_output_height),
        .output_width(query_output_width),
        .source_channel(query_source_channel),
        .source_y(query_source_y),
        .source_x(query_source_x),
        .source_address(query_source_address),
        .output_value(query_unused_value),
        .error_code(query_error_code)
    );

    always_comb begin
        start_ready = (state == IDLE) && !hard_reset && !abort;
        backend_cancel = hard_reset || abort;
        backend_req_valid = 1'b0;
        backend_req_write = 1'b0;
        backend_req_addr = 32'd0;
        backend_req_wdata = 32'd0;
        backend_req_rstrb = 4'd0;
        backend_req_wstrb = 4'd0;
        if (!hard_reset && !abort) begin
            if (state == READ_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_addr = {source_address_latched[31:2], 2'b00};
                backend_req_rstrb = 4'b0001 << source_address_latched[1:0];
            end else if (state == WRITE_REQUEST) begin
                backend_req_valid = 1'b1;
                backend_req_write = 1'b1;
                backend_req_addr = {output_address_latched[31:2], 2'b00};
                backend_req_wdata = {24'd0, copied_value_latched} <<
                                    (output_address_latched[1:0] * 8);
                backend_req_wstrb = 4'b0001 << output_address_latched[1:0];
            end
        end
        result_valid = (state == RESULT);
        result_source_address = source_address_latched;
        result_output_address = output_address_latched;
        result_value = copied_value_latched;
        result_error_code = result_error_latched;

        output_offset_work =
            ((({32'd0, output_channel} * 64'd26) + {32'd0, output_y}) * 64'd26) +
            {32'd0, output_x};
        output_address_work = {33'd0, output_base_address} +
                              {33'd0, output_offset_work};
        selected_byte_shift = {30'd0, source_address_latched[1:0]} * 32'd8;
        mapped_response_error = INTERNAL;
        if ((backend_rsp_error == 3'd1) || (backend_rsp_error == 3'd2) ||
            (backend_rsp_error == 3'd6)) begin
            mapped_response_error = backend_rsp_error;
        end else if (backend_rsp_error == NONE) begin
            mapped_response_error = NONE;
        end
    end

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= IDLE;
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            copied_value_latched <= 8'd0;
            result_error_latched <= NONE;
        end else if (abort && (state != IDLE) && (state != RESULT)) begin
            source_address_latched <= 32'd0;
            output_address_latched <= 32'd0;
            copied_value_latched <= 8'd0;
            result_error_latched <= NONE;
            state <= IDLE;
        end else begin
            case (state)
                IDLE: begin
                    if (start_valid && start_ready) begin
                        copied_value_latched <= 8'd0;
                        result_error_latched <= NONE;
                        source_address_latched <= 32'd0;
                        output_address_latched <= 32'd0;
                        if ((input_channels != CHANNELS) ||
                            (input_height != INPUT_DIMENSION) ||
                            (input_width != INPUT_DIMENSION) ||
                            (stride != UPSAMPLE_STRIDE) ||
                            (output_channel >= CHANNELS) ||
                            (output_y >= 32'd26) || (output_x >= 32'd26)) begin
                            result_error_latched <= BAD_ARGUMENT;
                            state <= RESULT;
                        end else if ((input_length_bytes != INPUT_LENGTH) ||
                                     (output_length_bytes != OUTPUT_LENGTH)) begin
                            result_error_latched <= BAD_LENGTH;
                            state <= RESULT;
                        end else if ((input_base_address != INPUT_BASE) ||
                                     (output_base_address != OUTPUT_BASE)) begin
                            result_error_latched <= BAD_RANGE;
                            state <= RESULT;
                        end else if ((query_error_code != NONE) ||
                                     (query_source_channel != output_channel) ||
                                     (query_source_address < input_base_address) ||
                                     (({1'b0, query_source_address} -
                                       {1'b0, input_base_address}) >=
                                      {1'b0, input_length_bytes}) ||
                                     (output_address_work[64:32] != 33'd0) ||
                                     (output_offset_work >= {32'd0, output_length_bytes})) begin
                            result_error_latched <=
                                (query_error_code == BAD_RANGE) ? BAD_RANGE : BAD_ARGUMENT;
                            state <= RESULT;
                        end else begin
                            source_address_latched <= query_source_address;
                            output_address_latched <= output_address_work[31:0];
                            state <= READ_REQUEST;
                        end
                    end
                end
                READ_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= READ_RESPONSE;
                    end
                end
                READ_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        if (mapped_response_error != NONE) begin
                            copied_value_latched <= 8'd0;
                            result_error_latched <= mapped_response_error;
                            state <= RESULT;
                        end else begin
                            copied_value_latched <=
                                (backend_rsp_rdata >> selected_byte_shift);
                            state <= WRITE_REQUEST;
                        end
                    end
                end
                WRITE_REQUEST: begin
                    if (backend_req_valid && backend_req_ready) begin
                        state <= WRITE_RESPONSE;
                    end
                end
                WRITE_RESPONSE: begin
                    if (backend_rsp_valid) begin
                        result_error_latched <= mapped_response_error;
                        if (mapped_response_error != NONE) begin
                            copied_value_latched <= 8'd0;
                        end
                        state <= RESULT;
                    end
                end
                RESULT: begin
                    if (result_valid && result_ready) begin
                        state <= IDLE;
                        result_error_latched <= NONE;
                    end
                end
                default: begin
                    state <= IDLE;
                    copied_value_latched <= 8'd0;
                    result_error_latched <= INTERNAL;
                end
            endcase
        end
    end
endmodule

4e8b21dae4cb7f11d906382b6a0e9a7956961a89 blob 34325
// S2A-T64：按冻结 descriptor ROM 串行复用四类算子引擎。
module s2b_network_backend (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        abort,
    input  logic        backend_start,
    input  logic        buffer_owner_pl,
    input  logic [31:0] input_base_address,
    input  logic [31:0] input_length_bytes,
    input  logic [31:0] weight_package_base_address,
    input  logic [31:0] weight_package_length_bytes,

    output logic        mem_valid,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic        mem_ready,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code,

    output logic        backend_memory_error_valid,
    output logic [2:0]  backend_memory_error_code,
    output logic        operator_result_valid,
    output logic [2:0]  operator_error_code
);
    import s2a_network_descriptor_pkg::*;

    localparam logic [2:0] NONE = 3'd0;
    localparam logic [2:0] INTERNAL = 3'd6;

    typedef enum logic [2:0] {
        ST_IDLE,
        ST_DISPATCH,
        ST_WAIT_CONV,
        ST_WAIT_MAXPOOL,
        ST_WAIT_ROUTE,
        ST_WAIT_UPSAMPLE
    } state_t;

    state_t state;
    logic [5:0] layer_cursor;
    logic [31:0] output_element_index;
    // 冻结38层均为单批次；坐标只沿原索引赋值分支更新。
    logic [8:0] output_channel_cursor;
    logic [7:0] output_y_cursor;
    logic [7:0] output_x_cursor;
    logic response_pending;
    logic [31:0] response_data_latched;
    logic [2:0] response_error_latched;
    logic [2:0] response_target_latched;

    logic [2:0] current_op;
    logic [1:0] current_input_count;
    logic [31:0] source_base [0:1];
    logic [31:0] source_length [0:1];
    logic [15:0] source_n [0:1];
    logic [15:0] source_c [0:1];
    logic [15:0] source_h [0:1];
    logic [15:0] source_w [0:1];
    logic [15:0] source_route_start [0:1];
    logic [15:0] source_route_end [0:1];
    logic [31:0] output_base;
    logic [31:0] output_length;
    logic [15:0] output_n;
    logic [15:0] output_c;
    logic [15:0] output_h;
    logic [15:0] output_w;
    logic [63:0] output_plane_elements;
    logic [63:0] output_batch_elements;
    logic [63:0] output_element_count;
    logic [31:0] decoded_channel;
    logic [31:0] decoded_y;
    logic [31:0] decoded_x;
    logic [31:0] mq_index;
    logic descriptor_valid;
    logic alias_valid;
    logic descriptor_fault;
    logic is_alias_row;
    logic [5:0] alias_layer_index;
    logic [63:0] alias_output_plane_elements;
    logic [63:0] alias_output_element_count;

    logic conv_start_valid, conv_start_ready;
    logic maxpool_start_valid, maxpool_start_ready;
    logic route_start_valid, route_start_ready;
    logic upsample_start_valid, upsample_start_ready;
    logic maxpool_cancel, route_cancel, upsample_cancel;
    logic conv_req_valid, conv_req_ready, conv_req_write;
    logic [31:0] conv_req_addr, conv_req_wdata;
    logic [3:0] conv_req_rstrb, conv_req_wstrb;
    logic maxpool_req_valid, maxpool_req_ready, maxpool_req_write;
    logic [31:0] maxpool_req_addr, maxpool_req_wdata;
    logic [3:0] maxpool_req_rstrb, maxpool_req_wstrb;
    logic route_req_valid, route_req_ready, route_req_write;
    logic [31:0] route_req_addr, route_req_wdata;
    logic [3:0] route_req_rstrb, route_req_wstrb;
    logic upsample_req_valid, upsample_req_ready, upsample_req_write;
    logic [31:0] upsample_req_addr, upsample_req_wdata;
    logic [3:0] upsample_req_rstrb, upsample_req_wstrb;
    logic conv_rsp_valid, maxpool_rsp_valid, route_rsp_valid, upsample_rsp_valid;
    logic [31:0] conv_rsp_data, maxpool_rsp_data, route_rsp_data, upsample_rsp_data;
    logic [2:0] conv_rsp_error, maxpool_rsp_error, route_rsp_error, upsample_rsp_error;
    logic conv_result_valid, conv_result_ready;
    logic [2:0] conv_result_error;
    logic maxpool_result_valid, maxpool_result_ready;
    logic [127:0] maxpool_tap_addresses;
    logic [31:0] maxpool_result_address;
    logic [7:0] maxpool_result_value;
    logic [2:0] maxpool_result_error;
    logic route_result_valid, route_result_ready;
    logic [31:0] route_result_source_index;
    logic [31:0] route_result_source_address;
    logic [31:0] route_result_address;
    logic [7:0] route_result_value;
    logic [2:0] route_result_error;
    logic upsample_result_valid, upsample_result_ready;
    logic [31:0] upsample_result_source_address;
    logic [31:0] upsample_result_address;
    logic [7:0] upsample_result_value;
    logic [2:0] upsample_result_error;

    logic selected_req_valid;
    logic selected_req_write;
    logic [31:0] selected_req_addr;
    logic [31:0] selected_req_wdata;
    logic [3:0] selected_req_rstrb;
    logic [3:0] selected_req_wstrb;
    logic selected_result_valid;
    logic [2:0] selected_result_error;
    logic memory_handshake;
    logic selected_start_ready;

    function automatic logic [2:0] normalize_engine_error(input logic [2:0] code);
        begin
            case (code)
                3'd0: normalize_engine_error = NONE;
                3'd1, 3'd2, 3'd3, 3'd4, 3'd5, 3'd6, 3'd7:
                    normalize_engine_error = code;
                default: normalize_engine_error = INTERNAL;
            endcase
        end
    endfunction

    // 冻结包 activation 枚举映射到卷积引擎的方向性 M/Q 选择编码。
    function automatic logic [1:0] map_conv_activation(input logic [1:0] descriptor_activation);
        begin
            case (descriptor_activation)
                S2A_ACT_NONE, S2A_ACT_LINEAR: map_conv_activation = 2'd0;
                S2A_ACT_LEAKY: map_conv_activation = 2'd1;
                default: map_conv_activation = 2'd3;
            endcase
        end
    endfunction

    always_comb begin
        current_op = S2A_OP[layer_cursor];
        current_input_count = S2A_INPUT_COUNT[layer_cursor];
        output_base = S2A_OUTPUT_ADDRESS[layer_cursor];
        output_length = S2A_OUTPUT_LENGTH_BYTES[layer_cursor];
        output_n = S2A_OUTPUT_N[layer_cursor];
        output_c = S2A_OUTPUT_C[layer_cursor];
        output_h = S2A_OUTPUT_H[layer_cursor];
        output_w = S2A_OUTPUT_W[layer_cursor];
        output_plane_elements = {48'd0, output_h} * {48'd0, output_w};
        output_batch_elements = {48'd0, output_c} * output_plane_elements;
        output_element_count = {48'd0, output_n} * output_batch_elements;
        decoded_channel = 32'd0;
        decoded_y = 32'd0;
        decoded_x = 32'd0;
        if ((output_plane_elements != 64'd0) &&
            (output_batch_elements != 64'd0) && (output_w != 16'd0)) begin
            decoded_channel = {23'd0, output_channel_cursor};
            decoded_y = {24'd0, output_y_cursor};
            decoded_x = {24'd0, output_x_cursor};
        end

        for (integer source_slot = 0; source_slot < 2; source_slot = source_slot + 1) begin
            source_base[source_slot] = 32'd0;
            source_length[source_slot] = 32'd0;
            source_n[source_slot] = 16'd0;
            source_c[source_slot] = 16'd0;
            source_h[source_slot] = 16'd0;
            source_w[source_slot] = 16'd0;
            source_route_start[source_slot] = 16'd0;
            source_route_end[source_slot] = 16'd0;
            if (source_slot < current_input_count) begin
                if ((layer_cursor == 6'd0) && (source_slot == 0) &&
                    (S2A_INPUT_KIND[layer_cursor][source_slot] == S2A_INPUT_NETWORK)) begin
                    source_base[source_slot] = input_base_address;
                    source_length[source_slot] = input_length_bytes;
                end else begin
                    source_base[source_slot] = S2A_INPUT_ADDRESS[layer_cursor][source_slot];
                    source_length[source_slot] = S2A_INPUT_LENGTH_BYTES[layer_cursor][source_slot];
                end
                source_n[source_slot] = S2A_INPUT_N[layer_cursor][source_slot];
                source_c[source_slot] = S2A_INPUT_C[layer_cursor][source_slot];
                source_h[source_slot] = S2A_INPUT_H[layer_cursor][source_slot];
                source_w[source_slot] = S2A_INPUT_W[layer_cursor][source_slot];
                source_route_start[source_slot] = S2A_ROUTE_CHANNEL_START[layer_cursor][source_slot];
                source_route_end[source_slot] = S2A_ROUTE_CHANNEL_END[layer_cursor][source_slot];
            end
        end

        mq_index = {16'd0, S2A_T23_MQ_BASE[layer_cursor]} + decoded_channel;
        alias_layer_index = S2A_OUTPUT_ALIAS_LAYER_INDEX[layer_cursor];
        is_alias_row = (current_op == S2A_OP_YOLO);
        alias_valid = 1'b0;
        if (is_alias_row &&
            (S2A_OUTPUT_MEMORY_WRITE_REQUIRED[layer_cursor] == 1'b0) &&
            (S2A_OUTPUT_ALLOCATION_KIND[layer_cursor] == S2A_OUTPUT_HEAD_ALIAS) &&
            (alias_layer_index < S2A_LAYER_COUNT)) begin
            alias_output_plane_elements =
                {48'd0, S2A_OUTPUT_H[alias_layer_index]} *
                {48'd0, S2A_OUTPUT_W[alias_layer_index]};
            alias_output_element_count =
                {48'd0, S2A_OUTPUT_N[alias_layer_index]} *
                {48'd0, S2A_OUTPUT_C[alias_layer_index]} *
                alias_output_plane_elements;
            alias_valid =
                (S2A_OUTPUT_TENSOR_INDEX[alias_layer_index] ==
                 S2A_OUTPUT_TENSOR_INDEX[layer_cursor]) &&
                (S2A_OUTPUT_ADDRESS[alias_layer_index] == output_base) &&
                (S2A_OUTPUT_LENGTH_BYTES[alias_layer_index] == output_length) &&
                (S2A_OUTPUT_N[alias_layer_index] == output_n) &&
                (S2A_OUTPUT_C[alias_layer_index] == output_c) &&
                (S2A_OUTPUT_H[alias_layer_index] == output_h) &&
                (S2A_OUTPUT_W[alias_layer_index] == output_w) &&
                (alias_output_element_count == output_element_count);
        end else begin
            alias_output_plane_elements = 64'd0;
            alias_output_element_count = 64'd0;
        end

        descriptor_valid = 1'b1;
        if ((S2A_LAYER_INDEX[layer_cursor] != layer_cursor) ||
            (current_input_count == 2'd0) || (current_input_count > S2A_MAX_INPUTS) ||
            (output_n != 16'd1) || (output_c == 16'd0) ||
            (output_h == 16'd0) || (output_w == 16'd0) ||
            (output_length == 32'd0) || (output_element_count == 64'd0)) begin
            descriptor_valid = 1'b0;
        end
        for (integer validate_slot = 0; validate_slot < 2; validate_slot = validate_slot + 1) begin
            if (validate_slot < current_input_count) begin
                if ((source_n[validate_slot] != 16'd1) ||
                    (source_c[validate_slot] == 16'd0) ||
                    (source_h[validate_slot] == 16'd0) ||
                    (source_w[validate_slot] == 16'd0) ||
                    (source_length[validate_slot] == 32'd0)) begin
                    descriptor_valid = 1'b0;
                end
                if ((S2A_INPUT_KIND[layer_cursor][validate_slot] == S2A_INPUT_NETWORK) &&
                    !((layer_cursor == 6'd0) && (validate_slot == 0))) begin
                    descriptor_valid = 1'b0;
                end
            end
        end
        if (is_alias_row) begin
            if (!alias_valid) descriptor_valid = 1'b0;
        end else if ((S2A_OUTPUT_MEMORY_WRITE_REQUIRED[layer_cursor] != 1'b1) ||
                     (S2A_OUTPUT_ALLOCATION_KIND[layer_cursor] != S2A_OUTPUT_OWNED)) begin
            descriptor_valid = 1'b0;
        end
        if (current_op == S2A_OP_CONV) begin
            if ((current_input_count != 2'd1) ||
                (S2A_T23_MQ_CHANNEL_COUNT[layer_cursor] != output_c) ||
                (mq_index >= S2A_CONV_CHANNEL_COUNT) ||
                (({16'd0, S2A_T23_MQ_BASE[layer_cursor]} +
                  {16'd0, S2A_T23_MQ_CHANNEL_COUNT[layer_cursor]}) >
                 S2A_CONV_CHANNEL_COUNT) ||
                (map_conv_activation(S2A_ACTIVATION[layer_cursor]) == 2'd3) ||
                (S2A_WEIGHT_LAYER_INDEX[layer_cursor] != S2A_LAYER_INDEX[layer_cursor])) begin
                descriptor_valid = 1'b0;
            end
        end else if ((current_op == S2A_OP_MAXPOOL) ||
                     (current_op == S2A_OP_UPSAMPLE)) begin
            if (current_input_count != 2'd1) descriptor_valid = 1'b0;
        end else if (current_op == S2A_OP_ROUTE) begin
            if ((current_input_count != 2'd1) && (current_input_count != 2'd2))
                descriptor_valid = 1'b0;
        end else if (!is_alias_row) begin
            descriptor_valid = 1'b0;
        end

        descriptor_fault = !descriptor_valid;

        conv_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                           descriptor_valid && (current_op == S2A_OP_CONV);
        maxpool_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                              descriptor_valid && (current_op == S2A_OP_MAXPOOL);
        route_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                            descriptor_valid && (current_op == S2A_OP_ROUTE);
        upsample_start_valid = (state == ST_DISPATCH) && buffer_owner_pl &&
                               descriptor_valid && (current_op == S2A_OP_UPSAMPLE);
        selected_start_ready = 1'b0;
        case (current_op)
            S2A_OP_CONV: selected_start_ready = conv_start_ready;
            S2A_OP_MAXPOOL: selected_start_ready = maxpool_start_ready;
            S2A_OP_ROUTE: selected_start_ready = route_start_ready;
            S2A_OP_UPSAMPLE: selected_start_ready = upsample_start_ready;
            default: selected_start_ready = 1'b0;
        endcase

        selected_req_valid = 1'b0;
        selected_req_write = 1'b0;
        selected_req_addr = 32'd0;
        selected_req_wdata = 32'd0;
        selected_req_rstrb = 4'd0;
        selected_req_wstrb = 4'd0;
        case (state)
            ST_WAIT_CONV: begin
                selected_req_valid = conv_req_valid;
                selected_req_write = conv_req_write;
                selected_req_addr = conv_req_addr;
                selected_req_wdata = conv_req_wdata;
                selected_req_rstrb = conv_req_rstrb;
                selected_req_wstrb = conv_req_wstrb;
            end
            ST_WAIT_MAXPOOL: begin
                selected_req_valid = maxpool_req_valid;
                selected_req_write = maxpool_req_write;
                selected_req_addr = maxpool_req_addr;
                selected_req_wdata = maxpool_req_wdata;
                selected_req_rstrb = maxpool_req_rstrb;
                selected_req_wstrb = maxpool_req_wstrb;
            end
            ST_WAIT_ROUTE: begin
                selected_req_valid = route_req_valid;
                selected_req_write = route_req_write;
                selected_req_addr = route_req_addr;
                selected_req_wdata = route_req_wdata;
                selected_req_rstrb = route_req_rstrb;
                selected_req_wstrb = route_req_wstrb;
            end
            ST_WAIT_UPSAMPLE: begin
                selected_req_valid = upsample_req_valid;
                selected_req_write = upsample_req_write;
                selected_req_addr = upsample_req_addr;
                selected_req_wdata = upsample_req_wdata;
                selected_req_rstrb = upsample_req_rstrb;
                selected_req_wstrb = upsample_req_wstrb;
            end
            default: begin end
        endcase

        mem_valid = selected_req_valid && buffer_owner_pl && !hard_reset &&
                    !abort && !response_pending;
        mem_write = mem_valid && selected_req_write;
        mem_addr = selected_req_addr;
        mem_wdata = selected_req_wdata;
        mem_rstrb = mem_valid ? selected_req_rstrb : 4'd0;
        mem_wstrb = mem_valid ? selected_req_wstrb : 4'd0;
        conv_req_ready = (state == ST_WAIT_CONV) && mem_valid && mem_ready;
        maxpool_req_ready = (state == ST_WAIT_MAXPOOL) && mem_valid && mem_ready;
        route_req_ready = (state == ST_WAIT_ROUTE) && mem_valid && mem_ready;
        upsample_req_ready = (state == ST_WAIT_UPSAMPLE) && mem_valid && mem_ready;
        memory_handshake = mem_valid && mem_ready;
        backend_memory_error_valid = memory_handshake && (mem_error_code != NONE);
        backend_memory_error_code = mem_error_code;

        conv_rsp_valid = response_pending && (response_target_latched == S2A_OP_CONV) &&
                         !hard_reset && !abort;
        maxpool_rsp_valid = response_pending && (response_target_latched == S2A_OP_MAXPOOL) &&
                            !hard_reset && !abort;
        route_rsp_valid = response_pending && (response_target_latched == S2A_OP_ROUTE) &&
                          !hard_reset && !abort;
        upsample_rsp_valid = response_pending && (response_target_latched == S2A_OP_UPSAMPLE) &&
                             !hard_reset && !abort;
        conv_rsp_data = response_data_latched;
        maxpool_rsp_data = response_data_latched;
        route_rsp_data = response_data_latched;
        upsample_rsp_data = response_data_latched;
        conv_rsp_error = response_error_latched;
        maxpool_rsp_error = response_error_latched;
        route_rsp_error = response_error_latched;
        upsample_rsp_error = response_error_latched;

        selected_result_valid = 1'b0;
        selected_result_error = INTERNAL;
        conv_result_ready = !hard_reset && (state == ST_WAIT_CONV) && conv_result_valid;
        maxpool_result_ready = !hard_reset && (state == ST_WAIT_MAXPOOL) && maxpool_result_valid;
        route_result_ready = !hard_reset && (state == ST_WAIT_ROUTE) && route_result_valid;
        upsample_result_ready = !hard_reset && (state == ST_WAIT_UPSAMPLE) && upsample_result_valid;
        case (state)
            ST_WAIT_CONV: begin
                selected_result_valid = conv_result_valid && conv_result_ready;
                selected_result_error = conv_result_error;
            end
            ST_WAIT_MAXPOOL: begin
                selected_result_valid = maxpool_result_valid && maxpool_result_ready;
                selected_result_error = maxpool_result_error;
            end
            ST_WAIT_ROUTE: begin
                selected_result_valid = route_result_valid && route_result_ready;
                selected_result_error = route_result_error;
            end
            ST_WAIT_UPSAMPLE: begin
                selected_result_valid = upsample_result_valid && upsample_result_ready;
                selected_result_error = upsample_result_error;
            end
            default: begin end
        endcase
    end

    always_comb begin
        operator_result_valid = 1'b0;
        operator_error_code = NONE;
        if (!hard_reset && !abort && buffer_owner_pl) begin
            case (state)
                ST_DISPATCH: begin
                    if ((layer_cursor >= S2A_LAYER_COUNT) || descriptor_fault ||
                        (!is_alias_row && !selected_start_ready) ||
                        (is_alias_row && !alias_valid)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = INTERNAL;
                    end else if (is_alias_row &&
                                 ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = NONE;
                    end
                end
                ST_WAIT_CONV, ST_WAIT_MAXPOOL, ST_WAIT_ROUTE, ST_WAIT_UPSAMPLE: begin
                    if (selected_result_valid &&
                        (normalize_engine_error(selected_result_error) != NONE)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = normalize_engine_error(selected_result_error);
                    end else if (selected_result_valid &&
                                 ((current_op == S2A_OP_CONV) ||
                                  (({32'd0, output_element_index} + 64'd1) >=
                                   output_element_count)) &&
                                 ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT)) begin
                        operator_result_valid = 1'b1;
                        operator_error_code = NONE;
                    end
                end
                ST_IDLE: begin end
                default: begin
                    operator_result_valid = 1'b1;
                    operator_error_code = INTERNAL;
                end
            endcase
        end
    end

    // 私有稳定descriptor模式只绑定冻结ROM的CONV派发。
    s2b_conv_tile_engine #(.FROZEN_CONV_DESCRIPTOR(1'b1)) u_conv_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .buffer_owner_pl(buffer_owner_pl),
        .start_valid(conv_start_valid), .start_ready(conv_start_ready),
        .layer_index({26'd0, S2A_LAYER_INDEX[layer_cursor]}),
        .weight_layer_index({26'd0, S2A_WEIGHT_LAYER_INDEX[layer_cursor]}),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .input_batch_count({16'd0, source_n[0]}),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .output_batch_count({16'd0, output_n}), .output_channels({16'd0, output_c}),
        .output_height({16'd0, output_h}), .output_width({16'd0, output_w}),
        .kernel_height({24'd0, S2A_KERNEL_H[layer_cursor]}),
        .kernel_width({24'd0, S2A_KERNEL_W[layer_cursor]}),
        .stride_y({24'd0, S2A_STRIDE_H[layer_cursor]}),
        .stride_x({24'd0, S2A_STRIDE_W[layer_cursor]}),
        .pad_left({24'd0, S2A_PADDING_LEFT[layer_cursor]}),
        .pad_right({24'd0, S2A_PADDING_RIGHT[layer_cursor]}),
        .pad_top({24'd0, S2A_PADDING_TOP[layer_cursor]}),
        .pad_bottom({24'd0, S2A_PADDING_BOTTOM[layer_cursor]}),
        .groups({16'd0, S2A_GROUP_COUNT[layer_cursor]}),
        .padding_value_int8($signed({{24{S2A_PADDING_VALUE_INT8[layer_cursor][7]}},
                                     S2A_PADDING_VALUE_INT8[layer_cursor]})),
        .weight_package_base_address(weight_package_base_address),
        .weight_package_length_bytes(weight_package_length_bytes),
        .quantized_weight_offset(S2A_GF8_WEIGHT_OFFSET[layer_cursor]),
        .quantized_weight_bytes(S2A_GF8_WEIGHT_BYTES[layer_cursor]),
        .output_batch(32'd0),
        .activation_mode(map_conv_activation(S2A_ACTIVATION[layer_cursor])),
        .backend_cancel(), .backend_req_valid(conv_req_valid),
        .backend_req_ready(conv_req_ready), .backend_req_write(conv_req_write),
        .backend_req_addr(conv_req_addr), .backend_req_wdata(conv_req_wdata),
        .backend_req_rstrb(conv_req_rstrb), .backend_req_wstrb(conv_req_wstrb),
        .backend_rsp_valid(conv_rsp_valid), .backend_rsp_rdata(conv_rsp_data),
        .backend_rsp_error(conv_rsp_error), .busy(),
        .result_valid(conv_result_valid), .result_ready(conv_result_ready),
        .result_error_code(conv_result_error)
    );

    s2b_maxpool_engine u_maxpool_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(maxpool_start_valid), .start_ready(maxpool_start_ready),
        .layer_index({26'd0, S2A_LAYER_INDEX[layer_cursor]}),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}), .output_base_address(output_base),
        .output_length_bytes(output_length), .output_channels({16'd0, output_c}),
        .output_height({16'd0, output_h}), .output_width({16'd0, output_w}),
        .kernel_height({24'd0, S2A_KERNEL_H[layer_cursor]}),
        .kernel_width({24'd0, S2A_KERNEL_W[layer_cursor]}),
        .stride_y({24'd0, S2A_STRIDE_H[layer_cursor]}),
        .stride_x({24'd0, S2A_STRIDE_W[layer_cursor]}),
        .darknet_padding_parameter({24'd0, S2A_MAXPOOL_DARKNET_PADDING[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .backend_cancel(maxpool_cancel), .backend_req_valid(maxpool_req_valid),
        .backend_req_ready(maxpool_req_ready), .backend_req_write(maxpool_req_write),
        .backend_req_addr(maxpool_req_addr), .backend_req_wdata(maxpool_req_wdata),
        .backend_req_rstrb(maxpool_req_rstrb), .backend_req_wstrb(maxpool_req_wstrb),
        .backend_rsp_valid(maxpool_rsp_valid), .backend_rsp_rdata(maxpool_rsp_data),
        .backend_rsp_error(maxpool_rsp_error), .result_valid(maxpool_result_valid),
        .result_ready(maxpool_result_ready), .result_tap_addresses(maxpool_tap_addresses),
        .result_output_address(maxpool_result_address), .result_value(maxpool_result_value),
        .result_error_code(maxpool_result_error)
    );

    // 冻结ROM所有ROUTE source tuple已完整绑定，CSR不提供shape覆盖。
    s2b_route_engine #(.FROZEN_ROUTE_SHAPES(1'b1)) u_route_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(route_start_valid), .start_ready(route_start_ready),
        .source_count({30'd0, current_input_count}),
        .groups({16'd0, S2A_GROUP_COUNT[layer_cursor]}),
        .group_id({16'd0, S2A_ROUTE_GROUP_ID[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .source0_base_address(source_base[0]), .source0_length_bytes(source_length[0]),
        .source0_channels({16'd0, source_c[0]}), .source0_height({16'd0, source_h[0]}),
        .source0_width({16'd0, source_w[0]}),
        .source0_channel_start({16'd0, source_route_start[0]}),
        .source0_channel_end({16'd0, source_route_end[0]}),
        .source0_multiplier_q31(S2A_ROUTE_SOURCE_MULTIPLIER_Q31[layer_cursor][0]),
        .source1_base_address(source_base[1]), .source1_length_bytes(source_length[1]),
        .source1_channels({16'd0, source_c[1]}), .source1_height({16'd0, source_h[1]}),
        .source1_width({16'd0, source_w[1]}),
        .source1_channel_start({16'd0, source_route_start[1]}),
        .source1_channel_end({16'd0, source_route_end[1]}),
        .source1_multiplier_q31(S2A_ROUTE_SOURCE_MULTIPLIER_Q31[layer_cursor][1]),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .output_channels({16'd0, output_c}), .output_height({16'd0, output_h}),
        .output_width({16'd0, output_w}),
        .backend_cancel(route_cancel), .backend_req_valid(route_req_valid),
        .backend_req_ready(route_req_ready), .backend_req_write(route_req_write),
        .backend_req_addr(route_req_addr), .backend_req_wdata(route_req_wdata),
        .backend_req_rstrb(route_req_rstrb), .backend_req_wstrb(route_req_wstrb),
        .backend_rsp_valid(route_rsp_valid), .backend_rsp_rdata(route_rsp_data),
        .backend_rsp_error(route_rsp_error), .result_valid(route_result_valid),
        .result_ready(route_result_ready), .result_source_index(route_result_source_index),
        .result_source_address(route_result_source_address),
        .result_output_address(route_result_address), .result_value(route_result_value),
        .result_error_code(route_result_error)
    );

    s2b_upsample_engine u_upsample_engine (
        .clk(clk), .hard_reset(hard_reset), .abort(abort),
        .start_valid(upsample_start_valid), .start_ready(upsample_start_ready),
        .input_base_address(source_base[0]), .input_length_bytes(source_length[0]),
        .output_base_address(output_base), .output_length_bytes(output_length),
        .input_channels({16'd0, source_c[0]}), .input_height({16'd0, source_h[0]}),
        .input_width({16'd0, source_w[0]}),
        .stride({16'd0, S2A_UPSAMPLE_STRIDE[layer_cursor]}),
        .output_channel(decoded_channel), .output_y(decoded_y), .output_x(decoded_x),
        .backend_cancel(upsample_cancel), .backend_req_valid(upsample_req_valid),
        .backend_req_ready(upsample_req_ready), .backend_req_write(upsample_req_write),
        .backend_req_addr(upsample_req_addr), .backend_req_wdata(upsample_req_wdata),
        .backend_req_rstrb(upsample_req_rstrb), .backend_req_wstrb(upsample_req_wstrb),
        .backend_rsp_valid(upsample_rsp_valid), .backend_rsp_rdata(upsample_rsp_data),
        .backend_rsp_error(upsample_rsp_error), .result_valid(upsample_result_valid),
        .result_ready(upsample_result_ready),
        .result_source_address(upsample_result_source_address),
        .result_output_address(upsample_result_address), .result_value(upsample_result_value),
        .result_error_code(upsample_result_error)
    );

    always_ff @(posedge clk) begin
        if (hard_reset) begin
            state <= ST_IDLE;
            layer_cursor <= 6'd0;
            output_element_index <= 32'd0;
            output_channel_cursor <= 9'd0;
            output_y_cursor <= 8'd0;
            output_x_cursor <= 8'd0;
            response_pending <= 1'b0;
            response_data_latched <= 32'd0;
            response_error_latched <= NONE;
            response_target_latched <= S2A_OP_CONV;
        end else if (abort) begin
            state <= ST_IDLE;
            layer_cursor <= 6'd0;
            output_element_index <= 32'd0;
            output_channel_cursor <= 9'd0;
            output_y_cursor <= 8'd0;
            output_x_cursor <= 8'd0;
            response_pending <= 1'b0;
            response_data_latched <= 32'd0;
            response_error_latched <= NONE;
            response_target_latched <= S2A_OP_CONV;
        end else begin
            if (response_pending) response_pending <= 1'b0;
            if (memory_handshake) begin
                response_pending <= 1'b1;
                response_data_latched <= mem_rdata;
                response_error_latched <= mem_error_code;
                response_target_latched <= current_op;
            end

            case (state)
                ST_IDLE: begin
                    if (backend_start && buffer_owner_pl) begin
                        layer_cursor <= 6'd0;
                        output_element_index <= 32'd0;
                        output_channel_cursor <= 9'd0;
                        output_y_cursor <= 8'd0;
                        output_x_cursor <= 8'd0;
                        state <= ST_DISPATCH;
                    end
                end
                ST_DISPATCH: begin
                    if (buffer_owner_pl) begin
                        if ((layer_cursor >= S2A_LAYER_COUNT) || descriptor_fault) begin
                            state <= ST_IDLE;
                        end else if (is_alias_row) begin
                            if (!alias_valid) begin
                                state <= ST_IDLE;
                            end else if ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT) begin
                                state <= ST_IDLE;
                            end else begin
                                layer_cursor <= layer_cursor + 6'd1;
                                output_element_index <= 32'd0;
                                output_channel_cursor <= 9'd0;
                                output_y_cursor <= 8'd0;
                                output_x_cursor <= 8'd0;
                            end
                        end else if (!selected_start_ready) begin
                            state <= ST_IDLE;
                        end else begin
                            case (current_op)
                                S2A_OP_CONV: state <= ST_WAIT_CONV;
                                S2A_OP_MAXPOOL: state <= ST_WAIT_MAXPOOL;
                                S2A_OP_ROUTE: state <= ST_WAIT_ROUTE;
                                S2A_OP_UPSAMPLE: state <= ST_WAIT_UPSAMPLE;
                                default: begin
                                    state <= ST_IDLE;
                                end
                            endcase
                        end
                    end
                end
                ST_WAIT_CONV, ST_WAIT_MAXPOOL, ST_WAIT_ROUTE, ST_WAIT_UPSAMPLE: begin
                    if (selected_result_valid) begin
                        if (normalize_engine_error(selected_result_error) != NONE) begin
                            state <= ST_IDLE;
                        end else if ((current_op != S2A_OP_CONV) &&
                                     (({32'd0, output_element_index} + 64'd1) <
                                      output_element_count)) begin
                            output_element_index <= output_element_index + 32'd1;
                            // 原末元素条件排除通道溢出，不增加owner或结果门禁。
                            if ({8'd0, output_x_cursor} == (output_w - 16'd1)) begin
                                output_x_cursor <= 8'd0;
                                if ({8'd0, output_y_cursor} == (output_h - 16'd1)) begin
                                    output_y_cursor <= 8'd0;
                                    output_channel_cursor <= output_channel_cursor + 9'd1;
                                end else begin
                                    output_y_cursor <= output_y_cursor + 8'd1;
                                end
                            end else begin
                                output_x_cursor <= output_x_cursor + 8'd1;
                            end
                            state <= ST_DISPATCH;
                        end else if ((layer_cursor + 6'd1) >= S2A_LAYER_COUNT) begin
                            state <= ST_IDLE;
                        end else begin
                            layer_cursor <= layer_cursor + 6'd1;
                            output_element_index <= 32'd0;
                            output_channel_cursor <= 9'd0;
                            output_y_cursor <= 8'd0;
                            output_x_cursor <= 8'd0;
                            state <= ST_DISPATCH;
                        end
                    end
                end
                default: begin
                    state <= ST_IDLE;
                end
            endcase
        end
    end
endmodule

81129b56b47773c8c2ffdea5068c41c862e4d6ef blob 2414
// S2A-T12：单 outstanding 请求锁存与 G0 memory bus 握手。
module s2a_memory_master (
    input  logic        clk,
    input  logic        hard_reset,
    input  logic        cancel,
    input  logic        buffer_owner_pl,

    input  logic        backend_req_valid,
    output logic        backend_req_ready,
    input  logic        backend_req_write,
    input  logic [31:0] backend_req_addr,
    input  logic [31:0] backend_req_wdata,
    input  logic [3:0]  backend_req_rstrb,
    input  logic [3:0]  backend_req_wstrb,
    output logic        backend_rsp_valid,
    output logic [31:0] backend_rsp_rdata,
    output logic [2:0]  backend_rsp_error,

    output logic        mem_valid,
    input  logic        mem_ready,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code
);
    logic pending;
    logic held_write;
    logic [31:0] held_addr;
    logic [31:0] held_wdata;
    logic [3:0] held_rstrb;
    logic [3:0] held_wstrb;

    always_comb begin
        backend_req_ready = !pending && buffer_owner_pl && !hard_reset && !cancel;
        mem_valid = pending && buffer_owner_pl && !hard_reset && !cancel;
        mem_write = held_write;
        mem_addr = held_addr;
        mem_wdata = held_wdata;
        mem_rstrb = held_rstrb;
        mem_wstrb = held_wstrb;
        backend_rsp_valid = mem_valid && mem_ready;
        backend_rsp_rdata = backend_rsp_valid ? mem_rdata : 32'd0;
        backend_rsp_error = backend_rsp_valid ? mem_error_code : 3'd0;
    end

    always_ff @(posedge clk) begin
        if (hard_reset || cancel || !buffer_owner_pl) begin
            pending <= 1'b0;
            held_write <= 1'b0;
            held_addr <= 32'd0;
            held_wdata <= 32'd0;
            held_rstrb <= 4'd0;
            held_wstrb <= 4'd0;
        end else if (pending && mem_valid && mem_ready) begin
            pending <= 1'b0;
        end else if (!pending && backend_req_valid && backend_req_ready) begin
            pending <= 1'b1;
            held_write <= backend_req_write;
            held_addr <= backend_req_addr;
            held_wdata <= backend_req_wdata;
            held_rstrb <= backend_req_rstrb;
            held_wstrb <= backend_req_wstrb;
        end
    end
endmodule

d4614ba4cc1ea2397b911f83a42605e825c7e4cf blob 3696
// S2A-T12：组合冻结 CSR、单 outstanding master 与 G0 memory bus。
module s2a_runtime_shell (
    input  logic        clk,
    input  logic        hard_reset,

    input  logic        csr_valid,
    output logic        csr_ready,
    input  logic        csr_write,
    input  logic [7:0]  csr_addr,
    input  logic [31:0] csr_wdata,
    output logic [31:0] csr_rdata,

    input  logic        backend_req_valid,
    output logic        backend_req_ready,
    input  logic        backend_req_write,
    input  logic [31:0] backend_req_addr,
    input  logic [31:0] backend_req_wdata,
    input  logic [3:0]  backend_req_rstrb,
    input  logic [3:0]  backend_req_wstrb,
    output logic        backend_rsp_valid,
    output logic [31:0] backend_rsp_rdata,
    output logic [2:0]  backend_rsp_error,

    input  logic        operator_result_valid,
    input  logic [2:0]  operator_error_code,
    output logic        backend_start,
    output logic        backend_abort,
    output logic        busy,
    output logic        done,
    output logic        error,
    output logic        pl_owns_buffers,
    output logic        head_output_valid,

    output logic        mem_valid,
    input  logic        mem_ready,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code
);
    logic backend_memory_error_valid;
    logic [2:0] backend_memory_error_code;
    logic soft_reset_now;
    logic cancel_master;

    always_comb begin
        soft_reset_now = csr_valid && csr_ready && csr_write &&
                         (csr_addr == 8'h00) && csr_wdata[1];
        cancel_master = hard_reset || backend_abort || soft_reset_now;
        backend_memory_error_valid = backend_rsp_valid &&
                                     (backend_rsp_error != 3'd0);
        backend_memory_error_code = backend_rsp_error;
    end

    s2a_control_csr u_control (
        .clk(clk),
        .hard_reset(hard_reset),
        .csr_valid(csr_valid),
        .csr_ready(csr_ready),
        .csr_write(csr_write),
        .csr_addr(csr_addr),
        .csr_wdata(csr_wdata),
        .csr_rdata(csr_rdata),
        .backend_memory_error_valid(backend_memory_error_valid),
        .backend_memory_error_code(backend_memory_error_code),
        .operator_result_valid(operator_result_valid),
        .operator_error_code(operator_error_code),
        .backend_start(backend_start),
        .backend_abort(backend_abort),
        .busy(busy),
        .done(done),
        .error(error),
        .pl_owns_buffers(pl_owns_buffers),
        .head_output_valid(head_output_valid)
    );

    s2a_memory_master u_memory_master (
        .clk(clk),
        .hard_reset(hard_reset),
        .cancel(cancel_master),
        .buffer_owner_pl(pl_owns_buffers),
        .backend_req_valid(backend_req_valid),
        .backend_req_ready(backend_req_ready),
        .backend_req_write(backend_req_write),
        .backend_req_addr(backend_req_addr),
        .backend_req_wdata(backend_req_wdata),
        .backend_req_rstrb(backend_req_rstrb),
        .backend_req_wstrb(backend_req_wstrb),
        .backend_rsp_valid(backend_rsp_valid),
        .backend_rsp_rdata(backend_rsp_rdata),
        .backend_rsp_error(backend_rsp_error),
        .mem_valid(mem_valid),
        .mem_ready(mem_ready),
        .mem_write(mem_write),
        .mem_addr(mem_addr),
        .mem_wdata(mem_wdata),
        .mem_rstrb(mem_rstrb),
        .mem_wstrb(mem_wstrb),
        .mem_rdata(mem_rdata),
        .mem_error_code(mem_error_code)
    );
endmodule

3d24117c4165f3c7f529b9ff29c78a3f06a81d21 blob 5427
// S2A OOC 顶层：将冻结 CSR/memory master 与 tiny416 网络后端组合。
module s2b_stage2b_core #(
    // 默认值逐项绑定 S2A-T01 冻结清单 address_map.input.address/length_bytes。
    // 权威文件：report/evidence/S2A-T01/tiny416_model_manifest.json。
    // 该清单 SHA-256：9dd2477bc6f12b556ded8bed71e5acd9efb22f6e314564973a3bbbda8279453a。
    parameter logic [31:0] INPUT_BASE_ADDRESS = 32'h00000000,
    parameter logic [31:0] INPUT_LENGTH_BYTES = 32'd519168,
    // 默认值逐项绑定同一冻结清单 address_map.weight_package.address/length_bytes。
    parameter logic [31:0] WEIGHT_PACKAGE_BASE_ADDRESS = 32'h00100000,
    parameter logic [31:0] WEIGHT_PACKAGE_LENGTH_BYTES = 32'd5903100
) (
    input  logic        clk,
    input  logic        hard_reset,

    input  logic        csr_valid,
    output logic        csr_ready,
    input  logic        csr_write,
    input  logic [7:0]  csr_addr,
    input  logic [31:0] csr_wdata,
    output logic [31:0] csr_rdata,

    output logic        mem_valid,
    input  logic        mem_ready,
    output logic        mem_write,
    output logic [31:0] mem_addr,
    output logic [31:0] mem_wdata,
    output logic [3:0]  mem_rstrb,
    output logic [3:0]  mem_wstrb,
    input  logic [31:0] mem_rdata,
    input  logic [2:0]  mem_error_code
);
    logic backend_req_valid;
    logic backend_req_ready;
    logic backend_req_write;
    logic [31:0] backend_req_addr;
    logic [31:0] backend_req_wdata;
    logic [3:0] backend_req_rstrb;
    logic [3:0] backend_req_wstrb;
    logic backend_rsp_valid;
    logic [31:0] backend_rsp_rdata;
    logic [2:0] backend_rsp_error;

    logic backend_mem_valid;
    logic backend_mem_write;
    logic [31:0] backend_mem_addr;
    logic [31:0] backend_mem_wdata;
    logic [3:0] backend_mem_rstrb;
    logic [3:0] backend_mem_wstrb;

    logic backend_start;
    logic backend_abort;
    logic buffer_owner_pl;
    logic busy;
    logic done;
    logic error;
    logic head_output_valid;
    logic operator_result_valid;
    logic [2:0] operator_error_code;
    // shell 已按同一响应错误码上报 memory error；后端诊断口仅保留内部观察，不外露为顶层引脚。
    logic backend_memory_error_valid;
    logic [2:0] backend_memory_error_code;

    // 直接请求保持有效至外部 memory 返回，runtime shell 锁存单笔请求并产生完成响应。
    // 因此后端的 ready/data/error 接收端使用 shell 的响应通道，而非请求入队 ready。
    s2a_runtime_shell u_runtime_shell (
        .clk(clk),
        .hard_reset(hard_reset),
        .csr_valid(csr_valid),
        .csr_ready(csr_ready),
        .csr_write(csr_write),
        .csr_addr(csr_addr),
        .csr_wdata(csr_wdata),
        .csr_rdata(csr_rdata),
        .backend_req_valid(backend_req_valid),
        .backend_req_ready(backend_req_ready),
        .backend_req_write(backend_req_write),
        .backend_req_addr(backend_req_addr),
        .backend_req_wdata(backend_req_wdata),
        .backend_req_rstrb(backend_req_rstrb),
        .backend_req_wstrb(backend_req_wstrb),
        .backend_rsp_valid(backend_rsp_valid),
        .backend_rsp_rdata(backend_rsp_rdata),
        .backend_rsp_error(backend_rsp_error),
        .operator_result_valid(operator_result_valid),
        .operator_error_code(operator_error_code),
        .backend_start(backend_start),
        .backend_abort(backend_abort),
        .busy(busy),
        .done(done),
        .error(error),
        .pl_owns_buffers(buffer_owner_pl),
        .head_output_valid(head_output_valid),
        .mem_valid(mem_valid),
        .mem_ready(mem_ready),
        .mem_write(mem_write),
        .mem_addr(mem_addr),
        .mem_wdata(mem_wdata),
        .mem_rstrb(mem_rstrb),
        .mem_wstrb(mem_wstrb),
        .mem_rdata(mem_rdata),
        .mem_error_code(mem_error_code)
    );

    // 后端请求经 shell 的单 outstanding master 发往顶层 memory 总线。
    // shell 的 backend_req_ready 仅负责入队；后端事务在 backend_rsp_valid 时完成。
    assign backend_req_valid = backend_mem_valid;
    assign backend_req_write = backend_mem_write;
    assign backend_req_addr = backend_mem_addr;
    assign backend_req_wdata = backend_mem_wdata;
    assign backend_req_rstrb = backend_mem_rstrb;
    assign backend_req_wstrb = backend_mem_wstrb;

    s2b_network_backend u_network_backend (
        .clk(clk),
        .hard_reset(hard_reset),
        .abort(backend_abort),
        .backend_start(backend_start),
        .buffer_owner_pl(buffer_owner_pl),
        .input_base_address(INPUT_BASE_ADDRESS),
        .input_length_bytes(INPUT_LENGTH_BYTES),
        .weight_package_base_address(WEIGHT_PACKAGE_BASE_ADDRESS),
        .weight_package_length_bytes(WEIGHT_PACKAGE_LENGTH_BYTES),
        .mem_valid(backend_mem_valid),
        .mem_write(backend_mem_write),
        .mem_addr(backend_mem_addr),
        .mem_wdata(backend_mem_wdata),
        .mem_rstrb(backend_mem_rstrb),
        .mem_wstrb(backend_mem_wstrb),
        .mem_ready(backend_rsp_valid),
        .mem_rdata(backend_rsp_rdata),
        .mem_error_code(backend_rsp_error),
        .backend_memory_error_valid(backend_memory_error_valid),
        .backend_memory_error_code(backend_memory_error_code),
        .operator_result_valid(operator_result_valid),
        .operator_error_code(operator_error_code)
    );
endmodule

5fd608b0ffc473287fa2a9208d1cb8bdc9c84f22 blob 11284
// S2A-T11：独立 CSR/控制状态机，不包含 memory master 或算子实现。
module s2a_control_csr (
    input  logic        clk,
    input  logic        hard_reset,

    input  logic        csr_valid,
    output logic        csr_ready,
    input  logic        csr_write,
    input  logic [7:0]  csr_addr,
    input  logic [31:0] csr_wdata,
    output logic [31:0] csr_rdata,

    // 该事件表示后端在已接受的 memory handshake 上返回非零错误码。
    input  logic        backend_memory_error_valid,
    input  logic [2:0]  backend_memory_error_code,
    input  logic        operator_result_valid,
    input  logic [2:0]  operator_error_code,

    output logic        backend_start,
    output logic        backend_abort,
    output logic        busy,
    output logic        done,
    output logic        error,
    output logic        pl_owns_buffers,
    output logic        head_output_valid
);
    localparam logic [7:0] REG_CMD           = 8'h00;
    localparam logic [7:0] REG_STATUS        = 8'h04;
    localparam logic [7:0] REG_ERROR_CODE    = 8'h08;
    localparam logic [7:0] REG_FRAME_ID      = 8'h0C;
    localparam logic [7:0] REG_INPUT_ADDR    = 8'h10;
    localparam logic [7:0] REG_INPUT_BYTES   = 8'h14;
    localparam logic [7:0] REG_WEIGHT_ADDR   = 8'h18;
    localparam logic [7:0] REG_WEIGHT_BYTES  = 8'h1C;
    localparam logic [7:0] REG_FEATURE_BASE  = 8'h20;
    localparam logic [7:0] REG_FEATURE_LIMIT = 8'h24;
    localparam logic [7:0] REG_TIMEOUT       = 8'h28;
    localparam logic [7:0] REG_HEAD13_ADDR   = 8'h2C;
    localparam logic [7:0] REG_HEAD13_BYTES  = 8'h30;
    localparam logic [7:0] REG_HEAD26_ADDR   = 8'h34;
    localparam logic [7:0] REG_HEAD26_BYTES  = 8'h38;
    localparam logic [7:0] REG_ACK           = 8'h3C;

    localparam logic [31:0] DEFAULT_INPUT_ADDR   = 32'h0000_0000;
    localparam logic [31:0] DEFAULT_INPUT_BYTES  = 32'd519168;
    localparam logic [31:0] DEFAULT_WEIGHT_ADDR  = 32'h0010_0000;
    localparam logic [31:0] DEFAULT_WEIGHT_BYTES = 32'd5903100;
    localparam logic [31:0] DEFAULT_FEATURE_BASE = 32'h0100_0000;
    localparam logic [31:0] DEFAULT_FEATURE_LIMIT = 32'd28159416;
    localparam logic [31:0] DEFAULT_HEAD13_ADDR  = 32'd27549952;
    localparam logic [31:0] DEFAULT_HEAD13_BYTES = 32'd5070;
    localparam logic [31:0] DEFAULT_HEAD26_ADDR  = 32'd28139136;
    localparam logic [31:0] DEFAULT_HEAD26_BYTES = 32'd20280;

    localparam logic [2:0] NONE                  = 3'd0;
    localparam logic [2:0] BAD_ARGUMENT          = 3'd1;
    localparam logic [2:0] BAD_RANGE             = 3'd2;
    localparam logic [2:0] BAD_LENGTH            = 3'd3;
    localparam logic [2:0] TIMEOUT_ERROR         = 3'd5;
    localparam logic [2:0] INTERNAL              = 3'd6;

    logic [2:0] error_code;
    logic [31:0] frame_id;
    logic [31:0] active_frame_id;
    logic [31:0] input_addr;
    logic [31:0] input_bytes;
    logic [31:0] weight_addr;
    logic [31:0] weight_bytes;
    logic [31:0] timeout_cycles;
    logic [31:0] elapsed_cycles;
    logic config_idle;
    logic [2:0] mapped_memory_error;

    always_comb begin
        csr_ready = !hard_reset;
        csr_rdata = 32'd0;
        if (csr_valid && !csr_write) begin
            if (csr_addr[1:0] == 2'b00) begin
                case (csr_addr)
                    REG_STATUS: begin
                        csr_rdata = {28'd0, pl_owns_buffers, error, done, busy};
                    end
                    REG_ERROR_CODE: csr_rdata = {29'd0, error_code};
                    REG_FRAME_ID: csr_rdata = frame_id;
                    REG_INPUT_ADDR: csr_rdata = input_addr;
                    REG_INPUT_BYTES: csr_rdata = input_bytes;
                    REG_WEIGHT_ADDR: csr_rdata = weight_addr;
                    REG_WEIGHT_BYTES: csr_rdata = weight_bytes;
                    REG_FEATURE_BASE: csr_rdata = DEFAULT_FEATURE_BASE;
                    REG_FEATURE_LIMIT: csr_rdata = DEFAULT_FEATURE_LIMIT;
                    REG_TIMEOUT: csr_rdata = timeout_cycles;
                    REG_HEAD13_ADDR: csr_rdata = DEFAULT_HEAD13_ADDR;
                    REG_HEAD13_BYTES: csr_rdata = DEFAULT_HEAD13_BYTES;
                    REG_HEAD26_ADDR: csr_rdata = DEFAULT_HEAD26_ADDR;
                    REG_HEAD26_BYTES: csr_rdata = DEFAULT_HEAD26_BYTES;
                    default: csr_rdata = 32'd0;
                endcase
            end
        end
    end

    always_comb begin
        config_idle = !pl_owns_buffers && !busy && !done && !error;
        mapped_memory_error = INTERNAL;
        if ((backend_memory_error_code == 3'd1) ||
            (backend_memory_error_code == 3'd2) ||
            (backend_memory_error_code == 3'd6)) begin
            mapped_memory_error = backend_memory_error_code;
        end
    end

    always_ff @(posedge clk) begin
        backend_start <= 1'b0;
        backend_abort <= 1'b0;

        if (hard_reset) begin
            busy <= 1'b0;
            done <= 1'b0;
            error <= 1'b0;
            error_code <= NONE;
            pl_owns_buffers <= 1'b0;
            head_output_valid <= 1'b0;
            frame_id <= 32'd0;
            active_frame_id <= 32'd0;
            input_addr <= DEFAULT_INPUT_ADDR;
            input_bytes <= DEFAULT_INPUT_BYTES;
            weight_addr <= DEFAULT_WEIGHT_ADDR;
            weight_bytes <= DEFAULT_WEIGHT_BYTES;
            timeout_cycles <= 32'd0;
            elapsed_cycles <= 32'd0;
            backend_abort <= 1'b1;
        end else if (csr_valid && csr_ready && csr_write &&
                     (csr_addr == REG_CMD) && csr_wdata[1]) begin
            // soft_reset 同周期优先于 start，并恢复整个寄存器默认集。
            busy <= 1'b0;
            done <= 1'b0;
            error <= 1'b0;
            error_code <= NONE;
            pl_owns_buffers <= 1'b0;
            head_output_valid <= 1'b0;
            frame_id <= 32'd0;
            active_frame_id <= 32'd0;
            input_addr <= DEFAULT_INPUT_ADDR;
            input_bytes <= DEFAULT_INPUT_BYTES;
            weight_addr <= DEFAULT_WEIGHT_ADDR;
            weight_bytes <= DEFAULT_WEIGHT_BYTES;
            timeout_cycles <= 32'd0;
            elapsed_cycles <= 32'd0;
            backend_abort <= 1'b1;
        end else begin
            if (csr_valid && csr_ready && csr_write) begin
                case (csr_addr)
                    REG_CMD: begin
                        if (csr_wdata[0] && config_idle) begin
                            if ((input_addr != DEFAULT_INPUT_ADDR) ||
                                (weight_addr != DEFAULT_WEIGHT_ADDR)) begin
                                busy <= 1'b0;
                                done <= 1'b0;
                                error <= 1'b1;
                                error_code <= BAD_RANGE;
                                pl_owns_buffers <= 1'b0;
                                head_output_valid <= 1'b0;
                            end else if ((input_bytes != DEFAULT_INPUT_BYTES) ||
                                         (weight_bytes != DEFAULT_WEIGHT_BYTES)) begin
                                busy <= 1'b0;
                                done <= 1'b0;
                                error <= 1'b1;
                                error_code <= BAD_LENGTH;
                                pl_owns_buffers <= 1'b0;
                                head_output_valid <= 1'b0;
                            end else if (timeout_cycles == 32'd0) begin
                                busy <= 1'b0;
                                done <= 1'b0;
                                error <= 1'b1;
                                error_code <= BAD_ARGUMENT;
                                pl_owns_buffers <= 1'b0;
                                head_output_valid <= 1'b0;
                            end else begin
                                busy <= 1'b1;
                                done <= 1'b0;
                                error <= 1'b0;
                                error_code <= NONE;
                                pl_owns_buffers <= 1'b1;
                                head_output_valid <= 1'b0;
                                active_frame_id <= frame_id;
                                elapsed_cycles <= 32'd0;
                                backend_start <= 1'b1;
                            end
                        end
                    end
                    REG_ACK: begin
                        if (csr_wdata[0] && done) begin
                            done <= 1'b0;
                        end
                        if (csr_wdata[1] && error) begin
                            error <= 1'b0;
                            error_code <= NONE;
                        end
                    end
                    default: begin
                        if (config_idle) begin
                            case (csr_addr)
                                REG_FRAME_ID: frame_id <= csr_wdata;
                                REG_INPUT_ADDR: input_addr <= csr_wdata;
                                REG_INPUT_BYTES: input_bytes <= csr_wdata;
                                REG_WEIGHT_ADDR: weight_addr <= csr_wdata;
                                REG_WEIGHT_BYTES: weight_bytes <= csr_wdata;
                                REG_TIMEOUT: timeout_cycles <= csr_wdata;
                                default: begin end
                            endcase
                        end
                    end
                endcase
            end

            if (busy) begin
                if (backend_memory_error_valid &&
                    (backend_memory_error_code != NONE)) begin
                    busy <= 1'b0;
                    done <= 1'b0;
                    error <= 1'b1;
                    error_code <= mapped_memory_error;
                    pl_owns_buffers <= 1'b0;
                    head_output_valid <= 1'b0;
                    backend_abort <= 1'b1;
                end else if (operator_result_valid) begin
                    if (operator_error_code == NONE) begin
                        busy <= 1'b0;
                        done <= 1'b1;
                        error <= 1'b0;
                        error_code <= NONE;
                        pl_owns_buffers <= 1'b0;
                        head_output_valid <= 1'b1;
                        frame_id <= active_frame_id;
                    end else begin
                        busy <= 1'b0;
                        done <= 1'b0;
                        error <= 1'b1;
                        error_code <= operator_error_code;
                        pl_owns_buffers <= 1'b0;
                        head_output_valid <= 1'b0;
                        backend_abort <= 1'b1;
                    end
                end else if ((elapsed_cycles + 32'd1) >= timeout_cycles) begin
                    busy <= 1'b0;
                    done <= 1'b0;
                    error <= 1'b1;
                    error_code <= TIMEOUT_ERROR;
                    pl_owns_buffers <= 1'b0;
                    head_output_valid <= 1'b0;
                    backend_abort <= 1'b1;
                end else begin
                    elapsed_cycles <= elapsed_cycles + 32'd1;
                end
            end
        end
    end
endmodule

5ccb259e926acfea8ff0c8edfc807695a1db9ae1 blob 3530
// 候选物理请求准入：冻结逻辑对象级白名单，不包含 AXI 声明或所有权状态。
module s2b_request_guard (
    input  logic        mem_write,
    input  logic [31:0] mem_addr,
    input  logic [3:0]  mem_rstrb,
    input  logic [3:0]  mem_wstrb,
    output logic        request_allowed,
    output logic [31:0] physical_addr,
    output logic [2:0]  error_code
);
    localparam logic [2:0] BAD_ARGUMENT = 3'd1;
    localparam logic [2:0] BAD_RANGE = 3'd2;
    // 来自 S2A-T01 冻结 manifest；对象 0/1 只读，36 个独立 feature 可读写。
    localparam logic [31:0] OBJECT_BEGIN [0:37] = '{
        32'h00000000, 32'h00100000,
        32'h01000000, 32'h01152000, 32'h011FB000, 32'h012A4000,
        32'h012F8800, 32'h0134D000, 32'h013A1800, 32'h0144A800,
        32'h014F3800, 32'h01645800, 32'h0169A000, 32'h016EE800,
        32'h01718C00, 32'h01743000, 32'h0176D400, 32'h017C1C00,
        32'h01816400, 32'h018BF400, 32'h018E9800, 32'h01913C00,
        32'h01928E00, 32'h0193E000, 32'h01953200, 32'h0197D600,
        32'h019A7A00, 32'h019FC200, 32'h01A11400, 32'h01A26600,
        32'h01A30F00, 32'h01A46100, 32'h01A47500, 32'h01A51E00,
        32'h01A57280, 32'h01A6C480, 32'h01AABA80, 32'h01AD5E80
    };
    localparam logic [31:0] OBJECT_END [0:37] = '{
        32'h0007EC00, 32'h006A12FC,
        32'h01152000, 32'h011FB000, 32'h012A4000, 32'h012F8800,
        32'h0134D000, 32'h013A1800, 32'h0144A800, 32'h014F3800,
        32'h01645800, 32'h0169A000, 32'h016EE800, 32'h01718C00,
        32'h01743000, 32'h0176D400, 32'h017C1C00, 32'h01816400,
        32'h018BF400, 32'h018E9800, 32'h01913C00, 32'h01928E00,
        32'h0193E000, 32'h01953200, 32'h0197D600, 32'h019A7A00,
        32'h019FC200, 32'h01A11400, 32'h01A26600, 32'h01A30F00,
        32'h01A46100, 32'h01A474CE, 32'h01A51E00, 32'h01A57280,
        32'h01A6C480, 32'h01AABA80, 32'h01AD5E80, 32'h01ADADB8
    };
    logic [3:0] selected;
    logic [32:0] translated;
    logic [32:0] lane_addr;
    logic object_matches;
    logic range_allowed;

    always_comb begin
        selected = mem_write ? mem_wstrb : mem_rstrb;
        translated = {1'b0, mem_addr} + 33'h010000000;
        lane_addr = 33'd0;
        object_matches = 1'b0;
        range_allowed = 1'b0;
        request_allowed = 1'b0;
        physical_addr = 32'd0;
        error_code = BAD_RANGE;
        // 每个选中字节都要落入同一对象；未选 lane 不要求对象覆盖。
        for (int object_index = 0; object_index < 38; object_index++) begin
            object_matches = !mem_write || (object_index >= 2);
            for (int lane = 0; lane < 4; lane++) begin
                lane_addr = {1'b0, mem_addr} + {31'd0, lane[1:0]};
                if (selected[lane] &&
                    ((lane_addr < {1'b0, OBJECT_BEGIN[object_index]}) ||
                     (lane_addr >= {1'b0, OBJECT_END[object_index]})))
                    object_matches = 1'b0;
            end
            range_allowed = range_allowed || object_matches;
        end
        if ((mem_addr[1:0] != 2'b00) || (selected == 4'b0000) ||
            (mem_write ? (mem_rstrb != 4'b0000) : (mem_wstrb != 4'b0000))) begin
            error_code = BAD_ARGUMENT;
        end else if (range_allowed && !translated[32] &&
                     (translated >= 33'h010000000) &&
                     (translated < 33'h012000000)) begin
            request_allowed = 1'b1;
            physical_addr = translated[31:0];
            error_code = 3'd0;
        end
    end
endmodule

0e76dc5cbcd41a11c9ca5cf3bf909c13163c8dc7 blob 15073
`timescale 1ns/1ps
// 候选 HP0 AXI3 单 word 桥；只有统一冷初始化可以丢弃物理账本。
module s2b_hp0_word_adapter (
    input logic clk, cold_reset, run_enable, cancel, clear_safe,
    input logic [63:0] run_epoch,
    input logic mem_valid, mem_write,
    input logic [31:0] mem_addr, mem_wdata,
    input logic [3:0] mem_rstrb, mem_wstrb,
    output logic mem_ready,
    output logic [31:0] mem_rdata,
    output logic [2:0] mem_error_code,
    output logic [5:0] m_axi_arid, m_axi_awid, m_axi_wid,
    output logic [31:0] m_axi_araddr, m_axi_awaddr,
    output logic [3:0] m_axi_arlen, m_axi_awlen,
    output logic [2:0] m_axi_arsize, m_axi_awsize,
    output logic [1:0] m_axi_arburst, m_axi_awburst, m_axi_arlock, m_axi_awlock,
    output logic [3:0] m_axi_arcache, m_axi_awcache, m_axi_arqos, m_axi_awqos,
    output logic [2:0] m_axi_arprot, m_axi_awprot,
    output logic m_axi_arvalid, m_axi_awvalid, m_axi_wvalid, m_axi_wlast,
    input logic m_axi_arready, m_axi_awready, m_axi_wready,
    output logic [63:0] m_axi_wdata,
    output logic [7:0] m_axi_wstrb,
    input logic [5:0] m_axi_rid, m_axi_bid,
    input logic [63:0] m_axi_rdata,
    input logic [1:0] m_axi_rresp, m_axi_bresp,
    input logic m_axi_rlast, m_axi_rvalid, m_axi_bvalid,
    output logic m_axi_rready, m_axi_bready,
    output logic ledger_empty,
    output logic [63:0] ledger_epoch,
    output logic recovery_required, protocol_isolated,
    output logic first_fault_valid,
    output logic [7:0] first_fault_code,
    output logic [31:0] first_fault_address,
    output logic fault_event_valid,
    output logic [7:0] fault_event_code,
    output logic [31:0] fault_event_address,
    output logic req_withdrawn, clear_rejected,
    output logic [9:0] axi_progress,
    output logic [9:0] axi_progress_next,
    output logic ledger_empty_next,
    output logic [1:0] fault_event_resp,
    output logic fault_event_write, fault_event_protocol, fault_event_address_valid,
    output logic [31:0] fault_event_physical_address
);
    typedef struct packed {
        logic held, response_pending, bad_response;
        logic write_req;
        logic [31:0] addr, physical_addr, data;
        logic [3:0] rmask, wmask, remaining;
        logic [63:0] epoch;
        logic [31:0] assembled;
        logic [2:0] logical_error;
        logic read_active, arvalid, ar_accepted;
        logic [31:0] araddr;
        logic [2:0] arsize;
        logic [1:0] lane;
        logic write_active, awvalid, wvalid, aw_accepted, w_accepted, b_seen;
        logic [1:0] saved_bresp;
        logic recover, isolated, first_valid;
        logic [7:0] first_code;
        logic [31:0] first_address;
    } ledger_t;
    ledger_t q, d;
    logic guard_allowed;
    logic [31:0] guard_address;
    logic [2:0] guard_error;
    logic payload_equal, live_request, capture_request;
    logic r_match, b_match, r_protocol, b_protocol, logical_protocol;
    logic stop_request, event_is_protocol;
    logic [1:0] next_lane;
    logic [3:0] remaining_after;
    logic [31:0] shifted_read;

    s2b_request_guard guard (
        .mem_write(mem_write), .mem_addr(mem_addr), .mem_rstrb(mem_rstrb),
        .mem_wstrb(mem_wstrb), .request_allowed(guard_allowed),
        .physical_addr(guard_address), .error_code(guard_error)
    );

    assign payload_equal = {mem_write, mem_addr, mem_wdata, mem_rstrb, mem_wstrb} ==
                           {q.write_req, q.addr, q.data, q.rmask, q.wmask};
    assign live_request = q.held && mem_valid && payload_equal &&
                          (run_epoch == q.epoch) && run_enable && !cancel;
    assign ledger_empty = !(q.held || q.response_pending || q.read_active || q.arvalid ||
                            q.ar_accepted || q.write_active || q.awvalid || q.wvalid ||
                            q.aw_accepted || q.w_accepted || q.b_seen);
    assign ledger_epoch = q.epoch;
    assign recovery_required = q.recover;
    assign protocol_isolated = q.isolated;
    assign first_fault_valid = q.first_valid;
    assign first_fault_code = q.first_code;
    assign first_fault_address = q.first_address;
    assign req_withdrawn = q.held && !mem_valid;
    assign axi_progress = {q.b_seen, q.response_pending, (q.write_active && !q.b_seen),
        q.w_accepted, (q.write_active && (q.wvalid || q.w_accepted)), q.aw_accepted,
        (q.write_active && (q.awvalid || q.aw_accepted)), q.read_active && q.ar_accepted,
        q.ar_accepted, (q.read_active && (q.arvalid || q.ar_accepted))};
    assign capture_request = ledger_empty && run_enable && mem_valid && !cancel &&
                             !q.recover && !q.isolated;
    // 仅作AR沿诊断快照，控制取消与SAFE门禁仍使用注册账本，避免组合反馈。
    assign ledger_empty_next = !(d.held || d.response_pending || d.read_active || d.arvalid ||
        d.ar_accepted || d.write_active || d.awvalid || d.wvalid || d.aw_accepted || d.w_accepted || d.b_seen);
    assign axi_progress_next = {d.b_seen, d.response_pending, (d.write_active && !d.b_seen),
        d.w_accepted, (d.write_active && (d.wvalid || d.w_accepted)), d.aw_accepted,
        (d.write_active && (d.awvalid || d.aw_accepted)), d.read_active && d.ar_accepted,
        d.ar_accepted, (d.read_active && (d.arvalid || d.ar_accepted))};

    // 匹配依赖此前沿的接受状态；非法响应被消费但不能证明原等待结束。
    assign r_match = q.read_active && q.ar_accepted && (m_axi_rid == 6'd0) && m_axi_rlast;
    assign b_match = q.write_active && q.w_accepted && !q.b_seen && (m_axi_bid == 6'd0);
    assign r_protocol = m_axi_rvalid && (!r_match || (m_axi_rresp == 2'b01));
    assign b_protocol = m_axi_bvalid && (!b_match || (m_axi_bresp == 2'b01));
    assign logical_protocol = q.held && ((mem_valid && !payload_equal) || (run_epoch != q.epoch));
    assign stop_request = cancel || (q.held && (!run_enable || !mem_valid)) ||
                          logical_protocol || fault_event_valid || q.recover || q.isolated;

    // 当前沿事件供外层首错聚合；协议故障优先于普通响应错误，读错优先写错。
    always_comb begin
        fault_event_valid = 1'b0;
        fault_event_code = 8'd0;
        fault_event_address = 32'd0;
        event_is_protocol = 1'b0;
        fault_event_resp = 0;
        fault_event_write = 0;
        fault_event_protocol = 0;
        fault_event_address_valid = 0;
        fault_event_physical_address = 0;
        if (r_protocol || b_protocol) begin
            fault_event_valid = 1'b1;
            fault_event_code = 8'd11;
            fault_event_address = ledger_empty ? 32'd0 : q.addr;
            event_is_protocol = 1'b1;
        end else if (logical_protocol) begin
            fault_event_valid = 1'b1;
            fault_event_code = 8'd6;
            fault_event_address = q.addr;
            event_is_protocol = 1'b1;
        end else if (m_axi_rvalid && r_match && m_axi_rresp[1]) begin
            fault_event_valid = 1'b1;
            fault_event_code = m_axi_rresp[0] ? 8'd10 : 8'd9;
            fault_event_address = q.addr;
        end else if (m_axi_bvalid && b_match && m_axi_bresp[1]) begin
            fault_event_valid = 1'b1;
            fault_event_code = m_axi_bresp[0] ? 8'd10 : 8'd9;
            fault_event_address = q.addr;
        end
        // 元数据来自与事件码同一个优先分支；无请求关联时不编造地址。
        fault_event_protocol = event_is_protocol;
        if (fault_event_valid) begin
            if (r_protocol || (!b_protocol && !logical_protocol && m_axi_rvalid && r_match && m_axi_rresp[1])) begin
                fault_event_resp = m_axi_rresp;
                fault_event_write = 0;
                // 非读任务的unexpected R不能借用写账本或未赋值的AR地址。
                fault_event_address_valid = q.read_active ||
                    (!q.write_req && q.response_pending && !q.bad_response);
                if (fault_event_address_valid) fault_event_physical_address = q.araddr;
            end else if (b_protocol || (!logical_protocol && m_axi_bvalid && b_match && m_axi_bresp[1])) begin
                fault_event_resp = m_axi_bresp;
                fault_event_write = 1;
                fault_event_address_valid = q.write_active ||
                    (q.write_req && q.response_pending && !q.bad_response);
                if (fault_event_address_valid) fault_event_physical_address = q.physical_addr;
            end else begin
                fault_event_write = q.write_req;
                fault_event_address_valid = q.held && (q.logical_error == 0);
                if (fault_event_address_valid) fault_event_physical_address = q.physical_addr;
            end
        end
    end

    // 错误准入响应只返回 2A 的 1/2；AXI 的 9/10/11 从不截断交给 core。
    assign mem_ready = q.response_pending && live_request && !q.isolated &&
                       !fault_event_valid && !q.recover;
    assign mem_rdata = q.assembled;
    assign mem_error_code = q.logical_error;
    assign m_axi_arid = 6'd0;
    assign m_axi_awid = 6'd0;
    assign m_axi_wid = 6'd0;
    assign m_axi_araddr = q.araddr;
    assign m_axi_awaddr = q.physical_addr;
    assign m_axi_arlen = 4'd0;
    assign m_axi_awlen = 4'd0;
    assign m_axi_arsize = q.arsize;
    assign m_axi_awsize = 3'd2;
    assign m_axi_arburst = 2'b01;
    assign m_axi_awburst = 2'b01;
    assign m_axi_arlock = 2'b00;
    assign m_axi_awlock = 2'b00;
    assign m_axi_arcache = 4'd0;
    assign m_axi_awcache = 4'd0;
    assign m_axi_arprot = 3'd0;
    assign m_axi_awprot = 3'd0;
    assign m_axi_arqos = 4'd0;
    assign m_axi_awqos = 4'd0;
    assign m_axi_arvalid = q.arvalid;
    assign m_axi_awvalid = q.awvalid;
    assign m_axi_wvalid = q.wvalid;
    assign m_axi_wlast = 1'b1;
    assign m_axi_wdata = q.addr[2] ? {q.data, 32'd0} : {32'd0, q.data};
    assign m_axi_wstrb = q.addr[2] ? {q.wmask, 4'd0} : {4'd0, q.wmask};
    assign m_axi_rready = 1'b1;
    assign m_axi_bready = 1'b1;

    always_comb begin
        d = q;
        clear_rejected = clear_safe &&
            (run_enable || !ledger_empty || q.isolated || cancel || fault_event_valid);
        // 完整mask非零；低三lane都未选中时，只可能选择lane3。
        next_lane = 2'd3;
        if (q.remaining[0]) next_lane = 2'd0;
        else if (q.remaining[1]) next_lane = 2'd1;
        else if (q.remaining[2]) next_lane = 2'd2;
        remaining_after = q.remaining & ~(4'b0001 << q.lane);
        shifted_read = 32'(m_axi_rdata >> (8 * q.araddr[2:0]));

        // 已声明握手始终入账，取消不能屏蔽同沿接受，也不能撤销 VALID。
        if (q.arvalid && m_axi_arready) begin
            d.arvalid = 1'b0;
            d.ar_accepted = 1'b1;
        end
        if (q.awvalid && m_axi_awready) begin
            d.awvalid = 1'b0;
            d.aw_accepted = 1'b1;
        end
        if (q.wvalid && m_axi_wready) begin
            d.wvalid = 1'b0;
            d.w_accepted = 1'b1;
        end
        if (m_axi_rvalid && r_match) begin
            d.read_active = 1'b0;
            d.ar_accepted = 1'b0;
            if (!stop_request) begin
                if (q.arsize == 3'd2) begin
                    d.assembled = shifted_read[31:0];
                    d.remaining = 4'd0;
                    d.response_pending = 1'b1;
                end else begin
                    d.assembled[8*q.lane +: 8] = shifted_read[7:0];
                    d.remaining = remaining_after;
                    if (remaining_after == 4'd0) d.response_pending = 1'b1;
                end
            end
        end
        if (m_axi_bvalid && b_match) begin
            d.b_seen = 1'b1;
            d.saved_bresp = m_axi_bresp;
        end
        // AXI3 允许先 B 后 AW；只在 AW/W/B 三项全部完成时闭合。
        if (q.write_active && d.aw_accepted && d.w_accepted && d.b_seen) begin
            d.write_active = 1'b0;
            d.aw_accepted = 1'b0;
            d.w_accepted = 1'b0;
            d.b_seen = 1'b0;
            if (!stop_request && (d.saved_bresp == 2'b00)) d.response_pending = 1'b1;
        end

        if (mem_ready) begin
            d.held = 1'b0;
            d.response_pending = 1'b0;
            d.bad_response = 1'b0;
            // 准入错误先由 core 实际接受，再关闭此 epoch 的后续准入。
            if (q.bad_response) begin
                d.recover = 1'b1;
                if (!q.first_valid) begin
                    d.first_valid = 1'b1;
                    d.first_code = {5'd0, q.logical_error};
                    d.first_address = q.addr;
                end
            end
        end
        if (stop_request && (cancel || q.held || fault_event_valid)) begin
            d.held = 1'b0;
            d.response_pending = 1'b0;
            d.bad_response = 1'b0;
            d.remaining = 4'd0;
            d.recover = 1'b1;
        end
        if (fault_event_valid) begin
            d.recover = 1'b1;
            if (event_is_protocol) d.isolated = 1'b1;
            if (!q.first_valid) begin
                d.first_valid = 1'b1;
                d.first_code = fault_event_code;
                d.first_address = fault_event_address;
            end
        end
        if (clear_safe && !clear_rejected) begin
            d.recover = 1'b0;
            d.first_valid = 1'b0;
            d.first_code = 8'd0;
            d.first_address = 32'd0;
        end
        if (capture_request && !r_protocol && !b_protocol) begin
            d.held = 1'b1;
            d.write_req = mem_write;
            d.addr = mem_addr;
            // 只捕获guard完成33-bit溢出、窗口和对象核验后的物理地址。
            d.physical_addr = guard_address;
            d.data = mem_wdata;
            d.rmask = mem_rstrb;
            d.wmask = mem_wstrb;
            d.epoch = run_epoch;
            d.assembled = 32'd0;
            d.logical_error = guard_error;
            d.remaining = mem_rstrb;
            if (!guard_allowed) begin
                d.response_pending = 1'b1;
                d.bad_response = 1'b1;
            end
        end
        // 首次声明仅使用已锁存且再次核对的请求，不在捕获沿发 VALID。
        if (q.held && !q.response_pending && !q.read_active && !q.write_active &&
            live_request && !stop_request) begin
            if (q.write_req) begin
                d.write_active = 1'b1;
                d.awvalid = 1'b1;
                d.wvalid = 1'b1;
            end else begin
                d.read_active = 1'b1;
                d.arvalid = 1'b1;
                // guard已证明4B对齐；byte lane替换低两位，无重复平移或截位加法。
                d.araddr = {q.physical_addr[31:2],
                    ((q.rmask == 4'b1111) ? 2'd0 : next_lane)};
                d.arsize = (q.rmask == 4'b1111) ? 3'd2 : 3'd0;
                d.lane = next_lane;
            end
        end
    end

    always_ff @(posedge clk) begin
        if (cold_reset) q <= '0;
        else q <= d;
    end
endmodule

fa8ec21480b32284be5bb413deb38d6a8e383e15 blob 21320
`timescale 1ns/1ps
// 物理接口候选0.1.1：仅由公共CSR读握手观察计算状态，冷初始化才清epoch。
module s2b_control_csr (
    input logic clk, cold_reset,
    input logic [31:0] s_axi_awaddr,
    input logic s_axi_awvalid,
    output logic s_axi_awready,
    input logic [31:0] s_axi_wdata,
    input logic [3:0] s_axi_wstrb,
    input logic s_axi_wvalid,
    output logic s_axi_wready,
    output logic [1:0] s_axi_bresp,
    output logic s_axi_bvalid,
    input logic s_axi_bready,
    input logic [31:0] s_axi_araddr,
    input logic s_axi_arvalid,
    output logic s_axi_arready,
    output logic [31:0] s_axi_rdata,
    output logic [1:0] s_axi_rresp,
    output logic s_axi_rvalid,
    input logic s_axi_rready,
    output logic core_csr_valid, core_csr_write,
    output logic [7:0] core_csr_addr,
    output logic [31:0] core_csr_wdata,
    input logic core_csr_ready,
    input logic [31:0] core_csr_rdata,
    input logic core_mem_valid,
    input logic ledger_empty,
    input logic [63:0] ledger_epoch,
    input logic [9:0] axi_progress_next,
    input logic ledger_empty_next,
    input logic req_withdrawn, protocol_isolated,
    input logic fault_event_valid,
    input logic [7:0] fault_event_code,
    input logic [31:0] fault_event_address, fault_event_physical_address,
    input logic [1:0] fault_event_resp,
    input logic fault_event_write, fault_event_protocol, fault_event_address_valid,
    // 完整集成必须显式证明可见性；未绑定或低电平绝不发布物理安全终态。
    input logic visibility_confirmed,
    output logic run_enable, cancel, clear_safe,
    output logic [63:0] run_epoch
);
    localparam logic [2:0] IDLE_PS=0, ARMING=1, RUN=2, RECOVERING=3,
        DONE_SAFE=4, ERROR_SAFE=5, FAULT_ISOLATED=6;
    localparam logic [1:0] OKAY=0, SLVERR=2, DECERR=3;
    typedef struct packed {
        logic [2:0] state;
        logic [1:0] phase;
        logic [63:0] epoch, ack_epoch;
        logic [31:0] frame, active_frame, input_addr, input_bytes,
            weight_addr, weight_bytes, core_timeout, drain_timeout;
        logic [31:0] error_code, last_reject, fault_logical, fault_physical;
        logic [4:0] fault_detail;
        logic first_selected, first_pending, isolated, owner, head;
        logic [3:0] status_shadow;
        logic arming_idle;
        logic [2:0] config_step;
        logic [5:0] arming_cycles;
        logic diagnostic_status, diagnostic_error, reset_sent, stop_confirmed;
        logic [1:0] reset_age;
        logic [31:0] drain_cycles;
        logic withdrawn_seen;
        logic [2:0] withdrawn_cycles;
        logic aw_held, w_held, bvalid, ack_pending;
        logic [31:0] awaddr, wdata;
        logic [3:0] wstrb;
        logic [1:0] bresp;
        logic rvalid, debug_pending;
        logic [7:0] debug_addr;
        logic [31:0] rdata;
        logic [1:0] rresp;
    } state_t;
    state_t q, d;
    logic write_commit, address_write_ok, abort_commit;
    logic status_sample, error_sample, observed_error;
    logic control_pending, debug_address, read_address_ok;
    logic ack_commit, start_transfer, reset_transfer;
    logic epoch_ledger_ok;
    logic [31:0] read_value, status_value;
    logic [31:0] selected_code;
    logic select_fault, select_core, start_accepted;
    logic q_safe, aw_in_window, ar_in_window, recovery_safe;
    logic [31:0] q_rejection;
    // 小型组合译码直接定义，避免工具把函数返回名误识别为模块信号赋值。
    assign q_safe = (q.state == DONE_SAFE) || (q.state == ERROR_SAFE);
    assign q_rejection = q_safe ? 32'd2 :
        ((q.state == IDLE_PS) || (q.state == FAULT_ISOLATED)) ? 32'd3 : 32'd1;
    assign aw_in_window = (q.awaddr >= 32'h43c00000) && (q.awaddr < 32'h43c10000) && (q.awaddr[1:0] == 0);
    assign ar_in_window = (s_axi_araddr >= 32'h43c00000) && (s_axi_araddr < 32'h43c10000) && (s_axi_araddr[1:0] == 0);

    assign s_axi_awready = !cold_reset && !q.aw_held && !q.bvalid && !q.ack_pending;
    assign s_axi_wready = !cold_reset && !q.w_held && !q.bvalid && !q.ack_pending;
    assign s_axi_bvalid = q.bvalid;
    assign s_axi_bresp = q.bresp;
    assign s_axi_rvalid = q.rvalid;
    assign s_axi_rdata = q.rdata;
    assign s_axi_rresp = q.rresp;
    assign debug_address = ar_in_window &&
        (s_axi_araddr[15:0] >= 16'h100) && (s_axi_araddr[15:0] <= 16'h13c);
    assign read_address_ok = ar_in_window &&
        (((s_axi_araddr[15:0] <= 16'h074) && (s_axi_araddr[15:0] != 16'h008)) ||
         ((s_axi_araddr[15:0] >= 16'h100) && (s_axi_araddr[15:0] <= 16'h13c)));
    assign control_pending = (q.state == ARMING) ||
        ((q.state == RECOVERING || q.state == FAULT_ISOLATED) && !q.reset_sent) ||
        q.ack_pending;
    assign s_axi_arready = !cold_reset && !q.rvalid && !q.debug_pending &&
        (!debug_address || !control_pending);
    assign write_commit = q.aw_held && q.w_held && !q.bvalid && !q.ack_pending;
    assign address_write_ok = aw_in_window && ((q.awaddr[15:0] == 16'h008) ||
        ((q.awaddr[15:0] >= 16'h014) && (q.awaddr[15:0] <= 16'h02c)) ||
        (q.awaddr[15:0] == 16'h05c) || (q.awaddr[15:0] == 16'h060));
    assign abort_commit = write_commit && address_write_ok && (q.wstrb == 4'hf) &&
        (q.awaddr[15:0] == 16'h008) && (q.wdata == 2) &&
        ((q.state == ARMING) || (q.state == RUN));
    assign status_sample = core_csr_valid && core_csr_ready && !core_csr_write &&
        ((q.phase == 0) || (q.phase == 3));
    assign error_sample = core_csr_valid && core_csr_ready && !core_csr_write && (q.phase == 1);
    assign observed_error = status_sample && core_csr_rdata[2] &&
        ((q.state == ARMING) || (q.state == RUN));
    // 此组合门禁不依赖恢复状态的next-state，避免与adapter的账本闭合形成环。
    assign cancel = (q.state == RECOVERING) || (q.state == FAULT_ISOLATED) ||
        q.first_pending || ((q.state == RUN) && q.withdrawn_seen) || abort_commit || observed_error ||
        fault_event_valid || protocol_isolated;
    assign run_enable = (q.state == RUN) && !cancel;
    assign run_epoch = q.epoch;
    assign epoch_ledger_ok = ledger_empty || (ledger_epoch == q.epoch);

    // 四相位每周期前进。已接受debug预留phase2，后来的控制不能抢占。
    always_comb begin
        core_csr_valid = !cold_reset;
        core_csr_write = 0;
        core_csr_addr = 8'h04;
        core_csr_wdata = 0;
        case (q.phase)
            0, 3: core_csr_addr = 8'h04;
            1: core_csr_addr = 8'h08;
            2: begin
                core_csr_valid = !cold_reset && q.debug_pending;
                core_csr_addr = q.debug_addr;
                if (!q.debug_pending) begin
                    if (q.ack_pending && q_safe) begin
                        core_csr_valid = !cold_reset;
                        core_csr_write = 1;
                        core_csr_addr = 8'h3c;
                        core_csr_wdata = (q.state == DONE_SAFE) ? 1 : 2;
                    end else if ((q.state == RECOVERING || q.state == FAULT_ISOLATED) &&
                        q.diagnostic_status && q.diagnostic_error && !q.reset_sent) begin
                        core_csr_valid = !cold_reset;
                        core_csr_write = 1;
                        core_csr_addr = 0;
                        core_csr_wdata = 2;
                    end else if ((q.state == ARMING) && q.arming_idle &&
                        !abort_commit) begin
                        core_csr_valid = !cold_reset;
                        core_csr_write = 1;
                        case (q.config_step)
                            0: begin core_csr_addr=8'h0c; core_csr_wdata=q.active_frame; end
                            1: begin core_csr_addr=8'h10; core_csr_wdata=q.input_addr; end
                            2: begin core_csr_addr=8'h14; core_csr_wdata=q.input_bytes; end
                            3: begin core_csr_addr=8'h18; core_csr_wdata=q.weight_addr; end
                            4: begin core_csr_addr=8'h1c; core_csr_wdata=q.weight_bytes; end
                            5: begin core_csr_addr=8'h28; core_csr_wdata=q.core_timeout; end
                            6: begin core_csr_addr=0; core_csr_wdata=1; end
                            default: core_csr_valid=0;
                        endcase
                    end
                end
            end
            default: core_csr_valid = 0;
        endcase
    end
    assign start_transfer = core_csr_valid && core_csr_ready && core_csr_write &&
        (core_csr_addr == 0) && (core_csr_wdata == 1);
    assign reset_transfer = core_csr_valid && core_csr_ready && core_csr_write &&
        (core_csr_addr == 0) && (core_csr_wdata == 2);
    assign ack_commit = q.ack_pending && core_csr_valid && core_csr_ready &&
        core_csr_write && (core_csr_addr == 8'h3c) && !fault_event_valid && !protocol_isolated;
    // 已清内核终态的ACK在外层写提交沿执行；否则必须等待真实内核ACK握手。
    assign clear_safe = !cold_reset && (ack_commit ||
        (write_commit && address_write_ok && q.wstrb == 4'hf && q.awaddr[15:0] == 16'h008 &&
         q.wdata == 4 && q_safe && q.ack_epoch == q.epoch &&
         (q.status_shadow[2:1] == 0) && ledger_empty && !q.isolated && !protocol_isolated &&
         !fault_event_valid && visibility_confirmed));

    always_comb begin
        d = q;
        d.phase = q.phase + 2'd1;
        select_fault = 0;
        select_core = 0;
        selected_code = 0;
        start_accepted = 0;
        recovery_safe = 0;
        read_value = 0;
        status_value = 0;
        if (q.bvalid && s_axi_bready) d.bvalid = 0;
        if (q.rvalid && s_axi_rready) d.rvalid = 0;
        if (s_axi_awvalid && s_axi_awready) begin d.aw_held=1; d.awaddr=s_axi_awaddr; end
        if (s_axi_wvalid && s_axi_wready) begin d.w_held=1; d.wdata=s_axi_wdata; d.wstrb=s_axi_wstrb; end
        if (status_sample) begin
            d.status_shadow = core_csr_rdata[3:0];
            if (q.state == ARMING && core_csr_rdata[3:0] == 0) d.arming_idle = 1;
            if (q.state == RECOVERING || q.state == FAULT_ISOLATED) d.diagnostic_status = 1;
        end
        if (error_sample) begin
            if ((q.state == RECOVERING || q.state == FAULT_ISOLATED) && q.diagnostic_status)
                d.diagnostic_error = 1;
            if (q.first_pending && q.diagnostic_status) begin
                d.error_code = (core_csr_rdata >= 1 && core_csr_rdata <= 7) ? core_csr_rdata : 6;
                d.first_pending = 0;
            end
        end
        if (q.debug_pending && q.phase == 2 && core_csr_valid && core_csr_ready) begin
            d.debug_pending=0; d.rvalid=1; d.rresp=OKAY; d.rdata=core_csr_rdata;
        end
        if (q.state == ARMING) begin
            if (q.arming_cycles < 40) d.arming_cycles=q.arming_cycles+6'd1;
            if (q.phase == 2 && core_csr_valid && core_csr_ready && core_csr_write) begin
                if (start_transfer) d.state=RUN;
                else d.config_step=q.config_step+3'd1;
            end
        end
        if (q.reset_sent && q.reset_age < 3) d.reset_age=q.reset_age+2'd1;
        if (reset_transfer) begin d.reset_sent=1; d.reset_age=0; end
        if (q.reset_sent && d.reset_age >= 2 && status_sample &&
            core_csr_rdata[3:0] == 0 && !core_mem_valid) d.stop_confirmed=1;
        if (q.state == RUN && req_withdrawn) d.withdrawn_seen=1;
        if (q.withdrawn_seen && q.withdrawn_cycles < 7) d.withdrawn_cycles=q.withdrawn_cycles+3'd1;

        // 写副作用只发生一次；锁存的AW/W在生成B或ACK提交前不重复执行。
        if (write_commit) begin
            d.aw_held=0; d.w_held=0; d.bvalid=1; d.bresp=OKAY;
            if (!address_write_ok) d.bresp=DECERR;
            else if (q.wstrb != 4'hf) d.bresp=SLVERR;
            else if (q.awaddr[15:0] == 16'h008) begin
                if (q.wdata != 0 && q.wdata != 1 && q.wdata != 2 && q.wdata != 4) begin
                    d.bresp=SLVERR; d.last_reject=5;
                end else if (q.wdata == 1) begin
                    if (q.state != IDLE_PS || fault_event_valid || protocol_isolated || q.isolated) begin
                        d.bresp=SLVERR; d.last_reject=q_rejection;
                    end else if (&q.epoch) begin
                        d.bresp=SLVERR; d.last_reject=6;
                    end else begin
                        start_accepted=1;
                        d.epoch=q.epoch+64'd1; d.active_frame=q.frame; d.last_reject=0;
                        d.error_code=0; d.first_selected=0; d.first_pending=0;
                        d.fault_logical=0; d.fault_physical=0; d.fault_detail=0;
                        d.head=0; d.arming_idle=0; d.config_step=0; d.arming_cycles=0;
                        d.diagnostic_status=0; d.diagnostic_error=0; d.reset_sent=0;
                        d.reset_age=0; d.stop_confirmed=0; d.drain_cycles=0;
                        d.withdrawn_seen=0; d.withdrawn_cycles=0;
                        if (q.input_addr != 0 || q.weight_addr != 32'h00100000) d.error_code=2;
                        else if (q.input_bytes != 519168 || q.weight_bytes != 5903100) d.error_code=3;
                        else if (q.core_timeout == 0 || q.drain_timeout == 0) d.error_code=1;
                        if (d.error_code != 0) begin
                            d.state=ERROR_SAFE; d.owner=0; d.first_selected=1; d.stop_confirmed=1;
                        end else begin d.state=ARMING; d.owner=1; end
                    end
                end else if (q.wdata == 2) begin
                    if (!abort_commit) begin d.bresp=SLVERR; d.last_reject=q_rejection; end
                    else d.last_reject=0;
                end else if (q.wdata == 4) begin
                    if (!q_safe || !ledger_empty || q.isolated || protocol_isolated ||
                        fault_event_valid || !visibility_confirmed) begin
                        d.bresp=SLVERR; d.last_reject=3;
                    end else if (q.ack_epoch != q.epoch) begin d.bresp=SLVERR; d.last_reject=4; end
                    else begin
                        d.last_reject=0;
                        if (q.status_shadow[2:1] != 0) begin d.ack_pending=1; d.bvalid=0; end
                    end
                end
            end else if (q.awaddr[15:0] == 16'h05c || q.awaddr[15:0] == 16'h060) begin
                if (!q_safe || q.isolated) begin d.bresp=SLVERR; d.last_reject=3; end
                else if (q.awaddr[15:0] == 16'h05c) d.ack_epoch[31:0]=q.wdata;
                else d.ack_epoch[63:32]=q.wdata;
            end else if (q.state != IDLE_PS || q.isolated) begin
                d.bresp=SLVERR; d.last_reject=q_rejection;
            end else begin
                case (q.awaddr[15:0])
                    16'h014: d.frame=q.wdata;
                    16'h018: d.input_addr=q.wdata;
                    16'h01c: d.input_bytes=q.wdata;
                    16'h020: d.weight_addr=q.wdata;
                    16'h024: d.weight_bytes=q.wdata;
                    16'h028: d.core_timeout=q.wdata;
                    16'h02c: d.drain_timeout=q.wdata;
                    default: begin end
                endcase
            end
        end
        if (clear_safe) begin
            d.state=IDLE_PS; d.head=0; d.first_selected=0; d.first_pending=0;
            d.error_code=0; d.fault_logical=0; d.fault_physical=0; d.fault_detail=0;
            d.withdrawn_seen=0; d.withdrawn_cycles=0; d.ack_pending=0;
            if (ack_commit) begin d.bvalid=1; d.bresp=OKAY; end
        end

        // 首错在同沿先协议、响应、ABORT、真实内核error；后续事件只能补隔离标志。
        if (fault_event_valid || protocol_isolated || !epoch_ledger_ok) begin
            select_fault=1;
            selected_code=fault_event_valid ? {24'd0,fault_event_code} : 11;
        end else if (abort_commit) begin select_fault=1; selected_code=8; end
        else if (observed_error) begin select_fault=1; select_core=1; end
        else if ((q.state == ARMING && q.arming_cycles >= 39 && !start_transfer) ||
                 (q.state == RUN && q.withdrawn_seen && q.withdrawn_cycles >= 5)) begin
            select_fault=1; selected_code=6;
        end
        if (select_fault && (!q.first_selected || start_accepted)) begin
            d.first_selected=1; d.first_pending=select_core; d.error_code=selected_code;
            d.fault_logical=0; d.fault_physical=0;
            if (fault_event_valid) begin
                if (fault_event_address_valid) begin
                    d.fault_logical=fault_event_address; d.fault_physical=fault_event_physical_address;
                end
                d.fault_detail[2:0]={fault_event_write,fault_event_resp};
            end
        end
        if (fault_event_valid && fault_event_protocol || protocol_isolated || !epoch_ledger_ok) begin
            d.isolated=1; d.fault_detail[4]=1;
        end
        if (select_fault && (q.state != RECOVERING && q.state != FAULT_ISOLATED)) begin
            d.state=RECOVERING; d.owner=1; d.head=0; d.drain_cycles=0;
            d.diagnostic_status=status_sample; d.diagnostic_error=0;
            d.reset_sent=0; d.reset_age=0; d.stop_confirmed=0;
        end
        if (select_fault && q.ack_pending) begin
            // ACK未提交期间出现故障，必须释放控制槽，让诊断和复位继续前进。
            d.ack_pending=0; d.bvalid=1; d.bresp=SLVERR; d.last_reject=3;
        end
        if (q.state == RECOVERING || q.state == FAULT_ISOLATED) begin
            recovery_safe = d.stop_confirmed && ledger_empty && !core_mem_valid && visibility_confirmed &&
                !d.first_pending && d.first_selected && !d.isolated && !protocol_isolated && !fault_event_valid;
            if (q.drain_cycles != 32'hffffffff) d.drain_cycles=q.drain_cycles+32'd1;
            // 期限观察整个恢复条件；账本空不能代替STOP、错误码关联及可见性。
            // 截止沿已经具备全部安全条件时优先归还，不标记该沿为超限。
            if (!recovery_safe && q.drain_timeout != 0 && d.drain_cycles >= q.drain_timeout) begin
                d.state=FAULT_ISOLATED; d.fault_detail[3]=1;
                if (!d.first_selected) begin d.first_selected=1; d.error_code=12; end
            end
            if (recovery_safe) begin
                d.state=ERROR_SAFE; d.owner=0; d.head=0;
            end
        end
        if (d.isolated) begin d.state=FAULT_ISOLATED; d.owner=1; d.head=0; end
        if (q.state == RUN && !select_fault && !d.first_pending && !d.withdrawn_seen &&
            status_sample && core_csr_rdata[3:0] == 4'b0010 && !core_mem_valid &&
            ledger_empty && visibility_confirmed && !d.isolated) begin
            d.state=DONE_SAFE; d.owner=0; d.head=1;
        end

        // 普通读取最后使用聚合后的快照；既有R背压时只保留此前样本。
        status_value[2:0]=d.state;
        status_value[8]=d.owner; status_value[9]=d.head;
        status_value[10]=(d.state == IDLE_PS || d.state == DONE_SAFE || d.state == ERROR_SAFE) && !d.isolated;
        status_value[11]=(d.state == DONE_SAFE || d.state == ERROR_SAFE);
        status_value[12]=!ledger_empty_next; status_value[13]=d.first_pending;
        case (s_axi_araddr[15:0])
            16'h000: read_value=32'h53324250;
            16'h004: read_value=32'h00000100;
            16'h00c: read_value=status_value;
            16'h010: read_value=d.error_code;
            16'h014: read_value=d.frame;
            16'h018: read_value=d.input_addr;
            16'h01c: read_value=d.input_bytes;
            16'h020: read_value=d.weight_addr;
            16'h024: read_value=d.weight_bytes;
            16'h028: read_value=d.core_timeout;
            16'h02c: read_value=d.drain_timeout;
            16'h030: read_value=32'h10000000;
            16'h034: read_value=32'h02000000;
            16'h038: read_value=32'h01000000;
            16'h03c: read_value=32'h01adadb8;
            16'h040: read_value=32'h01a46100;
            16'h044: read_value=5070;
            16'h048: read_value=32'h01ad5e80;
            16'h04c: read_value=20280;
            16'h050: read_value=d.epoch[31:0];
            16'h054: read_value=d.epoch[63:32];
            16'h058: read_value=d.active_frame;
            16'h05c: read_value=d.ack_epoch[31:0];
            16'h060: read_value=d.ack_epoch[63:32];
            16'h064: read_value=d.last_reject;
            16'h068: read_value={22'd0,axi_progress_next};
            16'h06c: read_value=d.fault_logical;
            16'h070: read_value=d.fault_physical;
            16'h074: read_value={27'd0,d.fault_detail};
            default: read_value=0;
        endcase
        if (s_axi_arvalid && s_axi_arready) begin
            if (debug_address) begin d.debug_pending=1; d.debug_addr=s_axi_araddr[7:0]; end
            else begin
                d.rvalid=1; d.rdata=read_address_ok ? read_value : 0;
                d.rresp=read_address_ok ? OKAY : DECERR;
            end
        end
    end

    always_ff @(posedge clk) begin
        if (cold_reset) begin
            q <= '0;
            q.input_bytes <= 519168;
            q.weight_addr <= 32'h00100000;
            q.weight_bytes <= 5903100;
        end else q <= d;
    end
endmodule

5123ce8c191630606df9ad3822c48fab8395b489 blob 13808
`timescale 1ns/1ps
// 2B 全核心集成层：仅连接冻结公共 CSR/memory 接口，不读取核心内部状态。
module s2b_inference_top #(
    // 只有独立审阅且与实际网表、源码和缓存证据绑定的构建可改为 1。
    parameter bit PROFILE_VISIBILITY_PROVEN = 1'b0
) (
    (* X_INTERFACE_INFO = "xilinx.com:signal:clock:1.0 clk CLK",
       X_INTERFACE_PARAMETER = "XIL_INTERFACENAME clk, ASSOCIATED_BUSIF S_AXI:M_AXI, ASSOCIATED_RESET cold_resetn, FREQ_HZ 50000000" *)
    input logic clk,
    (* X_INTERFACE_INFO = "xilinx.com:signal:reset:1.0 cold_resetn RST",
       X_INTERFACE_PARAMETER = "XIL_INTERFACENAME cold_resetn, POLARITY ACTIVE_LOW" *)
