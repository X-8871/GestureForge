        assert validation.oracle(fixture,mq,mb,ops)==0,"公开多tile夹具必须先满足独立既有参数门禁"
    text=validation.boundary_tb(names,small)
    addition="""
 raw_invalid=0;result_ready=1;service;result_ready=0;
 for(integer job=0;job<2;job++)begin
