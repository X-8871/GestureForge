+                raise RuntimeError("对象cwd超出本轮范围")
+            if expected is not None and (len(chain) >= len(expected) or not same_identity(current, expected[len(chain)])):
+                raise RuntimeError("本次已保存祖先链身份变化")
+            chain.append(current)
